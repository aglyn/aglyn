# ─────────────────────────────────────────────────────────────────────────────
# Aglyn self-host environment (AGL-905) — cp to .env.selfhost and fill in.
# Full runbook: docs/SELF_HOSTING.md
#
# This one file is used TWICE by docker-compose.yml:
#   1. As a BuildKit secret at image-build time — Next.js inlines every
#      NEXT_PUBLIC_* value into the client bundles. Rebuild after changing any
#      NEXT_PUBLIC_* value; runtime env cannot update an already-built bundle.
#   2. As runtime env for the server-side secrets below.
#
# Self-hosting v1 runs the same code Aglyn's cloud runs, pointed at YOUR OWN
# Firebase project (Google account required — a vendor-neutral backend is a
# separate roadmap track, AGL-909). NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your Firebase project — client config (NEXT_PUBLIC_*, baked at build) ────
# Firebase console → Project settings → General → Your apps → SDK config.
#
# NEXT_PUBLIC_FIREBASE_PROJECT_ID is REQUIRED if you use SAML SSO. It is the
# last of four sources the SSO auth origin is derived from (AGL-2020); with all
# four blank, setting up SSO now fails with a message naming these variables
# instead of quietly emitting Aglyn's own `*.firebaseapp.com` host — which used
# to be written into YOUR GCIP provider and printed as the Reply/ACS URL for
# your customers to paste into their IdP. Setting NEXT_PUBLIC_WORKSPACE_DOMAIN
# below (the template does) already satisfies it; this is the fallback.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PUBLIC_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Analytics measurement id, and the reCAPTCHA v3 site key if you
# enable Firebase App Check for your project.
#
# Leaving NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY empty is supported and safe: App
# Check registration is SKIPPED rather than attempted with an empty key
# (AGL-2049), and the app logs one warning saying App Check is disabled. Before
# that fix an empty value was passed to ReCaptchaV3Provider, which loaded
# `recaptcha/api.js?render=undefined` and failed asynchronously on every page —
# App Check silently non-functional, with console errors and no explanation.
#
# If you DO set it, remember App Check is registered per Firebase APP and the
# key's own domain allowlist must cover the origins you serve; reCAPTCHA matches
# a listed name and everything beneath it, never its parent.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY=

# ── Your Firebase project — Admin service account (server-only) ──────────────
# Firebase console → Project settings → Service accounts → Generate new key.
# FIREBASE_PRIVATE_KEY keeps the literal "\n" escapes from the JSON.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# ── Domains ───────────────────────────────────────────────────────────────────
# The hostname your console is served on (behind your reverse proxy) and the
# apex the tenant runtime treats as its own. Point a WILDCARD DNS record
# (*.sites.example.com) at the tenant container for published sites.
NEXT_PUBLIC_CONSOLE_URL=https://console.example.com
NEXT_PUBLIC_WORKSPACE_DOMAIN=example.com
NEXT_PUBLIC_AGLYN_TENANT_HOST_CNAME=sites.example.com
# THE SAME VALUE AGAIN, WITHOUT THE PREFIX — these are two different variables
# read by two different apps, and this one is the load-bearing half (AGL-2424).
# The line above is what the CONSOLE prints in the custom-domain wizard. The
# line below is what the TENANT runtime matches an incoming `Host:` against
# (apps/tenant/middleware.ts). Leave it blank and nothing matches, so every
# visitor to every one of your published sites is redirected to your console
# instead of being served the site — the deployment looks broken rather than
# misconfigured. It is baked in at BUILD time via the `env` block of
# apps/tenant/next.config.js, so set it BEFORE `docker compose build`; adding
# it to a running container does not take.
AGLYN_TENANT_HOST_CNAME=sites.example.com
# The apex your sites' assigned subdomains hang off — a site with subdomain
# "acme" is served at acme.<this>. SET THIS: it defaults to `aglyn.app`, which
# is Aglyn's cloud, so leaving it blank makes the console display and link
# every one of your sites at an address you do not control. Normally the same
# value as NEXT_PUBLIC_AGLYN_TENANT_HOST_CNAME above.
NEXT_PUBLIC_TENANT_DOMAIN=sites.example.com
# The A-record addresses the custom-domain wizard tells your customers to point
# an APEX domain at — one that cannot carry a CNAME. Comma-separated IPv4.
#
# SET THESE. The default is Vercel's anycast set (216.198.79.1, 76.76.21.21 and
# three more), because that is where Aglyn's own tenant runtime answers. Leave
# them blank and your console instructs YOUR customers to point their apex DNS
# at a network you do not run, and /api/domains/verify accepts that as proof.
#
# TWO VARIABLES AGAIN, and both are needed: the prefixed one is what the wizard
# PRINTS, the unprefixed one is what the verify route ACCEPTS. Setting only one
# leaves the wizard showing the default list while the route checks yours.
NEXT_PUBLIC_AGLYN_TENANT_APEX_ADDRESSES=
AGLYN_TENANT_APEX_ADDRESSES=

# ── How a hostname becomes reachable (AGL-2436) ──────────────────────────────
# Registering a name used to be a call to Vercel's API, so a Docker install had
# no way to make a workspace subdomain resolve — the console advertised a URL
# and the registration was skipped. The vendor is a DRIVER now:
#
#   wildcard  the ordinary Docker answer — your proxy already answers for
#             *.example.com, so there is nothing to register
#   webhook   Aglyn POSTs attach/detach/status to an endpoint you run; what is
#             behind it (Caddy admin API, Traefik, cert-manager, a shell
#             script) is your business
#   vercel    Aglyn's own hosting, and anyone else on Vercel
#   none      names are handled entirely outside the product — not an error
#
# Unset, the deployment DETECTS: `vercel` when VERCEL_TOKEN is present, `none`
# otherwise. It is never inferred as `wildcard`, deliberately — that driver
# reports a name as serving without checking anything, so claiming to serve a
# name has to be your explicit assertion. An unrecognized value logs and falls
# back to detection.
AGLYN_DOMAIN_PROVIDER=wildcard

# `wildcard` only. The apexes your DNS record and certificate already cover,
# comma-separated; a leading `*.` is tolerated. Defaults to
# NEXT_PUBLIC_WORKSPACE_DOMAIN plus NEXT_PUBLIC_TENANT_DOMAIN, which is usually
# right. An explicit list REPLACES those defaults rather than adding to them,
# so if you set it, list every apex you serve.
#
# ⚠️ A wildcard covers ONE label: *.example.com serves a.example.com and does
# NOT serve a.b.example.com or example.com itself, and the certificate covers
# exactly the same set. The driver matches that rule rather than "ends with",
# so a name it cannot serve is reported as uncovered instead of green.
AGLYN_DOMAIN_WILDCARD_SUFFIXES=

# `webhook` only, and required for it. The endpoint Aglyn POSTs
# {action, scope, domain, redirectTo?} to; the wire format and both reply
# shapes are documented at
# https://docs.aglyn.com/developers/self-hosting-environment#domains-webhook
#
# ⚠️ Put it on your own network. The request carries the token below and the
# names of your customers' domains, and its reply decides whether the console
# tells someone their site is live.
AGLYN_DOMAIN_WEBHOOK_URL=
# Optional; sent as `Authorization: Bearer …`. Omitted entirely when unset.
AGLYN_DOMAIN_WEBHOOK_TOKEN=

# ── Request geo: sanctions screening and consent region (AGL-2435) ───────────
# The headers YOUR reverse proxy sets with the visitor's country and
# subdivision. Aglyn's cloud gets these from Vercel's edge; a container gets
# whatever its proxy puts there, and NOTHING otherwise.
#
# Unset, `readRequestGeo` sees no country on any request, and two things that
# are supposed to be running are not:
#   • the sanctions/embargo gate FAILS OPEN on every request. It logs that it
#     did, once per instance start — look for `[sanctions-geo] FAILING OPEN`
#     in your console logs — but it does not block anything.
#   • the storefront consent-region endpoint has no region to answer with, so
#     region-conditional consent defaults are not applied.
#   • the new-device sign-in alert emails your users "Unknown location", and
#     stores that string on the device record. The staff breach-notification
#     report reads a data subject's country back off it, so its widest bucket
#     counts nobody — the report stays honest about what it does not know, but
#     it knows nothing.
#
# Cloudflare in front of you: `cf-ipcountry` (country only; leave the region
# one blank, Cloudflare does not send a subdivision). Caddy/nginx/Traefik with
# a GeoIP module: whatever name you configure it to set. Country is
# ISO 3166-1 alpha-2; region is ISO 3166-2, bare or prefixed, either is read.
#
# All three fall back to the names the common edges use — `cf-ipcountry`,
# `cloudfront-viewer-country`, `x-appengine-country`, `x-geo-city` and the
# rest — when you name none, so a deployment behind Cloudflare or an AWS/GCP
# load balancer usually works unconfigured. Naming a header always wins over
# the fallbacks; set one when your proxy uses a name of its own.
#
# ⚠️ Baked in at BUILD time — the console's middleware runs in the edge
# runtime, which has no request-time environment — so set these BEFORE
# `docker compose build`, not just before `up`.
#
# If your proxy cannot supply geo at all, leave them blank and know that the
# embargo gate is not running on your deployment.
AGLYN_GEO_COUNTRY_HEADER=
AGLYN_GEO_REGION_HEADER=
# The city, used only to name a place in the new-device sign-in alert. Nothing
# is gated on it; unset simply means the alert names the country alone.
AGLYN_GEO_CITY_HEADER=

# ── Required server secrets ───────────────────────────────────────────────────
# Both generated with `openssl rand -hex 32`. TOKEN_SIGNING_SECRET MUST be the
# same value for console and tenant (compose shares this file, so it is);
# it signs commerce download / gift-card / gated-video links. The code fails
# closed without it.
TOKEN_SIGNING_SECRET=
# Signs the storefront member session cookie; without it, sessions don't
# survive a restart and disagree across instances.
MEMBER_SESSION_SECRET=
# Lets a publish take effect immediately. The console sends this to the tenant
# to drop the published page from cache; the tenant compares it. SET THE SAME
# VALUE ON BOTH — compose shares this file, so it is.
#
# Unset, the console does not send the request at all and records the reason as
# `not-configured`: publishing reports success while the live page keeps
# serving the old HTML for up to ten minutes and the old site documents for up
# to an hour. Nothing errors, which is what makes it hard to notice.
REVALIDATE_SECRET=
# Signs the one-click unsubscribe links in campaign email, as an HMAC over
# hostId:email. Falls back to CRON_SECRET below; with NEITHER set, campaign
# sends answer 501 and every unsubscribe link answers 400.
#
# ⚠️ Because of that fallback, rotating CRON_SECRET on a deployment that never
# set this one permanently breaks the unsubscribe link in every marketing email
# already delivered. Set this explicitly and the two rotate independently.
EMAIL_UNSUBSCRIBE_SECRET=
# Authorizes the tenant's /api/plugins/run-jobs endpoint, which the
# every-minute beat POSTs. Unset, that route answers 501 and NO scheduled
# plugin job ever runs — no scheduled publishing, no booking-hold expiry.
# The cloud function sends it from Secret Manager
# (`firebase functions:secrets:set PLUGIN_JOBS_SECRET`); the value must match.
PLUGIN_JOBS_SECRET=

# ── Optional integrations (features degrade gracefully when absent) ──────────
# Every key below is optional. A missing key disables its feature — the server
# answers 501 and the UI says so — rather than breaking the stack.
#
# Stripe: platform billing + commerce checkout/Connect. The secret key ALONE
# is not enough for plan checkout: without the publishable key and the
# STRIPE_PRICE_* ids, the billing route still refuses. Commerce checkout on a
# storefront needs only the secret key.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Verifies Stripe webhook signatures. Without it, webhook-driven state
# (subscription changes, payment settlement) is never applied.
STRIPE_WEBHOOK_SECRET=
# The endpoint URL /api/health/billing expects to find registered in your
# Stripe account, matched exactly as Stripe stores it. It defaults to Aglyn's
# own URL, so an install that leaves it blank shows a permanent
# `endpoint-missing` red on a webhook that is in fact configured correctly.
STRIPE_WEBHOOK_URL=https://console.example.com/api/billing/webhook
# Plan price ids from YOUR Stripe product catalogue — the console reads one per
# plan/interval (STRIPE_PRICE_BUSINESS, STRIPE_PRICE_BUSINESS_YEARLY,
# STRIPE_PRICE_ADVANCED, …). Only needed if you sell platform plans to your own
# users; a single-tenant install normally leaves the whole Stripe block empty.

# Resend: outbound app email. Without it, email sends are inert no-ops.
#
# USAGE_EMAIL_FROM is the PLATFORM identity — YOUR install talking to its own
# account holders (invites, billing, password resets). A published SITE does
# not use it: a site sends on its own domain under AGLYN_TENANT_MAIL_APEX, and
# a site with no sending domain refuses rather than borrowing this address, so
# one tenant's list quality is never charged against your operator domain.
RESEND_API_KEY=
USAGE_EMAIL_FROM=

# Per-site sending domains (optional, and automatic only if you own the zone).
#
# RESEND_DOMAINS_API_KEY is a FULL-ACCESS Resend key, distinct from the
# send-only one above, used only to create a site's domain. Leave it empty and
# every site's domain stays at `requested`, which refuses sends — set it, or
# set AGLYN_SENDING_DOMAIN_PROVIDER=none and publish the records by hand from
# the table the console shows.
RESEND_DOMAINS_API_KEY=
# AGLYN_SENDING_DOMAIN_PROVIDER=
#
# The apex site sending domains hang off. Defaults to
# mail.{NEXT_PUBLIC_TENANT_DOMAIN}, so it lands in YOUR zone rather than ours.
# A value equal to the web apex is ignored — a mail namespace that is also the
# web namespace lets a site claim a name another site's mail is signed for.
# AGLYN_TENANT_MAIL_APEX=
#
# How many sending domains this install may hold at the provider. Resend caps
# domains PER ACCOUNT by plan (Free 3, Pro 10, Scale 1000) and each subdomain
# spends a slot — there is no wildcard. The default 10 refuses before the
# vendor does, with a message naming the cause. `-1` disables the check.
#
# The allowance is a bundled quota, NOT a per-domain price: Resend meters
# emails, never domains. When this ceiling is reached the cheap fix is the
# flat domain add-on ($20/mo for 100 more, on Pro or Scale), not a tier
# upgrade — the tier is chosen by send volume. Raise this to the allowance the
# plan plus its add-ons actually carries.
#
# The add-on is a TOGGLE that adds one hundred, not a quantity you can buy
# repeatedly; self-serve tops out at 1,100. This ceiling only ever binds
# DEDICATED per-site domains — a site on the shared pool needs no provisioning.
# AGLYN_SENDING_DOMAIN_CAPACITY=10
#
# THE SHARED POOL. A site with no dedicated domain sends its transactional mail
# from a member of a small fixed pool inside the mail apex
# (notifications@shared1.mail.<mail apex> and siblings), assigned by a stable
# hash so a site's identity never drifts. The pool does not grow with hosts:
# its whole cost is this many provider domain objects and three DNS records
# each, at any number of sites.
#
# ⚠ Changing this REQUIRES creating the matching domain objects and records at
# your provider first. The code derives the pool from this number.
# AGLYN_TENANT_SHARED_POOL_SIZE=4
#
# The mailbox the pool sends as. The DOMAIN half is deliberately not
# configurable: under strict DKIM alignment the From: domain must be exactly
# the domain whose key signs it, and each pool member signs for itself.
# AGLYN_TENANT_SHARED_LOCAL_PART=notifications
#
# Automatic DNS needs a zone the install can write. On Vercel DNS that is
# VERCEL_TOKEN (already set above for custom domains). On any other DNS host,
# the records are printed for you to publish and nothing is written for you.

# Require SSO for one or more email domains you own (optional, off by default).
# `domain=gcipTenantId` pairs, comma or space separated. Empty governs nothing,
# which is the right default for a self-host install — nothing about Aglyn's own
# domain is compiled in. This is a rule about a DOMAIN, not about staff: staff can
# still be granted to any account, on any domain, in any pool.
AGLYN_SSO_REQUIRED_DOMAINS=
# Set to exactly `on` to start REFUSING sign-ins that violate the rule above.
# Anything else is off. Keep an account the rule cannot refuse — see
# docs/SELF_HOSTING.md — or a wrong tenant id locks you out of the console.
AGLYN_SSO_DOMAIN_ENFORCEMENT=

# Anthropic: Aglyn Assist (the console helper) and the Besigner's "Rewrite with
# AI". Bring your own key; without it both answer 501 and say they are not
# configured. Note the console Assist panel is additionally behind the
# `release_assist` flag, which is OFF by default.
ANTHROPIC_API_KEY=

# Assist caps — the only thing standing between that key and an unbounded
# Anthropic bill. All three are optional; the defaults are what Aglyn runs.
#
# Messages are counted per workspace, in a transaction, BEFORE the model is
# called, so a refused request spends nothing.
#   ASSIST_FREE_DAILY_LIMIT        free workspaces, per UTC day (default 10)
#   ASSIST_ENTITLED_MONTHLY_LIMIT  entitled workspaces, per month (default 1000)
#
# A message cap only bounds money through an assumed cost per message. This
# one bounds the measured figure instead — the running `estCostUsd` this
# deployment has already metered for that workspace this month, priced at the
# serving model's list rates. Both assist entrypoints refuse above it, in the
# transaction that counts messages, so a workspace at the ceiling buys no
# further tokens. It refuses rather than quietly switching to a cheaper
# model: a silent quality drop is worse than an honest stop.
#
# LEAVE IT BLANK AND YOU GET $40 per workspace per month, which is the point —
# a deployment nobody configured is still bounded. Junk, an empty value, zero
# and negatives all read as unconfigured and take that default, so a typo
# cannot open the ceiling or close it to $0.
#
# To run with NO ceiling, write the word:
#   ASSIST_ORG_MONTHLY_COGS_LIMIT_USD=off
ASSIST_FREE_DAILY_LIMIT=
ASSIST_ENTITLED_MONTHLY_LIMIT=
ASSIST_ORG_MONTHLY_COGS_LIMIT_USD=

# Linear: where the console's "Report an issue" dialog files customer reports
# (AGL-2185). BOTH values are required; either one missing leaves the feature
# off, and the dialog answers 501 saying so rather than dropping a report on
# the floor. SERVER-ONLY — never NEXT_PUBLIC_: this key can read and write your
# whole Linear workspace, and NEXT_PUBLIC_* is inlined into the browser bundle,
# which would publish it to every visitor.
#
# ⚠️ Nothing about Aglyn's Linear workspace is compiled in, and that is
# deliberate: unset, this deployment files NOWHERE. Your customers' reports must
# never arrive in Aglyn's tracker, and Aglyn's team id would not be readable by
# your key anyway — the reports would simply be lost. Point it at YOUR tracker
# or leave it off.
#
# LINEAR_API_KEY: Linear → Settings → Security & access → Personal API keys.
#   SCOPE IT DOWN when you create it. Linear lets a key be restricted to
#   "Create issues" and limited to specific teams — do both, and limit it to
#   the one team below. Then the guarantee that inbound reports cannot reach
#   your delivery team is enforced by the CREDENTIAL, not only by the variable
#   underneath it, and a key leaked from the server cannot read your backlog.
# LINEAR_CUSTOMER_REPORTS_TEAM_ID: the UUID of the team reports should land in.
#   Required — Linear will not create an issue without a team. Keep inbound
#   reports out of whatever queue you plan a release from: unbounded inbound
#   volume in that queue destroys the count you steer by.
# LINEAR_CUSTOMER_REPORTS_PROJECT_ID: OPTIONAL. The UUID of a project inside
#   that team to file into, if you separate intake by project rather than by
#   team. Left blank the report still files, into the team's own backlog — a
#   missing project is a less specific destination, never a lost report.
LINEAR_API_KEY=
LINEAR_CUSTOMER_REPORTS_TEAM_ID=
LINEAR_CUSTOMER_REPORTS_PROJECT_ID=

# Shared secret for the scheduled-job routes (audit archival, erasure runs,
# retention sweeps). The routes stay dormant — and unreachable — until this is
# set; set it if you run a scheduler that calls them. `openssl rand -hex 32`.
CRON_SECRET=

# Only if you deploy cloud/functions: the tenant origin its every-minute beat
# POSTs to, which drives scheduled publishing and booking-hold expiry. NO
# DEFAULT, deliberately (AGL-2176) — it used to fall back to a specific Aglyn
# customer's site, so a missed variable meant your function poking a stranger
# every minute with your PLUGIN_JOBS_SECRET while none of your own jobs ran.
# Unset, the beat does not fire and logs why.
AGLYN_JOB_RUNNER_URL=https://sites.example.com/api/plugins/run-jobs

# Only if you deploy cloud/functions: the origin that SERVES your console.
# Its `consoleFastCrons` job POSTs, every fifteen minutes, the two routes that
# cannot wait for a slower scheduler — scheduled campaign sends and the sweep
# that finishes a custom domain once its certificate or DNS settles (AGL-1617).
# NO DEFAULT, for the same reason as the line above; unset, the job does not
# fire and logs why. It must not be a host that REDIRECTS to your console: a
# redirect drops the POST body and the x-cron-secret header.
#
# CRON_SECRET reaches this function through Secret Manager
# (`firebase functions:secrets:set CRON_SECRET`), not through this file, and
# must equal the console's. AGLYN_PROBE_TOKEN is optional and only needed if a
# bot-protection layer sits in front of your console.
AGLYN_CONSOLE_URL=https://app.example.com

# ── Intentionally absent ──────────────────────────────────────────────────────
# VERCEL_TOKEN / VERCEL_TENANT_PROJECT_ID / VERCEL_CONSOLE_PROJECT_ID /
# VERCEL_TEAM_ID — the configuration of the `vercel` DRIVER above, not a
# requirement of the product. Leave them out unless you deploy to Vercel; their
# presence is also what makes detection choose that driver.
#
# A CUSTOMER'S OWN domain is the one name `wildcard` cannot register — no
# wildcard covers somebody else's apex — so the driver reports `skipped` and the
# console answers 501 naming AGLYN_DOMAIN_PROVIDER. Use `webhook` if you sell
# custom domains. Either way the site still SERVES: the domain claim is written
# before the refusal and the tenant runtime resolves the hostname against it, so
# routing the name to the tenant container by hand works. What the refusal costs
# is the canonical redirect, which stays off while the attachment is pending, so
# both addresses serve the same pages. See docs/SELF_HOSTING.md.

# ── Sales-tax registration (AGL-2021) ─────────────────────────────────────────
# THE BOOTSTRAP, not the control. Where you file and the numbers you file under
# are set in Staff → Platform settings → Sales tax filing, which needs the
# `super` staff role and no redeploy — registering in a new state is an
# operator action.
#
# These fill in every field the console has not stored, which is what a fresh
# install runs on before anybody opens that page. ANYTHING STORED IN THE CONSOLE
# WINS, and the card names the layer each value came from, so a variable you set
# and then override is listed there by name as not in force. Clearing the stored
# record in the console hands these their layer back.
#
# Leave every value blank unless you file: an unset registration renders an
# explicit "not configured" state rather than another company's numbers.
# SERVER-ONLY — never NEXT_PUBLIC_.
#
# Where the deployment files. ISO country plus optional subdivision, written
# the way the report keys its buckets: `US-TX`, `US-CA`, `GB`, `DE`. A value
# that cannot be a bucket key (`Texas`) is reported as a blocking finding
# rather than rendered as a page of zeros — the console refuses one at the
# input, but nothing validates what arrives here.
#
# ⚠️ COLLECTION is jurisdiction-neutral and unaffected by this — rates, tax
# inclusive pricing and Stripe Tax all work anywhere. This names where the
# RETURN is filed. Outside US-TX the report drops the Form 01-114 line items
# and renders a breakdown for manual filing instead, because it is not that
# jurisdiction's return and must not look like one.
AGLYN_TAX_JURISDICTION=US-TX
# The number the authority knows you by — taxpayer number, seller's permit,
# VAT number. The console shows only a last four of it back.
AGLYN_TAX_REGISTRATION_ID=
# The filing-portal credential, where the jurisdiction has one. REQUIRED
# alongside the registration id for US-TX; optional elsewhere, so a correctly
# configured GB deployment does not read "not configured" forever. The console
# never shows this one back at all.
AGLYN_TAX_FILING_ID=
# Deprecated aliases, read only while the jurisdiction ABOVE is US-TX. The
# generic names above win when both are set.
TX_WEBFILE_NUMBER=
TX_TAXPAYER_NUMBER=
# ⚠️ Both identifiers apply only while the jurisdiction IN FORCE matches the one
# above. Change the jurisdiction in the console and they stop applying: one
# authority's registration number is never filed under another.

# ── Operator identity (AGL-2016) ──────────────────────────────────────────────
# WHO RUNS THIS INSTALL, and where legal notices about it should go. Set these.
#
# They are not branding. `NEXT_PUBLIC_OPERATOR_SUPPORT_EMAIL` is printed on the
# PUBLIC, unauthenticated abuse and DMCA counter-notice forms that this software
# serves at /api/report-abuse and /api/counter-notice. Left unset, those pages
# say plainly that this deployment has published no contact address — which is
# honest but useless to a copyright holder, and it is the state you do not want
# a §512 notice to arrive in. They never fall back to Aglyn's addresses:
# misrouting a legal notice to a company that does not host your content helps
# nobody and starts no clock.
#
# ⚠️ NEXT_PUBLIC_* is baked in at BUILD time. Set these BEFORE
# `docker compose build`, not just before `up`, or the images carry the unset
# state regardless of what the running container's environment says.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_SUPPORT_EMAIL=
# Optional: a separate mailbox for legal/copyright notices. Defaults to the
# support address above, so one mailbox is a complete configuration.
NEXT_PUBLIC_OPERATOR_LEGAL_EMAIL=
# Where YOUR published terms/privacy/DMCA pages live, no trailing slash.
# The signup clickwrap LINKS here now (AGL-2017) — unset, your users are shown
# a checkbox agreeing to Aglyn LLC's Terms, for a service Aglyn does not
# provide. It also governs which origin `isPublishedLegalUrl` accepts, so the
# marketplace publisher-agreement gate follows your ORIGIN rather than ours.
#
# ⚠️ It follows your origin, NOT your publication state, and the difference
# bites (AGL-2014). The list of paths treated as published — including
# /legal/marketplace-publisher-agreement — is repo-committed and was verified
# against AGLYN's site. Point the origin at yours and
# `publisherAgreementIsPublished()` answers TRUE for
# <your-origin>/legal/marketplace-publisher-agreement whether or not you ever
# created that page. Measured: it returns true for an invented origin. So the
# console will ask your publishers to accept a document behind a link that
# 404s, which is the exact defect that gate was built to prevent (AGL-1660).
# Publish that page at that path before you enable marketplace publishing.
#
# ⚠️ STILL OPEN, and you should know before you rely on this: the acceptance
# RECORD is pinned to Aglyn's document snapshots (version + sha256 + byte
# count). So your user follows a link to your terms and the row written into
# your Firestore names our bytes. Closing that is a decision — your own
# document identity, or a mode with no platform agreement at all — tracked on
# AGL-2017. Until then, treat the recorded evidence as unusable and rely on
# your own acceptance flow if you need one that stands up.
NEXT_PUBLIC_OPERATOR_LEGAL_ORIGIN=

# ── DMCA designated agent (AGL-2016) ──────────────────────────────────────────
# ⚠️ READ THIS BEFORE FILLING IT IN. Aglyn's designated-agent registration is
# Aglyn's; running this software does NOT put you under it, and §512(c)(2)
# makes registering your own agent with the U.S. Copyright Office a PRECONDITION
# of the safe harbor rather than a formality. The counter-notice and
# repeat-infringer machinery in this software works without a registration —
# it just does not, by itself, obtain you the limitation on liability.
#
# Leave blank if you have not filed. Blank means the product makes no claim,
# which is the correct output for almost every deployment.
NEXT_PUBLIC_OPERATOR_DMCA_AGENT_NAME=
NEXT_PUBLIC_OPERATOR_DMCA_AGENT_ADDRESS=
NEXT_PUBLIC_OPERATOR_DMCA_AGENT_EMAIL=
NEXT_PUBLIC_OPERATOR_DMCA_AGENT_PHONE=
# Set to exactly `true` ONLY if you have actually registered the agent above
# with the U.S. Copyright Office. Naming an agent does not set this; nothing
# infers it. Anything other than `true` is read as "not registered".
NEXT_PUBLIC_OPERATOR_DMCA_AGENT_REGISTERED=

# ── Plugin sandbox loader (AGL-2196) ─────────────────────────────────────────
# ONLY needed if you deploy `tools/plugin-loader/origin` — the tiny separate
# service that serves the plugin sandbox iframe on its own origin. These are
# read by THAT deployment's environment, not by the console container, and they
# are not NEXT_PUBLIC_ (it is not a Next app).
#
# Unset, the loader points at Aglyn's console. That is not merely a wrong
# default: `frame-ancestors` would name only `app.aglyn.com` and `*.aglyn.app`,
# so YOUR console could never frame YOUR sandbox — a blank iframe the browser
# blocks — while the two manifest lookups it makes on every load would arrive at
# Aglyn's marketplace API carrying your listing and host ids, and return 404s
# that silently strip every plugin's declared network capability.
#
# Your console's origin (scheme + host, no path).
PLUGIN_LOADER_CONSOLE_URL=https://console.example.com
# The apex your published sites hang off — normally the same value as
# NEXT_PUBLIC_TENANT_DOMAIN above. `*.<this>` is what may frame the sandbox.
PLUGIN_LOADER_TENANT_DOMAIN=sites.example.com

# ── Documentation origin ──────────────────────────────────────────────────────
# Where EVERY docs link points: AI-assist citations, every console help link,
# every besigner help link, and the `documentation` URL your own REST API
# returns. Defaults to https://docs.aglyn.com — the documentation for this
# software, which stays broadly correct for a self-host install. Point it at
# your own build of apps/docs if you publish one.
#
# It used to govern only the Assist citations, while the console and besigner
# read a separate undocumented NEXT_PUBLIC_AGLYN_DOCS_URL — so setting this one
# retargeted a third of your links and left the rest citing ours (AGL-2186).
# One name now; the old one is still honoured if you already set it.
NEXT_PUBLIC_DOCS_ORIGIN=

# ── Publishing your own docs build (AGL-2124) ─────────────────────────────────
# ONLY needed if you build and publish `apps/docs` as your own documentation
# site. Every value below is read at BUILD time by `docusaurus build`, from the
# environment of that build — they are not container runtime env, and they are
# NOT NEXT_PUBLIC_* (Docusaurus is not Next).
#
# All three telemetry-shaped values are OFF when unset. That is the point:
# before this, a docs build shipped Aglyn's GA4 measurement id and posted its
# browser errors to Aglyn's production console, so an operator's readers were
# reported to us and the operator got nothing. Unset now means nothing is sent
# anywhere — never that it is sent to Aglyn.
#
# Your own GA4 measurement id (`G-XXXXXXXXXX`). Blank = no analytics tag is
# loaded at all.
DOCS_GA_TRACKING_ID=
# Where uncaught browser errors on your docs site POST. Blank = the beacon
# installs no handlers and reports nothing. Point it at your own console's
# collector — `https://console.example.com/api/errors` — and set
# NEXT_PUBLIC_DOCS_ORIGIN on the CONSOLE to your docs origin so its CORS grant
# accepts you.
DOCS_ERROR_BEACON_ENDPOINT=
# What the /status page probes, as comma-separated `name|label|origin` triples,
# e.g. `console|Console|https://console.example.com,sites|Published sites|https://sites.example.com`.
# Blank = the page probes nothing and says so. It previously probed Aglyn's
# production and presented OUR uptime as yours, which is a false all-clear
# during YOUR outage.
DOCS_STATUS_TARGETS=
# An INDEPENDENT status page to send readers to when /status itself will not
# load — a single http(s) URL, e.g. a free UptimeRobot page at
# `https://stats.uptimerobot.com/<id>`. Blank = /status prints no such line.
# Point it at YOUR OWN monitor: /status is served from your infrastructure, so
# an outage broad enough to take that down takes the status page with it, and
# this is the only link on the page that still works when that happens.
DOCS_STATUS_FALLBACK_URL=
# The canonical origin your docs are served at; canonical tags and the sitemap
# are built from it, so leaving it at ours makes your build claim our domain.
DOCS_URL=
# Name in the footer copyright line. Defaults to `Aglyn LLC`, followed by
# Aglyn's trademark attribution. Setting this replaces the name AND drops the
# attribution — your fork is welcome to the code, but it must not tell your
# readers that YOUR docs carry OUR marks.
DOCS_ORGANIZATION_NAME=

# ── Which build this is (AGL-2091) ────────────────────────────────────────────
# Optional. `/api/health` on both containers reports `version` — read from
# package.json at build time, so it is already correct and needs nothing here —
# and `commit`, which is null unless something stamps it. Set that stamp either
# as a build argument, which is the better answer because it changes per build:
#
#   COMMIT_REF=$(git rev-parse HEAD) docker compose up --build
#
# …or here, if a fixed identifier for your fork suits you better. The build
# argument wins where both are set. Leave it blank and the health body reports
# `commit: null` honestly rather than inventing an id.
#
# ⚠️ Read at BUILD time. Rebuild after changing it; runtime env alone will not
# update what an already-built image reports.
COMMIT_REF=

# ── Platform brand (AGL-2153) ─────────────────────────────────────────────────
# What this deployment calls itself. Unset means "Aglyn", which is visible to
# YOU on your own first page load — so unlike the operator identity above, a
# default here is a default rather than a trap. Set it anyway: it is the name
# your users see in every browser tab, in the installed app on their home
# screen, in the OS prompt when they save a passkey, in transactional email,
# and in the `generator` / `x-powered-by` fingerprint on every site you publish.
#
# Setting this also drops the "Aglyn™ and Besigner™ are trademarks of Aglyn
# LLC" line from the console footer. That is deliberate and it is the same
# boundary NOTICE draws: the SOURCE is Apache-2.0 and yours, the NAMES are not.
#
# ⚠️ NEXT_PUBLIC_* is baked in at BUILD time. Set these BEFORE
# `docker compose build`, not just before `up`.
NEXT_PUBLIC_PLATFORM_BRAND_NAME=
# The legal entity, for copyright lines. Defaults to "<brand> LLC", which is a
# US company form — set it explicitly if you are not one.
NEXT_PUBLIC_PLATFORM_BRAND_LEGAL_NAME=
# Where "need help?" links point. If you leave this blank it falls back to
# NEXT_PUBLIC_OPERATOR_SUPPORT_EMAIL as a mailto: before it ever falls back to
# Aglyn's support page, so setting the operator identity above is normally
# enough.
NEXT_PUBLIC_PLATFORM_SUPPORT_URL=
#
# NOT configurable by env, and deliberately so: the favicon, app icons and
# social card are IMAGES, under apps/console/public/_static/images/brand and
# apps/tenant/public/_static/images/brand. Replace the files in your Docker
# build context — that is how you skin an image, and it is not a source edit.
