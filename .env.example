# Root .env — sourced by the repo tooling in tools/scripts (`set -a && source .env`):
# the manual rules-deploy scripts, set-staff-claim, setup-stripe, seed-e2e, and
# the plugin trust-key tools. ALL SERVER-ONLY SECRETS — never commit a real .env.

# ── Firebase Admin service account ────────────────────────────────────────────
# The service-account JSON fields (from Firebase console → Project settings →
# Service accounts). Used by every Admin-SDK script. FIREBASE_PRIVATE_KEY keeps
# the literal "\n" escapes — the scripts un-escape them.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=aglyn-main
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=

# Instance URLs (used by the storage/database rule-deploy scripts).
FIREBASE_DATABASE_URL=https://aglyn-main-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=aglyn-main.appspot.com

# ── Plugin trust chain ────────────────────────────────────────────────────────
# Ed25519 PRIVATE key that signs realm-plugin bundles (generate with
# tools/scripts/generate-plugin-trust-key.mjs). NEVER expose; the matching
# NEXT_PUBLIC_PLUGIN_TRUST_PUBLIC_KEY goes in the apps.
PLUGIN_TRUST_PRIVATE_KEY=

# ── Stripe (setup-stripe.mjs) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_URL=

# ── Commerce token signing (AGL-509 / AGL-682) ────────────────────────────────
# Signs commerce download, supplier and gated-video tokens. REQUIRED — the
# code fails closed if unset, deliberately: the original bug was a guessable
# `STRIPE_SECRET_KEY ?? 'aglyn'` fallback that made those tokens forgeable.
# `openssl rand -hex 32`.
#
# MUST be the SAME value in the console and tenant deployments — the console's
# Stripe webhook mints links the tenant app verifies. A mismatch does not error;
# it just rejects every link as an invalid signature.
#
# ROTATION: changing this invalidates every outstanding download and gift-card
# link. See docs/COMMERCE_TOKEN_SIGNING.md before rotating.
TOKEN_SIGNING_SECRET=

# Signs the storefront member session cookie. Falls back to a per-boot random
# value, which is fine locally but means sessions do not survive a deploy and
# disagree across instances — so production must set it. `openssl rand -hex 32`.
MEMBER_SESSION_SECRET=

# ── Vercel (domain/deploy tooling) ────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_CONSOLE_PROJECT_ID=
VERCEL_TENANT_PROJECT_ID=

# ── Vercel log-drain receiver (AGL-1921) ──────────────────────────────────────
# CONSOLE DEPLOYMENT ONLY. One receiver at /api/log-drain serves the drains of
# BOTH Vercel projects; it forwards only 5xx / crashed-lambda / fatal entries
# into the `vercel-runtime` log in aglyn-main, and drops everything else
# unwritten. See docs/UPTIME_AND_SLA.md.
#
# The drain's signature secret. Vercel signs each delivery as
# hmac-sha1(rawBody, secret) in `x-vercel-signature`. The receiver FAILS CLOSED:
# unset means every delivery is rejected and nothing is ever written, which is
# the right default for an endpoint whose URL is public. Generate with
# `openssl rand -hex 32` and paste the SAME value into the drain's "Signature
# Verification Secret" field for each project.
VERCEL_LOG_DRAIN_SECRET=
#
# The endpoint-ownership token Vercel shows next to the endpoint URL when the
# drain is created; the receiver echoes it back as `x-vercel-verify`. Set it
# BEFORE creating the drain. If unset, the receiver echoes whatever
# `x-vercel-verify` the caller presented, which is usually enough — but the
# explicit value is the documented path.
VERCEL_LOG_DRAIN_VERIFY=

# ── App Check reCAPTCHA allowlist (AGL-1378) ─────────────────────────────────
# Full resource name of the App Check reCAPTCHA key, so a custom console domain
# can be allowlisted automatically when it is attached. The last segment MUST
# equal NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY.
#
# Leave BOTH this and NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY unset for self-host and
# local dev — that means App Check is not running and there is no allowlist to
# maintain. Setting the site key WITHOUT this one is a hard failure by design:
# it would report custom console domains ready while listing none of them, and
# every browser there would be refused at sign-in. Needs an IAM grant on the
# project the key lives in — see docs/APPCHECK_DOMAIN_ALLOWLIST.md.
RECAPTCHA_ADMIN_KEY_NAME=

# ── Local e2e / emulator ──────────────────────────────────────────────────────
E2E_PASSWORD=
# Set these only when pointing scripts at the local emulators:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8082
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Operator identity (AGL-2016) ──────────────────────────────────────────────
# WHO RUNS THIS DEPLOYMENT. Printed on the public abuse and DMCA counter-notice
# intakes, the lockdown 503, the quarantine notice and the sanctions 451.
#
# ⚠️ There is NO built-in fallback to Aglyn's addresses — deliberately, so that
# a self-host install cannot silently route a third party's §512 notice to us.
# The consequence for OUR deployments is that these must be set in Vercel (and
# locally) or those surfaces render "not configured". Production values:
NEXT_PUBLIC_OPERATOR_NAME=Aglyn LLC
NEXT_PUBLIC_OPERATOR_SUPPORT_EMAIL=support@aglyn.com
NEXT_PUBLIC_OPERATOR_LEGAL_ORIGIN=https://aglyn.com
# NEXT_PUBLIC_OPERATOR_LEGAL_EMAIL — unset; support@ carries these surfaces.
# abuse@, dmca@ and legal@ were confirmed to deliver on 2026-08-19 (AGL-1911),
# so this is now a routing preference, not a workaround: keeping the public
# intakes on support@ puts them in the queue staff actually triage. Set it to
# legal@aglyn.com if you want §512 notices split out.
#
# DMCA designated agent — leave UNSET until AGL-1983's filing is actually made
# (AGL-1973 is the mailbox question, which is now closed; the U.S. Copyright
# Office registration is a separate, still-outstanding precondition).
# apps/docs/docs/staff-console/abuse-reports.md carries the standing warning
# that the registration is a precondition of the safe harbour and is not done.
# NEXT_PUBLIC_OPERATOR_DMCA_AGENT_NAME=
# NEXT_PUBLIC_OPERATOR_DMCA_AGENT_ADDRESS=
# NEXT_PUBLIC_OPERATOR_DMCA_AGENT_REGISTERED=
