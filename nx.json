{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultProject": "console",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "generators": {
    "@nx/js": {
      "library": {
        "buildable": true,
        "publishable": true,
        "includeBabelRc": true,
        "standaloneConfig": true,
        "compiler": "swc",
        "config": "project",
        "testEnvironment": "node",
        "unitTestRunner": "jest",
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "library": {
        "buildable": true,
        "publishable": true,
        "includeBabelRc": true,
        "standaloneConfig": true,
        "compiler": "swc",
        "config": "project",
        "testEnvironment": "node",
        "unitTestRunner": "jest",
        "linter": "eslint"
      },
      "application": {
        "swc": true,
        "babel": true
      }
    },
    "@nx/node": {
      "library": {
        "buildable": true,
        "publishable": true,
        "includeBabelRc": true,
        "standaloneConfig": true,
        "compiler": "swc",
        "config": "project",
        "testEnvironment": "node",
        "unitTestRunner": "jest",
        "linter": "eslint"
      }
    },
    "@nx/next": {
      "application": {
        "swc": true,
        "standaloneConfig": true,
        "linter": "eslint",
        "unitTestRunner": "jest",
        "e2eTestRunner": "cypress",
        "style": "none"
      },
      "library": {
        "buildable": true,
        "publishable": true,
        "includeBabelRc": true,
        "standaloneConfig": true,
        "compiler": "swc",
        "config": "project",
        "testEnvironment": "node",
        "unitTestRunner": "jest",
        "linter": "eslint"
      }
    }
  },
  "targetDefaults": {
    "e2e": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "build": [
      {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/next/plugin"
        },
        "cache": false,
        "defaultConfiguration": "production",
        "configurations": {
          "production": {},
          "development": {}
        },
        "dependsOn": [],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/dist/{projectRoot}/.next/!(cache)/**/*",
          "{workspaceRoot}/dist/{projectRoot}/.next/!(cache)"
        ]
      }
    ],
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ],
    "lint": [
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tools/lint-rules/**/*",
          "{workspaceRoot}/eslint.config.mjs",
          {
            "externalDependencies": [
              "eslint"
            ]
          }
        ]
      }
    ],
    "serve": [
      {
        "filter": {
          "plugin": "@nx/next/plugin"
        },
        "defaultConfiguration": "development",
        "dependsOn": [
          "clean-next-cache"
        ],
        "configurations": {
          "production": {},
          "development": {}
        }
      }
    ]
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/workspace.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tslint.json",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json",
      "!{projectRoot}/eslint.config.mjs"
    ]
  },
  "useDaemonProcess": true,
  "neverConnectToCloud": true,
  "parallel": 3,
  "defaultBase": "main",
  "analytics": true,
  "pluginsConfig": {},
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/console/**/*",
        "apps/docs/**/*",
        "apps/tenant/**/*",
        "apps/zapier/**/*",
        "libs/aglyn/**/*",
        "libs/aglyn-markdown-editor/**/*",
        "libs/aglyn-node-renderer/**/*",
        "libs/aglyn-transfer-ui/**/*",
        "libs/besigner/core/**/*",
        "libs/besigner/feature/designer/**/*",
        "libs/cli/**/*",
        "libs/plugins/**/*",
        "libs/shared/data/mdi/**/*",
        "libs/shared/ui/color-picker/**/*",
        "libs/shared/ui/email-campaigns/**/*",
        "libs/shared/ui/json-editor/**/*",
        "libs/shared/ui/jsx/**/*",
        "libs/shared/ui/jsx-forms/**/*",
        "libs/shared/ui/next/**/*",
        "libs/shared/ui/theme/**/*",
        "libs/shared/util/dom/**/*",
        "libs/shared/util/email/**/*",
        "libs/shared/util/errors/**/*",
        "libs/shared/util/first-touch/**/*",
        "libs/shared/util/http/**/*",
        "libs/shared/util/logger/**/*",
        "libs/shared/util/timestamp/**/*",
        "libs/shared/util/tools/**/*",
        "libs/shared/util/vendor/**/*",
        "libs/tenant/data/admin/**/*",
        "libs/tenant/feature/instance/**/*",
        "libs/tenant/runtime/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/console/**/*",
        "apps/console-e2e/**/*",
        "apps/docs/**/*",
        "apps/tenant/**/*",
        "apps/tenant-e2e/**/*",
        "apps/zapier/**/*",
        "libs/aglyn/**/*",
        "libs/aglyn-markdown-editor/**/*",
        "libs/aglyn-node-renderer/**/*",
        "libs/aglyn-transfer-ui/**/*",
        "libs/besigner/core/**/*",
        "libs/besigner/feature/designer/**/*",
        "libs/cli/**/*",
        "libs/plugins/**/*",
        "libs/shared/data/enums/**/*",
        "libs/shared/data/forms/**/*",
        "libs/shared/data/mdi/**/*",
        "libs/shared/data/regex/**/*",
        "libs/shared/data/types/**/*",
        "libs/shared/svg-icons/svg-icons/**/*",
        "libs/shared/ui/color-picker/**/*",
        "libs/shared/ui/email-campaigns/**/*",
        "libs/shared/ui/json-editor/**/*",
        "libs/shared/ui/jsx/**/*",
        "libs/shared/ui/jsx-forms/**/*",
        "libs/shared/ui/next/**/*",
        "libs/shared/ui/snackstack/**/*",
        "libs/shared/ui/theme/**/*",
        "libs/shared/util/dom/**/*",
        "libs/shared/util/email/**/*",
        "libs/shared/util/errors/**/*",
        "libs/shared/util/fbserver/**/*",
        "libs/shared/util/first-touch/**/*",
        "libs/shared/util/http/**/*",
        "libs/shared/util/logger/**/*",
        "libs/shared/util/next/**/*",
        "libs/shared/util/rest-api/**/*",
        "libs/shared/util/timestamp/**/*",
        "libs/shared/util/tools/**/*",
        "libs/shared/util/vendor/**/*",
        "libs/tenant/data/admin/**/*",
        "libs/tenant/feature/instance/**/*",
        "libs/tenant/runtime/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      },
      "include": [
        "libs/shared/svg-icons/svg-icons/**/*"
      ]
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "serve",
        "startTargetName": "start",
        "serveStaticTargetName": "serve-static"
      }
    }
  ]
}
