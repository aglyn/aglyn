{
  "version": 2,
  "functions": {
    "api/load.js": {
      "includeFiles": "**/load.html"
    }
  },
  "rewrites": [
    {
      "source": "/load",
      "destination": "/api/load"
    },
    {
      "source": "/artifacts/:path*",
      "destination": "https://app.aglyn.com/api/plugin-artifacts/:path*"
    }
  ],
  "headers": [
    {
      "source": "/artifacts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}