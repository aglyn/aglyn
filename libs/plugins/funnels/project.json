{
  "name": "plugins-funnels",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plugins/funnels/src",
  "projectType": "library",
  "tags": ["aglyn:addons", "scope:plugin", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/plugins/funnels",
        "main": "libs/plugins/funnels/src/index.ts",
        "tsConfig": "libs/plugins/funnels/tsconfig.lib.json",
        "assets": ["libs/plugins/funnels/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "@swc/jest"]
        }
      ]
    }
  }
}
