                  "options": [
                    {
                      "value": "custom",
                      "label": "Another size"
                    }
                  ],
                  "optionsFrom": {
                    "items": "data.settings.settings.packages",
                    "value": "{item.id}",
                    "label": "{item.name} ({item.lengthCm} × {item.widthCm} × {item.heightCm} cm)"
                  }
                },
