              "id": "check",
              "label": "Check address",
              "icon": "location_on|location_on",
              "when": "data.order.shippingAddress && data.order.shippable",
              "url": "/api/shipping/address/validate",
              "body": {
                "hostId": "{site.id}",
                "recordId": "{params.orderId}"
              },
              "instead": [
                {
                  "when": "response.check.verdict == valid",
                  "title": "Address",
                  "text": "The carrier can deliver to this address."
                },
                {
                  "when": "response.check.verdict == invalid",
                  "title": "Address",
                  "text": "The carrier cannot deliver to this address. {response.check.messages}"
                },
                {
                  "when": "response.check.verdict == corrected",
                  "title": "Address",
                  "text": "The carrier suggests: {response.check.suggested.line1}, {response.check.suggested.city}, {response.check.suggested.state} {response.check.suggested.postalCode}"
