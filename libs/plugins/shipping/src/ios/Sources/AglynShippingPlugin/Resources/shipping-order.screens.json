                  "hostId": "{site.id}",
                  "recordId": "{params.orderId}",
                  "shipmentId": "{response.shipmentId}",
                  "rateId": "{form.rateId}",
                  "attemptKey": "{response.shipmentId}-{form.rateId}"
                },
                "open": "label.labelUrl",
                "success": "Label bought"
              }
            },
            {
              "id": "buyReturn",
              "label": "Return label",
              "icon": "printer|print",
              "when": "data.order.returnable",
              "prompt": [
                {
                  "fieldsFrom": {
                    "items": "data.order.shipLines",
                    "each": [
                      {
                        "key": "qty_{item.lineItemId}",
                        "label": "{item.name} (of {item.fulfilledQuantity})",
                        "kind": "number",
                        "integer": true,
                        "min": 0,
                        "max": "{item.fulfilledQuantity}",
                        "initial": "{item.fulfilledQuantity}"
                      }
                    ]
                  }
                },
