{
  "name": "plugins-ai",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plugins/ai/src",
  "projectType": "library",
  "tags": [
    "aglyn:addons",
    "scope:plugin",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/plugins/ai",
        "main": "libs/plugins/ai/src/index.ts",
        "tsConfig": "libs/plugins/ai/tsconfig.lib.json",
        "assets": [
          "libs/plugins/ai/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/plugins/ai"
      ],
      "options": {
        "jestConfig": "libs/plugins/ai/jest.config.ts"
      }
    }
  }
}
