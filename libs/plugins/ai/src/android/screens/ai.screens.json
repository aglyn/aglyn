{
  "$comment": "The AI plugin's native screens, read by both its Apple package (Resources links here) and its Kotlin module: AI jobs and their status, credits, the hard cap and overage cap, per-member usage, and the staff zones staffOrg and staffUser. Routes: /api/ai/jobs, /api/ai/jobs/{id}/cancel and /resume, /api/ai/billing/credits, /api/ai/billing/overage, /api/ai/allotments, /api/ai/usage, /api/ai/admin/org, /api/ai/admin/user, /api/ai/admin/credits. Grammar: docs/mobile/native-architecture.md §13.",
  "screens": [
    {
      "id": "ai.jobs",
      "title": "AI jobs",
      "subtitle": "What AI is building on this site",
      "icon": "sparkles|auto_awesome",
      "scope": "site",
      "order": 60,
      "links": [
        "/ai-jobs"
      ],
      "load": {
        "jobs": "/api/ai/jobs?orgId={org.id}&hostId={site.id}&limit=50",
        "credits": {
          "url": "/api/ai/billing/credits?orgId={org.id}",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "meters",
          "title": "AI credits this month",
          "when": "data.credits.credits",
          "meters": [
            {
              "label": "Credits used",
              "used": "{data.credits.credits.used}",
              "limit": "{data.credits.credits.limit|'-1'}",
              "note": "{data.credits.credits.remaining:number} left"
            }
          ]
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.credits.unlimited",
          "text": "AI credits are not capped on this workspace."
        },
        {
          "type": "list",
          "title": "Jobs",
          "split": true,
          "items": "data.jobs.jobs",
          "primary": "{item.brief|item.kind:title}",
          "secondary": "{item.kind:title} · {item.createdAt:datetime}",
          "tertiary": "{item.creditsSpent:number} credits",
          "icon": "sparkles|auto_awesome",
          "badges": [
            {
              "text": "{item.status:title}",
              "tones": {
                "Queued": "info",
                "Running": "info",
                "Needs input": "warning",
                "Needs review": "warning",
                "Done": "success",
                "Failed": "error",
                "Canceled": "neutral"
              }
            }
          ],
          "open": {
            "screen": "ai.job",
            "params": {
              "jobId": "{item.id}"
            }
          },
          "actions": [
            {
              "id": "cancel",
              "label": "Cancel",
              "icon": "xmark.circle|cancel",
              "destructive": true,
              "when": "item.status == queued,running,needs_input,needs_review",
              "confirm": "Cancel this job? Unspent credits come back.",
              "url": "/api/ai/jobs/{item.id}/cancel",
              "body": {
                "orgId": "{org.id}"
              },
              "success": "Canceled"
            },
            {
              "id": "resume",
              "label": "Try again",
              "icon": "arrow.clockwise|refresh",
              "when": "item.status == failed",
              "url": "/api/ai/jobs/{item.id}/resume",
              "body": {
                "orgId": "{org.id}",
                "hostId": "{site.id}"
              },
              "success": "Started again"
            }
          ],
          "empty": "No AI jobs on this site yet."
        }
      ]
    },
    {
      "id": "ai.job",
      "title": "{data.jobs.jobs[id=params.jobId].brief|'AI job'}",
      "label": "AI job",
      "icon": "sparkles|auto_awesome",
      "scope": "site",
      "links": [
        "/ai-jobs/:jobId"
      ],
      "load": {
        "jobs": "/api/ai/jobs?orgId={org.id}&hostId={site.id}&limit=100"
      },
      "blocks": [
        {
          "type": "notice",
          "tone": "error",
          "when": "data.jobs.jobs[id=params.jobId].error",
          "text": "{data.jobs.jobs[id=params.jobId].error}"
        },
        {
          "type": "fields",
          "object": "data.jobs.jobs[id=params.jobId]",
          "rows": [
            {
              "label": "Status",
              "value": "{item.status:title}",
              "chip": true,
              "tones": {
                "Done": "success",
                "Failed": "error",
                "Running": "info",
                "Needs review": "warning",
                "*": "neutral"
              }
            },
            {
              "label": "Kind",
              "value": "{item.kind:title}"
            },
            {
              "label": "Brief",
              "value": "{item.brief}"
            },
            {
              "label": "Credits reserved",
              "value": "{item.creditsReserved:number}"
            },
            {
              "label": "Credits spent",
              "value": "{item.creditsSpent:number}"
            },
            {
              "label": "Credits returned",
              "value": "{item.refundedCredits:number}",
              "when": "item.refundedCredits"
            },
            {
              "label": "Started",
              "value": "{item.createdAt:datetime}"
            },
            {
              "label": "Updated",
              "value": "{item.updatedAt:datetime}"
            }
          ]
        },
        {
          "type": "list",
          "title": "Steps",
          "items": "data.jobs.jobs[id=params.jobId].steps",
          "primary": "{item.name:title}",
          "secondary": "{item.error|item.endedAt|item.startedAt:datetime}",
          "trailing": "{item.creditsSpent:number}",
          "badges": [
            {
              "text": "{item.status:title}",
              "tones": {
                "Done": "success",
                "Failed": "error",
                "Running": "info",
                "*": "neutral"
              }
            }
          ],
          "count": false,
          "empty": "Not started."
        },
        {
          "type": "list",
          "title": "Made",
          "items": "data.jobs.jobs[id=params.jobId].outputs",
          "primary": "{item.title|item.name|item.kind:title}",
          "secondary": "{item.kind:title}",
          "count": false,
          "empty": "Nothing yet."
        },
        {
          "type": "actions",
          "items": [
            {
              "id": "cancel",
              "label": "Cancel the job",
              "icon": "xmark.circle|cancel",
              "destructive": true,
              "when": "data.jobs.jobs[id=params.jobId].status == queued,running,needs_input,needs_review",
              "confirm": "Cancel this job? Unspent credits come back.",
              "url": "/api/ai/jobs/{params.jobId}/cancel",
              "body": {
                "orgId": "{org.id}"
              },
              "success": "Canceled"
            },
            {
              "id": "resume",
              "label": "Try again",
              "icon": "arrow.clockwise|refresh",
              "when": "data.jobs.jobs[id=params.jobId].status == failed",
              "url": "/api/ai/jobs/{params.jobId}/resume",
              "body": {
                "orgId": "{org.id}",
                "hostId": "{site.id}"
              },
              "success": "Started again"
            }
          ]
        }
      ]
    },
    {
      "id": "ai.credits",
      "title": "AI credits",
      "subtitle": "Credits, the cap and who used them",
      "icon": "sparkles|auto_awesome",
      "scope": "org",
      "zones": [
        "orgBillingUsage"
      ],
      "order": 10,
      "load": {
        "credits": {
          "url": "/api/ai/billing/credits?orgId={org.id}",
          "optional": true
        },
        "overage": {
          "url": "/api/ai/billing/overage",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "allotments": {
          "url": "/api/ai/allotments?orgId={org.id}",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "meters",
          "title": "This month",
          "when": "data.credits.credits",
          "meters": [
            {
              "label": "Credits used",
              "used": "{data.credits.credits.used}",
              "limit": "{data.credits.credits.limit|'-1'}",
              "note": "{data.credits.credits.remaining:number} left"
            }
          ]
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.credits.unlimited",
          "text": "AI credits are not capped on this workspace."
        },
        {
          "type": "notice",
          "tone": "warning",
          "when": "!data.credits.credits && !data.credits.unlimited",
          "text": "AI is not part of this workspace's plan yet. Plans are on the Billing page."
        },
        {
          "type": "form",
          "title": "When the included credits run out",
          "id": "hardCap",
          "when": "data.overage",
          "fields": [
            {
              "key": "hardCap",
              "label": "{data.overage.label|'Stop AI at the included credits'}",
              "kind": "toggle",
              "initial": "{data.overage.hardCap}"
            }
          ],
          "submit": {
            "label": "Save",
            "when": "org.manager",
            "url": "/api/ai/billing/overage",
            "body": {
              "orgId": "{org.id}",
              "action": "setHardCap",
              "hardCap": "{form.hardCap}"
            },
            "success": "Saved"
          }
        },
        {
          "type": "form",
          "id": "cap",
          "when": "data.overage.sellsOverage && !data.overage.hardCap",
          "fields": [
            {
              "key": "capUsd",
              "label": "{data.overage.capLabel|'Monthly cap on extra AI use (USD)'}",
              "kind": "number",
              "initial": "{data.overage.capUsd}",
              "help": "Between {data.overage.minCapUsd} and {data.overage.maxCapUsd}."
            }
          ],
          "submit": {
            "label": "Save cap",
            "when": "org.manager",
            "url": "/api/ai/billing/overage",
            "body": {
              "orgId": "{org.id}",
              "action": "setCap",
              "capUsd": "{form.capUsd}"
            },
            "success": "Saved"
          }
        },
        {
          "type": "list",
          "title": "By person",
          "items": "data.allotments.members",
          "primary": "{item.name|item.email|item.uid}",
          "secondary": "{item.role:title}",
          "trailing": "{item.credits.used|item.credits:number}",
          "icon": "person.crop.circle|account_circle",
          "open": {
            "screen": "ai.member",
            "params": {
              "uid": "{item.uid}"
            }
          },
          "empty": "No AI use this month."
        },
        {
          "type": "list",
          "title": "By site",
          "items": "data.allotments.sites",
          "primary": "{item.name|item.hostId}",
          "trailing": "{item.credits.used|item.credits:number}",
          "icon": "globe|public",
          "empty": "—"
        }
      ]
    },
    {
      "id": "ai.member",
      "title": "AI use",
      "subtitle": "Credits this person used",
      "icon": "sparkles|auto_awesome",
      "scope": "org",
      "zones": [
        "orgMember"
      ],
      "order": 10,
      "load": {
        "usage": "/api/ai/usage?orgId={org.id}&uid={params.uid}"
      },
      "blocks": [
        {
          "type": "fields",
          "object": "data.usage",
          "rows": [
            {
              "label": "Month",
              "value": "{item.month}"
            },
            {
              "label": "Credits used",
              "value": "{item.usedCredits|item.credits|item.total.credits:number}"
            },
            {
              "label": "Requests",
              "value": "{item.requests|item.total.requests:number}"
            }
          ]
        },
        {
          "type": "list",
          "title": "By feature",
          "items": "data.usage.byFeature",
          "primary": "{item.label|item.feature:title}",
          "trailing": "{item.credits:number}",
          "count": false,
          "empty": "—"
        }
      ]
    },
    {
      "id": "ai.staffOrg",
      "title": "AI",
      "label": "AI",
      "subtitle": "Add-on, pool, overage and per-person use",
      "icon": "sparkles|auto_awesome",
      "scope": "staff",
      "requires": "staff.is",
      "zones": [
        "staffOrg"
      ],
      "order": 10,
      "load": {
        "ai": "/api/ai/admin/org?orgId={params.orgId}"
      },
      "blocks": [
        {
          "type": "fields",
          "object": "data.ai",
          "rows": [
            {
              "label": "Month",
              "value": "{item.month}"
            },
            {
              "label": "Add-on",
              "value": "{item.addon.active:yesno}"
            },
            {
              "label": "Pool",
              "value": "{item.pool.usedCredits:number} of {item.pool.totalCredits|item.pool.credits:number}"
            },
            {
              "label": "Overage",
              "value": "{item.overage.credits:number} credits"
            },
            {
              "label": "Refused this month",
              "value": "{item.refusals.count|item.refusals.total:number}"
            }
          ]
        },
        {
          "type": "list",
          "title": "People",
          "items": "data.ai.users",
          "primary": "{item.email|item.name|item.uid}",
          "trailing": "{item.usedCredits|item.credits:number}",
          "open": {
            "screen": "ai.staffUser",
            "params": {
              "uid": "{item.uid}"
            }
          },
          "empty": "No AI use."
        },
        {
          "type": "actions",
          "items": [
            {
              "id": "give",
              "label": "Give credits back",
              "icon": "gift|card_giftcard",
              "url": "/api/ai/admin/credits",
              "prompt": [
                {
                  "key": "credits",
                  "label": "Credits",
                  "kind": "number",
                  "required": true
                },
                {
                  "key": "meter",
                  "label": "From",
                  "kind": "select",
                  "initial": "workspace",
                  "options": [
                    {
                      "value": "workspace",
                      "label": "The workspace's credits"
                    },
                    {
                      "value": "account",
                      "label": "A person's own allowance"
                    },
                    {
                      "value": "both",
                      "label": "Both"
                    }
                  ]
                },
                {
                  "key": "uid",
                  "label": "Person's account ID",
                  "kind": "text",
                  "when": "form.meter == account,both"
                }
              ],
              "reason": true,
              "body": {
                "action": "give",
                "orgId": "{params.orgId}",
                "credits": "{form.credits}",
                "meter": "{form.meter}",
                "uid": "{form.uid}",
                "reason": "{form.reason}"
              },
              "success": "Gave {form.credits} credits back"
            }
          ]
        }
      ]
    },
    {
      "id": "ai.staffUser",
      "title": "AI",
      "label": "AI",
      "subtitle": "This person's AI use",
      "icon": "sparkles|auto_awesome",
      "scope": "staff",
      "requires": "staff.is",
      "zones": [
        "staffUser"
      ],
      "order": 10,
      "load": {
        "ai": "/api/ai/admin/user?uid={params.uid}"
      },
      "blocks": [
        {
          "type": "fields",
          "object": "data.ai",
          "rows": [
            {
              "label": "Month",
              "value": "{item.month}"
            },
            {
              "label": "Credits used",
              "value": "{item.usedCredits:number}"
            }
          ]
        },
        {
          "type": "list",
          "title": "By workspace",
          "items": "data.ai.orgs",
          "primary": "{item.orgName|item.orgId}",
          "trailing": "{item.usedCredits:number}",
          "count": false,
          "empty": "—"
        }
      ]
    },
    {
      "id": "ai.signals",
      "title": "Assist signal",
      "subtitle": "Docs gaps, AI cost and free-plan spend",
      "icon": "waveform|insights",
      "scope": "staff",
      "requires": "staff.is",
      "zones": [
        "staffPage"
      ],
      "order": 20,
      "links": [
        "/admin/assist-signals"
      ],
      "load": {
        "signals": "/api/ai/admin/signals?limit=25"
      },
      "blocks": [
        {
          "type": "fields",
          "title": "This month",
          "object": "data.signals",
          "rows": [
            {
              "label": "Spend",
              "value": "{item.spend.totalUsd|item.spend.usd:dollars}"
            },
            {
              "label": "Free-plan spend",
              "value": "{item.freeSpend.totalUsd|item.freeSpend.usd:dollars}"
            }
          ]
        },
        {
          "type": "list",
          "title": "Workspaces",
          "items": "data.signals.orgs",
          "primary": "{item.orgLabel|item.orgId}",
          "secondary": "{item.requests:number} requests",
          "trailing": "{item.costUsd:dollars}",
          "open": {
            "screen": "core.staff.org",
            "params": {
              "orgId": "{item.orgId}"
            },
            "when": "item.orgId"
          },
          "empty": "No AI use."
        },
        {
          "type": "list",
          "title": "What people asked that the docs did not answer",
          "items": "data.signals.prose",
          "primary": "{item.text|item.prompt}",
          "secondary": "{item.orgLabel} · {item.at|item.createdAt:datetime}",
          "count": false,
          "empty": "Nothing new."
        }
      ]
    }
  ]
}
