{
  "name": "@aglyn/plugins-sms",
  "version": "1.0.0-beta.239",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://aglyn.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/aglyn/aglyn.git",
    "directory": "libs/plugins/sms"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/lib/*.d.ts",
      "default": "./src/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@aglyn/aglyn": "1.0.0-beta.239",
    "@aglyn/tenant-data-admin": "1.0.0-beta.239",
    "@swc/helpers": "0.5.23"
  },
  "sideEffects": false,
  "description": "Text messages for Aglyn sites: a provider-generic SMS service behind core's core.messaging.sms contract, with a Twilio adapter, phone suppression, STOP handling and at-cost metering."
}
