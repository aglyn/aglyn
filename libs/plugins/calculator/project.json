{
  "name": "plugins-calculator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plugins/calculator/src",
  "projectType": "library",
  "tags": [
    "aglyn:addons",
    "scope:plugin",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/plugins/calculator",
        "main": "libs/plugins/calculator/src/index.ts",
        "tsConfig": "libs/plugins/calculator/tsconfig.lib.json",
        "assets": [
          "libs/plugins/calculator/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/plugins/calculator"
      ],
      "options": {
        "jestConfig": "libs/plugins/calculator/jest.config.ts"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/marketplace/calculator"
      ],
      "options": {
        "command": "rollup -c libs/plugins/calculator/rollup.config.mjs && cp libs/plugins/calculator/manifest.json dist/marketplace/calculator/manifest.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
