{
  "$comment": "The workspace's Domains page natively (the domains plugin's orgNavItems /domains, AGL-4040; gap sweep Domains row 9, piece 1): every domain the workspace holds, with its site, status, renewal and price at renewal, and a page per name. Route: /api/registrar/workspace (DOMAINS_API_ROUTES.workspace); site names from the person's users/{uid}/hostMemberships rows. The registrant contact (view, Edit contact: /api/registrar/contact, Domains row 2) and Connect to a site, Move to another site and Disconnect (/api/registrar/connect and /disconnect, Domains row 3) and the Auto-renew switch (/api/registrar/auto-renew, part of Domains row 7) are here; buying, renewing now, transfers in and out, and DNS records are later pieces (Domains rows 1-8).",
  "screens": [
    {
      "id": "domains.list",
      "title": "Domains",
      "label": "Domains",
      "subtitle": "Every domain your workspace holds",
      "icon": "network|dns",
      "scope": "org",
      "links": [
        "/domains"
      ],
      "load": {
        "ws": "/api/registrar/workspace?orgId={org.id}",
        "sites": {
          "query": {
            "collection": "users/{user.uid}/hostMemberships",
            "where": [
              [
                "orgId",
                "==",
                "{org.id}"
              ]
            ],
            "limit": 200
          },
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "notice",
          "id": "intro",
          "tone": "info",
          "text": "Every domain your workspace holds here. Open one to connect it to a site, manage its renewal, its registrant contact and its DNS records, or move it to another registrar."
        },
        {
          "type": "notice",
          "id": "plan",
          "tone": "warning",
          "when": "data.ws && !data.ws.entitled",
          "text": "Buying and connecting domains is included from the Starter plan. Domains you already hold stay yours and keep renewing."
        },
        {
          "type": "notice",
          "id": "refusal",
          "tone": "warning",
          "when": "data.ws.entitled && data.ws.refusal",
          "text": "{data.ws.refusal.message}"
        },
        {
          "type": "list",
          "id": "domains",
          "title": "Domains",
          "items": "data.ws.rows",
          "empty": "No domains yet",
          "icon": "network|dns",
          "primary": "{item.domain}",
          "secondary": [
            {
              "when": "item.connected",
              "text": "{data.sites.items[$id=item.hostId].displayName|'A site'}"
            },
            {
              "when": "!item.connected",
              "text": "Not connected"
            },
            {
              "when": "item.expiresAtMs && item.status == active && item.autoRenew",
              "text": "Renews {item.expiresAtMs:date}"
            },
            {
              "when": "item.expiresAtMs && item.status == active && !item.autoRenew",
              "text": "Expires {item.expiresAtMs:date}"
            },
            {
              "when": "item.expiresAtMs && item.status != active",
              "text": "Expires {item.expiresAtMs:date}"
            }
          ],
          "tertiary": [
            {
              "when": "item.renewalCents",
              "text": "{item.renewalCents:cents} a year"
            }
          ],
          "badges": [
            {
              "when": "item.status == charging && item.origin == transfer-in || item.status == registering && item.origin == transfer-in",
              "text": "Starting transfer",
              "tone": "info"
            },
            {
              "when": "item.status == charging && item.origin != transfer-in || item.status == registering && item.origin != transfer-in",
              "text": "Registering",
              "tone": "info"
            },
            {
              "when": "item.status == transferring-in",
              "text": "Moving here",
              "tone": "info"
            },
            {
              "when": "item.status == connecting",
              "text": "Connecting",
              "tone": "info"
            },
            {
              "when": "item.status == expired",
              "text": "Expired",
              "tone": "error"
            },
            {
              "when": "item.status == transferred-out",
              "text": "Moved away",
              "tone": "neutral"
            },
            {
              "when": "item.status == refunded || item.status == declined",
              "text": "Not completed",
              "tone": "neutral"
            },
            {
              "when": "item.status == active && item.renewalFailing",
              "text": "Renewal failing",
              "tone": "error"
            },
            {
              "when": "item.status == active && !item.renewalFailing && item.verifyByMs",
              "text": "Confirm email",
              "tone": "warning"
            },
            {
              "when": "item.status == active && !item.renewalFailing && !item.verifyByMs",
              "text": "Active",
              "tone": "success"
            }
          ],
          "open": {
            "screen": "domains.domain",
            "params": {
              "domain": "{item.domain}"
            }
          }
        }
      ]
    },
    {
      "id": "domains.domain",
      "title": "{params.domain}",
      "label": "Domain",
      "icon": "network|dns",
      "scope": "org",
      "links": [
        "/domains/:domain"
      ],
      "load": {
        "ws": "/api/registrar/workspace?orgId={org.id}",
        "sites": {
          "query": {
            "collection": "users/{user.uid}/hostMemberships",
            "where": [
              [
                "orgId",
                "==",
                "{org.id}"
              ]
            ],
            "limit": 200
          },
          "optional": true
        },
        "contact": {
          "url": "/api/registrar/contact?orgId={org.id}&domain={params.domain}",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "notice",
          "id": "missing",
          "tone": "info",
          "when": "data.ws && !data.ws.rows[domain=params.domain]",
          "text": "That domain isn’t in this workspace."
        },
        {
          "type": "fields",
          "id": "facts",
          "object": "data.ws.rows[domain=params.domain]",
          "when": "data.ws.rows[domain=params.domain]",
          "rows": [
            {
              "label": "Site",
              "value": "{data.sites.items[$id=item.hostId].displayName|'A site'}",
              "when": "item.connected"
            },
            {
              "label": "Site",
              "value": "Not connected",
              "when": "!item.connected"
            },
            {
              "label": "Status",
              "value": "Starting transfer",
              "chip": true,
              "tones": {
                "Starting transfer": "info"
              },
              "when": "item.status == charging && item.origin == transfer-in || item.status == registering && item.origin == transfer-in"
            },
            {
              "label": "Status",
              "value": "Registering",
              "chip": true,
              "tones": {
                "Registering": "info"
              },
              "when": "item.status == charging && item.origin != transfer-in || item.status == registering && item.origin != transfer-in"
            },
            {
              "label": "Status",
              "value": "Moving here",
              "chip": true,
              "tones": {
                "Moving here": "info"
              },
              "when": "item.status == transferring-in"
            },
            {
              "label": "Status",
              "value": "Connecting",
              "chip": true,
              "tones": {
                "Connecting": "info"
              },
              "when": "item.status == connecting"
            },
            {
              "label": "Status",
              "value": "Expired",
              "chip": true,
              "tones": {
                "Expired": "error"
              },
              "when": "item.status == expired"
            },
            {
              "label": "Status",
              "value": "Moved away",
              "chip": true,
              "tones": {
                "Moved away": "neutral"
              },
              "when": "item.status == transferred-out"
            },
            {
              "label": "Status",
              "value": "Not completed",
              "chip": true,
              "tones": {
                "Not completed": "neutral"
              },
              "when": "item.status == refunded || item.status == declined"
            },
            {
              "label": "Status",
              "value": "Renewal failing",
              "chip": true,
              "tones": {
                "Renewal failing": "error"
              },
              "when": "item.status == active && item.renewalFailing"
            },
            {
              "label": "Status",
              "value": "Confirm email",
              "chip": true,
              "tones": {
                "Confirm email": "warning"
              },
              "when": "item.status == active && !item.renewalFailing && item.verifyByMs"
            },
            {
              "label": "Status",
              "value": "Active",
              "chip": true,
              "tones": {
                "Active": "success"
              },
              "when": "item.status == active && !item.renewalFailing && !item.verifyByMs"
            },
            {
              "label": "Renews",
              "value": "{item.expiresAtMs:date}",
              "when": "item.expiresAtMs && item.status == active && item.autoRenew"
            },
            {
              "label": "Expires",
              "value": "{item.expiresAtMs:date}",
              "when": "item.expiresAtMs && item.status != active || item.expiresAtMs && !item.autoRenew"
            },
            {
              "label": "Auto-renew",
              "value": "On",
              "when": "item.status == active && item.autoRenew"
            },
            {
              "label": "Auto-renew",
              "value": "Off",
              "when": "item.status == active && !item.autoRenew"
            },
            {
              "label": "Price at renewal",
              "value": "{item.renewalCents:cents} a year",
              "when": "item.renewalCents"
            },
            {
              "label": "Registered",
              "value": "{item.registeredAtMs:date}",
              "when": "item.registeredAtMs"
            },
            {
              "label": "Registrant",
              "value": "{item.registrantName}",
              "when": "item.registrantName"
            },
            {
              "label": "Registrant email",
              "value": "{item.registrantEmail}",
              "when": "item.registrantEmail"
            }
          ]
        },
        {
          "type": "notice",
          "id": "expired",
          "tone": "error",
          "when": "data.ws.rows[domain=params.domain].status == expired",
          "text": "It expired and the site is back on its free address. For a short while after expiring, a domain can usually still be renewed."
        },
        {
          "type": "notice",
          "id": "transferredOut",
          "tone": "info",
          "when": "data.ws.rows[domain=params.domain].status == transferred-out",
          "text": "It now belongs to another registrar, where you manage and renew it."
        },
        {
          "type": "list",
          "id": "autoRenew",
          "when": "data.ws.rows[domain=params.domain].status == active",
          "items": "const.autoRenew",
          "count": false,
          "primary": "{item.label}",
          "icon": "arrow.clockwise|autorenew",
          "toggle": {
            "value": "{data.ws.rows[domain=params.domain].autoRenew}",
            "disabled": "!data.ws.billingPermission",
            "label": "Auto-renew",
            "on": {
              "id": "on",
              "label": "Turn on",
              "url": "/api/registrar/auto-renew",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}",
                "autoRenew": true
              },
              "success": "Auto-renew is on",
              "reload": true
            },
            "off": {
              "id": "off",
              "label": "Turn off",
              "url": "/api/registrar/auto-renew",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}",
                "autoRenew": false
              },
              "success": "Auto-renew is off",
              "reload": true
            }
          }
        },
        {
          "type": "actions",
          "id": "connect",
          "when": "data.ws.rows[domain=params.domain].status == active",
          "items": [
            {
              "id": "connect",
              "label": "Connect to a site",
              "icon": "link|link",
              "when": "!data.ws.rows[domain=params.domain].connected",
              "prompt": [
                {
                  "key": "siteId",
                  "label": "Site",
                  "kind": "select",
                  "required": true,
                  "options": [],
                  "optionsFrom": {
                    "items": "data.sites.items",
                    "value": "{item.$id}",
                    "label": "{item.displayName|'A site'}"
                  },
                  "help": "{params.domain} will serve the site you pick, with its security certificate set up for you. It usually takes a few minutes. If that site uses another domain now, this one replaces it: the other stops serving the site and stays registered wherever it is registered now."
                }
              ],
              "url": "/api/registrar/connect",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}",
                "siteId": "{form.siteId}"
              },
              "success": "{params.domain} is connecting to {data.sites.items[$id=form.siteId].displayName|'the site'}",
              "reload": true
            },
            {
              "id": "move",
              "label": "Move to another site",
              "icon": "arrow.right.arrow.left|swap_horiz",
              "when": "data.ws.rows[domain=params.domain].connected",
              "prompt": [
                {
                  "key": "siteId",
                  "label": "Site",
                  "kind": "select",
                  "required": true,
                  "options": [],
                  "optionsFrom": {
                    "items": "data.sites.items[?item.$id != @data.ws.rows[domain=params.domain].hostId]",
                    "value": "{item.$id}",
                    "label": "{item.displayName|'A site'}"
                  },
                  "help": "{params.domain} stops serving the site it is connected to now. If the site you pick uses another domain now, this one replaces it: the other stops serving that site and stays registered wherever it is registered now."
                }
              ],
              "url": "/api/registrar/connect",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}",
                "siteId": "{form.siteId}"
              },
              "success": "{params.domain} is connecting to {data.sites.items[$id=form.siteId].displayName|'the site'}",
              "reload": true
            },
            {
              "id": "disconnect",
              "label": "Disconnect",
              "icon": "link.badge.minus|link_off",
              "destructive": true,
              "when": "data.ws.rows[domain=params.domain].connected",
              "confirm": "Disconnect {params.domain}?",
              "url": "/api/registrar/disconnect",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}"
              },
              "success": "{params.domain} is disconnected",
              "reload": true,
              "confirmMessage": "{data.sites.items[$id=data.ws.rows[domain=params.domain].hostId].displayName|'The site'} goes back to its free address. {params.domain} stays in your workspace, registered to you, and can be connected again at any time.",
              "confirmLabel": "Disconnect"
            }
          ]
        },
        {
          "type": "fields",
          "id": "contact",
          "title": "Registrant contact",
          "when": "data.contact && data.ws.rows[domain=params.domain].status == active || data.contact && data.ws.rows[domain=params.domain].status == expired",
          "object": "data.contact.contact",
          "rows": [
            {
              "label": "Name",
              "value": "{item.firstName} {item.lastName}",
              "when": "item.firstName || item.lastName"
            },
            {
              "label": "Business",
              "value": "{item.companyName}",
              "when": "item.companyName"
            },
            {
              "label": "Email",
              "value": "{item.email}",
              "when": "item.email"
            },
            {
              "label": "Phone",
              "value": "{item.phone}",
              "when": "item.phone"
            },
            {
              "label": "Street address",
              "value": "{item.address1}",
              "when": "item.address1"
            },
            {
              "label": "City",
              "value": "{item.city}",
              "when": "item.city"
            },
            {
              "label": "State or region",
              "value": "{item.state}",
              "when": "item.state"
            },
            {
              "label": "Postal code",
              "value": "{item.zip}",
              "when": "item.zip"
            },
            {
              "label": "Country",
              "value": "{item.country}",
              "when": "item.country"
            },
            {
              "label": "ICANN",
              "value": "Email confirmed with ICANN",
              "chip": true,
              "tones": {
                "Email confirmed with ICANN": "success"
              },
              "when": "data.contact.verification.verified"
            },
            {
              "label": "ICANN",
              "value": "Email not confirmed yet",
              "chip": true,
              "tones": {
                "Email not confirmed yet": "warning"
              },
              "when": "data.contact.verification && !data.contact.verification.verified"
            }
          ]
        },
        {
          "type": "notice",
          "id": "contactVerify",
          "tone": "warning",
          "when": "data.contact.verification && !data.contact.verification.verified && data.contact.verification.verifyByMs",
          "text": "ICANN requires the registrant email to be confirmed by {data.contact.verification.verifyByMs:date}. Open the registrar’s email sent to {data.contact.verification.email|data.contact.contact.email|'the registrant'} and follow its link."
        },
        {
          "type": "notice",
          "id": "contactVerifyUndated",
          "tone": "warning",
          "when": "data.contact.verification && !data.contact.verification.verified && !data.contact.verification.verifyByMs",
          "text": "ICANN requires the registrant email to be confirmed. Open the registrar’s email sent to {data.contact.verification.email|data.contact.contact.email|'the registrant'} and follow its link."
        },
        {
          "type": "notice",
          "id": "contactRejected",
          "tone": "error",
          "when": "data.contact.rejectedAtMs",
          "text": "The registrar didn’t accept the last contact change, so it still has the earlier details. Check them and save again."
        },
        {
          "type": "notice",
          "id": "contactPendingDated",
          "tone": "info",
          "when": "!data.contact.rejectedAtMs && data.contact.pendingSinceMs && data.contact.takesEffectAtMs",
          "text": "Changed on {data.contact.pendingSinceMs:date}. Changes are sent to the registrar with the domain’s next renewal, around {data.contact.takesEffectAtMs:date}. Until then the registrar keeps the current details."
        },
        {
          "type": "notice",
          "id": "contactPendingAutoRenewOff",
          "tone": "info",
          "when": "!data.contact.rejectedAtMs && data.contact.pendingSinceMs && !data.contact.takesEffectAtMs && !data.contact.autoRenew && data.contact.expiresAtMs",
          "text": "Changed on {data.contact.pendingSinceMs:date}. Changes are sent to the registrar when the domain is next renewed. Auto-renew is off, so that happens only if you renew it before {data.contact.expiresAtMs:date}."
        },
        {
          "type": "notice",
          "id": "contactPending",
          "tone": "info",
          "when": "!data.contact.rejectedAtMs && data.contact.pendingSinceMs && !data.contact.takesEffectAtMs && data.contact.autoRenew || !data.contact.rejectedAtMs && data.contact.pendingSinceMs && !data.contact.takesEffectAtMs && !data.contact.expiresAtMs",
          "text": "Changed on {data.contact.pendingSinceMs:date}. Changes are sent to the registrar when the domain is next renewed."
        },
        {
          "type": "actions",
          "id": "contactEdit",
          "when": "data.contact && data.ws.rows[domain=params.domain].status == active",
          "items": [
            {
              "id": "editContact",
              "label": "Edit contact",
              "icon": "person.text.rectangle|contact_mail",
              "promptTitle": "Registrant contact for {params.domain}",
              "submitLabel": "Save for the next renewal",
              "prompt": [
                {
                  "key": "firstName",
                  "label": "First name",
                  "kind": "text",
                  "initial": "{data.contact.contact.firstName}",
                  "required": true
                },
                {
                  "key": "lastName",
                  "label": "Last name",
                  "kind": "text",
                  "initial": "{data.contact.contact.lastName}",
                  "required": true
                },
                {
                  "key": "companyName",
                  "label": "Business name (optional)",
                  "kind": "text",
                  "initial": "{data.contact.contact.companyName}"
                },
                {
                  "key": "email",
                  "label": "Email",
                  "kind": "email",
                  "initial": "{data.contact.contact.email}",
                  "required": true
                },
                {
                  "key": "phone",
                  "label": "Phone",
                  "kind": "text",
                  "initial": "{data.contact.contact.phone}",
                  "required": true
                },
                {
                  "key": "address1",
                  "label": "Street address",
                  "kind": "text",
                  "initial": "{data.contact.contact.address1}",
                  "required": true
                },
                {
                  "key": "address2",
                  "label": "Apartment, suite (optional)",
                  "kind": "text",
                  "initial": "{data.contact.contact.address2}"
                },
                {
                  "key": "city",
                  "label": "City",
                  "kind": "text",
                  "initial": "{data.contact.contact.city}",
                  "required": true
                },
                {
                  "key": "state",
                  "label": "State or region",
                  "kind": "text",
                  "initial": "{data.contact.contact.state}",
                  "required": true
                },
                {
                  "key": "zip",
                  "label": "Postal code",
                  "kind": "text",
                  "initial": "{data.contact.contact.zip}",
                  "required": true
                },
                {
                  "key": "country",
                  "label": "Country or region",
                  "kind": "country",
                  "initial": "{data.contact.contact.country|'US'}",
                  "required": true
                }
              ],
              "url": "/api/registrar/contact",
              "body": {
                "orgId": "{org.id}",
                "domain": "{params.domain}",
                "contact": {
                  "firstName": "{form.firstName}",
                  "lastName": "{form.lastName}",
                  "companyName": "{form.companyName}",
                  "email": "{form.email}",
                  "phone": "{form.phone}",
                  "address1": "{form.address1}",
                  "address2": "{form.address2}",
                  "city": "{form.city}",
                  "state": "{form.state}",
                  "zip": "{form.zip}",
                  "country": "{form.country}"
                }
              },
              "success": "Saved. It goes to the registrar with the next renewal.",
              "reload": true
            }
          ]
        }
      ],
      "constants": {
        "autoRenew": [
          {
            "label": "Auto-renew"
          }
        ]
      }
    }
  ]
}
