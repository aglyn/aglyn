      "default": "./src/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@aglyn/aglyn": "1.0.0-beta.241",
    "@aglyn/shared-data-mdi": "1.0.0-beta.241",
