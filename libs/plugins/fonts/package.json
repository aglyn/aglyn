    "@aglyn/shared-ui-jsx": "1.0.0-beta.241",
    "@aglyn/shared-ui-theme": "1.0.0-beta.241",
    "@aglyn/shared-util-http": "1.0.0-beta.241",
    "@aglyn/tenant-data-admin": "1.0.0-beta.241",
    "@aglyn/tenant-feature-instance": "1.0.0-beta.241",
    "@aglyn/tenant-runtime": "1.0.0-beta.241",
    "@mdi/js": "^7.4.47",
    "@swc/helpers": "0.5.23",
    "fontverter": "^2.0.0",
    "subset-font": "^2.9.0"
  },
  "peerDependencies": {
    "@mui/material": "^9.3.1",
    "firebase": "^12.18.0",
    "react": "^19.2.8"
