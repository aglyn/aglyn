{
  "$comment": "The Commerce plugin's hub screens, drawn by the shared spec renderer: Store (every area the console's Commerce page has), Promotions, and Commerce settings, the store's settings hub, with the commerceSettings zone other plugins put their cards in (tax services, shipping labels, fulfillment networks and the rest, each its own spec in its own plugin). Grammar: docs/mobile/native-architecture.md section 13.",
  "screens": [
    {
      "id": "commerce.manage",
      "title": "Store",
      "label": "Store",
      "subtitle": "Catalog, orders, promotions, settings and reports",
      "icon": "storefront|storefront",
      "scope": "site",
      "group": "site",
      "order": 39,
      "blocks": [
        {
          "type": "links",
          "id": "catalog",
          "title": "Catalog",
          "items": [
            {
              "title": "Products",
              "icon": "inventory_2|inventory_2",
              "screen": "commerce.products",
              "subtitle": "Add, edit and count stock"
            },
            {
              "title": "Categories",
              "icon": "category|category",
              "screen": "commerce.categories",
              "subtitle": "Group products"
            },
            {
              "title": "Collections",
              "icon": "view_agenda|view_agenda",
              "screen": "commerce.collections",
              "subtitle": "Hand-picked and smart collections"
            },
            {
              "title": "Stock movements",
              "icon": "swap_horiz|swap_horiz",
              "screen": "commerce.stockMovements",
