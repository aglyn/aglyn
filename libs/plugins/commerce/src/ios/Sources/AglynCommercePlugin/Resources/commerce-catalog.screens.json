{
  "$comment": "The Commerce plugin's catalog organization, natively: the category tree (add, rename, move, delete with its children moved up) written to the store's productCategories as the console writes them, and manual and smart collections through the console's /api/hosts/collections route (name and mode, the products a manual one holds, the rules a smart one matches, delete) with the membership refreshed afterwards. Grammar: docs/mobile/native-architecture.md section 13.",
  "screens": [
    {
      "id": "commerce.categories",
      "title": "Categories",
      "label": "Categories",
      "subtitle": "Group products into a browsable tree",
      "icon": "folder|category",
      "scope": "site",
      "order": 47,
      "load": {
        "categories": {
          "query": {
            "collection": "hosts/{site.id}/productCategories",
            "limit": 250,
            "orderBy": "name asc"
          }
        }
      },
      "constants": {
        "fields": [
          {
            "id": "tag",
            "label": "Tag"
          },
          {
            "id": "categoryId",
            "label": "Category"
          },
          {
            "id": "priceUsd",
            "label": "Price"
          },
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "type",
            "label": "Type"
          }
        ],
        "ops": [
          {
            "id": "eq",
            "label": "is"
          },
          {
            "id": "neq",
            "label": "is not"
          },
          {
            "id": "lt",
            "label": "below"
          },
          {
            "id": "gt",
            "label": "above"
          },
          {
            "id": "contains",
            "label": "contains"
          }
        ],
        "modes": [
          {
            "id": "manual",
            "label": "Manual"
          },
          {
            "id": "smart",
            "label": "Smart"
          }
        ]
      },
      "blocks": [
        {
          "type": "list",
          "id": "categories",
          "title": "Categories",
          "items": "data.categories.items",
          "primary": "{item.name}",
          "secondary": "/{item.slug}",
          "icon": "folder|category",
          "badges": [
            {
              "text": "In {data.categories.items[$id=item.parentId].name}",
              "tone": "neutral",
              "when": "item.parentId"
            }
          ],
          "empty": "Group products into a browsable tree (e.g. Brakes → Pads).",
          "actions": [
            {
              "id": "edit",
              "label": "Edit",
              "icon": "pencil|edit",
              "prompt": [
                {
                  "key": "name",
                  "label": "Name",
                  "kind": "text",
                  "required": true,
                  "initial": "{item.name}"
                },
                {
                  "key": "parentId",
                  "label": "Inside",
                  "kind": "select",
                  "initial": "{item.parentId}",
                  "options": [
                    {
                      "value": "",
                      "label": "Top level"
                    }
                  ],
                  "optionsFrom": {
                    "items": "data.categories.items",
                    "where": "item.$id != @parent.$id",
                    "value": "{item.$id}",
                    "label": "{item.name}"
                  }
                }
              ],
              "write": {
                "doc": "hosts/{site.id}/productCategories/{item.$id}",
                "fields": {
                  "name": "{form.name}",
                  "slug": {
                    "$slug": "{form.name}"
                  },
                  "parentId": {
                    "$orNull": "{form.parentId}"
                  },
                  "updatedAt": {
                    "$timestamp": true
                  }
                }
              },
              "success": "Category saved"
            },
            {
              "id": "delete",
              "label": "Delete",
              "icon": "trash|delete",
              "destructive": true,
              "confirm": "Delete {item.name}? Products keep their other categories; its children move to the top level.",
              "write": {
                "steps": [
                  {
                    "each": {
                      "items": "data.categories.items",
                      "filter": "item.parentId == @parent.$id"
                    },
                    "doc": "hosts/{site.id}/productCategories/{item.$id}",
                    "fields": {
                      "parentId": {
                        "$orNull": ""
                      }
                    }
                  },
                  {
                    "delete": "hosts/{site.id}/productCategories/{item.$id}"
                  }
                ]
              },
              "success": "Category deleted"
            }
          ]
        },
        {
          "type": "actions",
          "id": "add",
          "items": [
            {
              "id": "addCategory",
              "label": "Add a category",
              "icon": "plus|add",
              "prompt": [
                {
                  "key": "name",
                  "label": "Name",
                  "kind": "text",
                  "required": true
                },
                {
                  "key": "parentId",
                  "label": "Inside",
                  "kind": "select",
                  "options": [
                    {
                      "value": "",
                      "label": "Top level"
                    }
                  ],
                  "optionsFrom": {
                    "items": "data.categories.items",
                    "value": "{item.$id}",
                    "label": "{item.name}"
                  }
                }
              ],
              "write": {
                "add": "hosts/{site.id}/productCategories",
                "fields": {
                  "name": "{form.name}",
                  "slug": {
                    "$slug": "{form.name}"
                  },
                  "parentId": {
                    "$orNull": "{form.parentId}"
                  },
                  "order": 0,
                  "createdAt": {
                    "$timestamp": true
                  },
                  "updatedAt": {
                    "$timestamp": true
                  }
                }
              },
              "success": "Category saved"
            }
          ]
        }
      ]
    },
    {
      "id": "commerce.collections",
      "title": "Collections",
      "label": "Collections",
      "subtitle": "Manual and smart groups of products",
      "icon": "square.stack.3d.up|category",
      "scope": "site",
      "order": 48,
      "load": {
        "collections": {
          "query": {
            "collection": "hosts/{site.id}/collections",
            "limit": 250
          }
        }
      },
      "constants": {
        "fields": [
          {
            "id": "tag",
            "label": "Tag"
          },
          {
            "id": "categoryId",
            "label": "Category"
          },
          {
            "id": "priceUsd",
            "label": "Price"
          },
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "type",
            "label": "Type"
          }
        ],
        "ops": [
          {
            "id": "eq",
            "label": "is"
          },
          {
            "id": "neq",
            "label": "is not"
          },
          {
            "id": "lt",
            "label": "below"
          },
          {
            "id": "gt",
            "label": "above"
          },
          {
            "id": "contains",
            "label": "contains"
          }
        ],
        "modes": [
          {
            "id": "manual",
            "label": "Manual"
          },
          {
            "id": "smart",
            "label": "Smart"
          }
        ]
      },
      "blocks": [
        {
          "type": "list",
          "id": "collections",
          "title": "Collections",
          "items": "data.collections.items",
          "filter": "item.mode",
          "primary": "{item.name}",
          "secondary": "/collections/{item.slug}",
          "icon": "square.stack.3d.up|category",
          "badges": [
            {
              "text": "{const.modes[id=item.mode].label}",
              "tone": "info"
            },
            {
              "text": "{item.productIds.length} products",
              "tone": "neutral",
              "when": "item.mode == manual"
            },
            {
              "text": "{item.rules.length} rules",
              "tone": "neutral",
              "when": "item.mode == smart"
            }
          ],
          "empty": "No collections yet. A collection groups products on the storefront at /collections/<address>.",
          "open": {
            "screen": "commerce.collection",
            "params": {
              "collectionId": "{item.$id}"
            }
          }
        },
        {
          "type": "actions",
          "id": "add",
          "items": [
            {
              "id": "addCollection",
              "label": "New collection",
              "icon": "plus|add",
              "url": "/api/hosts/collections",
              "prompt": [
                {
                  "key": "name",
                  "label": "Name",
                  "kind": "text",
                  "required": true,
                  "help": "Its address is /collections/ and the name in lower case."
                },
                {
                  "key": "mode",
                  "label": "Mode",
                  "kind": "select",
                  "initial": "manual",
                  "options": [
                    {
                      "value": "manual",
                      "label": "Manual: pick products"
                    },
                    {
                      "value": "smart",
                      "label": "Smart: rule based"
                    }
                  ]
                }
              ],
              "body": {
                "hostId": "{site.id}",
                "action": "create",
                "kind": "catalog",
                "data": {
                  "name": "{form.name}",
                  "slug": {
                    "$slug": "{form.name}"
                  },
                  "mode": "{form.mode}"
                }
              },
              "navigate": {
                "screen": "commerce.collection",
                "params": {
                  "collectionId": "{response.id}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{response.id}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Collection saved"
            }
          ]
        }
      ]
    },
    {
      "id": "commerce.collection",
      "title": "{data.col.name|'Collection'}",
      "label": "Collection",
      "icon": "square.stack.3d.up|category",
      "scope": "site",
      "load": {
        "col": {
          "doc": "hosts/{site.id}/collections/{params.collectionId}"
        }
      },
      "constants": {
        "fields": [
          {
            "id": "tag",
            "label": "Tag"
          },
          {
            "id": "categoryId",
            "label": "Category"
          },
          {
            "id": "priceUsd",
            "label": "Price"
          },
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "type",
            "label": "Type"
          }
        ],
        "ops": [
          {
            "id": "eq",
            "label": "is"
          },
          {
            "id": "neq",
            "label": "is not"
          },
          {
            "id": "lt",
            "label": "below"
          },
          {
            "id": "gt",
            "label": "above"
          },
          {
            "id": "contains",
            "label": "contains"
          }
        ],
        "modes": [
          {
            "id": "manual",
            "label": "Manual"
          },
          {
            "id": "smart",
            "label": "Smart"
          }
        ]
      },
      "blocks": [
        {
          "type": "fields",
          "id": "summary",
          "title": "Collection",
          "rows": [
            {
              "label": "Address",
              "value": "/collections/{data.col.slug}"
            },
            {
              "label": "Mode",
              "value": "{const.modes[id=data.col.mode].label}"
            },
            {
              "label": "Products",
              "value": "{data.col.productIds.length}",
              "when": "data.col.mode == manual"
            },
            {
              "label": "Rules",
              "value": "Every rule must match",
              "when": "data.col.mode == smart && data.col.matchAll != false"
            },
            {
              "label": "Rules",
              "value": "Any rule may match",
              "when": "data.col.mode == smart && data.col.matchAll == false"
            }
          ]
        },
        {
          "type": "links",
          "id": "parts",
          "items": [
            {
              "title": "Products",
              "subtitle": "Pick the products this collection holds",
              "icon": "shippingbox|inventory_2",
              "screen": "commerce.collectionProducts",
              "params": {
                "collectionId": "{params.collectionId}"
              },
              "when": "data.col.mode == manual"
            },
            {
              "title": "Rules",
              "subtitle": "The conditions a product must meet",
              "icon": "slider.horizontal.3|tune",
              "screen": "commerce.collectionRules",
              "params": {
                "collectionId": "{params.collectionId}"
              },
              "when": "data.col.mode == smart"
            }
          ]
        },
        {
          "type": "form",
          "id": "edit",
          "title": "Name and mode",
          "fields": [
            {
              "key": "name",
              "label": "Name",
              "kind": "text",
              "required": true,
              "initial": "{data.col.name}"
            },
            {
              "key": "mode",
              "label": "Mode",
              "kind": "select",
              "initial": "{data.col.mode}",
              "options": [
                {
                  "value": "manual",
                  "label": "Manual: pick products"
                },
                {
                  "value": "smart",
                  "label": "Smart: rule based"
                }
              ]
            }
          ],
          "submit": {
            "label": "Save",
            "url": "/api/hosts/collections",
            "body": {
              "hostId": "{site.id}",
              "action": "update",
              "kind": "catalog",
              "id": "{params.collectionId}",
              "data": {
                "name": "{form.name}",
                "slug": "{data.col.slug}",
                "mode": "{form.mode}",
                "description": "{data.col.description}",
                "productIds": "{data.col.productIds}",
                "rules": "{data.col.rules}",
                "matchAll": "{data.col.matchAll}",
                "imageUrl": "{data.col.imageUrl}",
                "order": "{data.col.order}"
              }
            },
            "then": {
              "label": "Update memberships",
              "url": "/api/commerce/collection-membership",
              "body": {
                "hostId": "{site.id}",
                "collectionId": "{params.collectionId}"
              },
              "loop": {
                "cursor": "after",
                "param": "after",
                "until": "done"
              }
            },
            "success": "Collection saved"
          }
        },
        {
          "type": "actions",
          "id": "manage",
          "items": [
            {
              "id": "delete",
              "label": "Delete collection",
              "icon": "trash|delete",
              "destructive": true,
              "url": "/api/resources/erase",
              "back": true,
              "confirm": "Delete {data.col.name}? Storefront blocks pointing at it go empty. The delete is refused while the collection still has entries, or while a page uses it as a list or entry template. It also takes the site admin role.",
              "body": {
                "scope": "hosts",
                "scopeId": "{site.id}",
                "kind": "collections",
                "id": "{params.collectionId}",
                "collectionKind": "catalog"
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Collection deleted"
            }
          ]
        }
      ]
    },
    {
      "id": "commerce.collectionProducts",
      "title": "Products",
      "label": "Collection products",
      "icon": "shippingbox|inventory_2",
      "scope": "site",
      "load": {
        "col": {
          "doc": "hosts/{site.id}/collections/{params.collectionId}"
        },
        "products": {
          "query": {
            "collection": "hosts/{site.id}/products",
            "limit": 500,
            "orderBy": "name asc"
          }
        }
      },
      "blocks": [
        {
          "type": "notice",
          "id": "hint",
          "tone": "info",
          "text": "Turn on the products this collection holds."
        },
        {
          "type": "list",
          "id": "products",
          "title": "Products",
          "items": "data.products.items",
          "filter": "!item.deletedAt",
          "primary": "{item.name}",
          "secondary": "{item.status:title}",
          "count": false,
          "icon": "shippingbox|inventory_2",
          "toggle": {
            "value": "{data.col.productIds[=item.$id]}",
            "label": "{item.name}",
            "on": {
              "label": "Add",
              "url": "/api/hosts/collections",
              "body": {
                "hostId": "{site.id}",
                "action": "update",
                "kind": "catalog",
                "id": "{params.collectionId}",
                "data": {
                  "name": "{data.col.name}",
                  "slug": "{data.col.slug}",
                  "mode": "{data.col.mode}",
                  "description": "{data.col.description}",
                  "productIds": {
                    "$append": {
                      "list": "{data.col.productIds}",
                      "item": "{item.$id}"
                    }
                  },
                  "rules": "{data.col.rules}",
                  "matchAll": "{data.col.matchAll}",
                  "imageUrl": "{data.col.imageUrl}",
                  "order": "{data.col.order}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Saved"
            },
            "off": {
              "label": "Remove",
              "url": "/api/hosts/collections",
              "body": {
                "hostId": "{site.id}",
                "action": "update",
                "kind": "catalog",
                "id": "{params.collectionId}",
                "data": {
                  "name": "{data.col.name}",
                  "slug": "{data.col.slug}",
                  "mode": "{data.col.mode}",
                  "description": "{data.col.description}",
                  "productIds": {
                    "$without": {
                      "list": "{data.col.productIds}",
                      "item": "{item.$id}"
                    }
                  },
                  "rules": "{data.col.rules}",
                  "matchAll": "{data.col.matchAll}",
                  "imageUrl": "{data.col.imageUrl}",
                  "order": "{data.col.order}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Saved"
            }
          },
          "empty": "No products yet."
        }
      ]
    },
    {
      "id": "commerce.collectionRules",
      "title": "Rules",
      "label": "Collection rules",
      "icon": "slider.horizontal.3|tune",
      "scope": "site",
      "load": {
        "col": {
          "doc": "hosts/{site.id}/collections/{params.collectionId}"
        },
        "categories": {
          "query": {
            "collection": "hosts/{site.id}/productCategories",
            "limit": 250,
            "orderBy": "name asc"
          }
        }
      },
      "constants": {
        "fields": [
          {
            "id": "tag",
            "label": "Tag"
          },
          {
            "id": "categoryId",
            "label": "Category"
          },
          {
            "id": "priceUsd",
            "label": "Price"
          },
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "type",
            "label": "Type"
          }
        ],
        "ops": [
          {
            "id": "eq",
            "label": "is"
          },
          {
            "id": "neq",
            "label": "is not"
          },
          {
            "id": "lt",
            "label": "below"
          },
          {
            "id": "gt",
            "label": "above"
          },
          {
            "id": "contains",
            "label": "contains"
          }
        ],
        "modes": [
          {
            "id": "manual",
            "label": "Manual"
          },
          {
            "id": "smart",
            "label": "Smart"
          }
        ]
      },
      "blocks": [
        {
          "type": "form",
          "id": "match",
          "title": "A product is in when",
          "fields": [
            {
              "key": "matchAll",
              "label": "Every rule must match",
              "kind": "toggle",
              "initial": "{?data.col.matchAll != false}",
              "help": "Off: a product is in when any one rule matches."
            }
          ],
          "submit": {
            "label": "Save",
            "url": "/api/hosts/collections",
            "body": {
              "hostId": "{site.id}",
              "action": "update",
              "kind": "catalog",
              "id": "{params.collectionId}",
              "data": {
                "name": "{data.col.name}",
                "slug": "{data.col.slug}",
                "mode": "{data.col.mode}",
                "description": "{data.col.description}",
                "productIds": "{data.col.productIds}",
                "rules": "{data.col.rules}",
                "matchAll": "{form.matchAll}",
                "imageUrl": "{data.col.imageUrl}",
                "order": "{data.col.order}"
              }
            },
            "then": {
              "label": "Update memberships",
              "url": "/api/commerce/collection-membership",
              "body": {
                "hostId": "{site.id}",
                "collectionId": "{params.collectionId}"
              },
              "loop": {
                "cursor": "after",
                "param": "after",
                "until": "done"
              }
            },
            "success": "Saved"
          }
        },
        {
          "type": "list",
          "id": "rules",
          "title": "Rules",
          "items": "data.col.rules",
          "count": false,
          "icon": "slider.horizontal.3|tune",
          "primary": "{const.fields[id=item.field].label} {const.ops[id=item.op].label} {item.value}",
          "empty": "No rules yet. A smart collection with no rules holds nothing.",
          "actions": [
            {
              "id": "edit",
              "label": "Edit",
              "icon": "pencil|edit",
              "url": "/api/hosts/collections",
              "prompt": [
                {
                  "key": "field",
                  "label": "Match on",
                  "kind": "select",
                  "required": true,
                  "options": [
                    {
                      "value": "tag",
                      "label": "Tag"
                    },
                    {
                      "value": "categoryId",
                      "label": "Category"
                    },
                    {
                      "value": "priceUsd",
                      "label": "Price"
                    },
                    {
                      "value": "name",
                      "label": "Name"
                    },
                    {
                      "value": "type",
                      "label": "Type"
                    }
                  ],
                  "initial": "{item.field}"
                },
                {
                  "key": "op",
                  "label": "Condition",
                  "kind": "select",
                  "required": true,
                  "options": [
                    {
                      "value": "eq",
                      "label": "is"
                    },
                    {
                      "value": "neq",
                      "label": "is not"
                    },
                    {
                      "value": "lt",
                      "label": "below"
                    },
                    {
                      "value": "gt",
                      "label": "above"
                    },
                    {
                      "value": "contains",
                      "label": "contains"
                    }
                  ],
                  "initial": "{item.op}"
                },
                {
                  "key": "valueText",
                  "label": "Value",
                  "kind": "text",
                  "when": "form.field != categoryId",
                  "initial": "{item.value}"
                },
                {
                  "key": "valueCategory",
                  "label": "Category",
                  "kind": "select",
                  "when": "form.field == categoryId",
                  "optionsFrom": {
                    "items": "data.categories.items",
                    "value": "{item.$id}",
                    "label": "{item.name}"
                  }
                }
              ],
              "body": {
                "hostId": "{site.id}",
                "action": "update",
                "kind": "catalog",
                "id": "{params.collectionId}",
                "data": {
                  "name": "{data.col.name}",
                  "slug": "{data.col.slug}",
                  "mode": "{data.col.mode}",
                  "description": "{data.col.description}",
                  "productIds": "{data.col.productIds}",
                  "rules": {
                    "$replace": {
                      "list": "{data.col.rules}",
                      "key": "*",
                      "match": "{item}",
                      "value": {
                        "field": "{form.field}",
                        "op": "{form.op}",
                        "value": "{form.valueText|form.valueCategory}"
                      }
                    }
                  },
                  "matchAll": "{data.col.matchAll}",
                  "imageUrl": "{data.col.imageUrl}",
                  "order": "{data.col.order}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Saved"
            },
            {
              "id": "remove",
              "label": "Remove",
              "icon": "trash|delete",
              "destructive": true,
              "url": "/api/hosts/collections",
              "body": {
                "hostId": "{site.id}",
                "action": "update",
                "kind": "catalog",
                "id": "{params.collectionId}",
                "data": {
                  "name": "{data.col.name}",
                  "slug": "{data.col.slug}",
                  "mode": "{data.col.mode}",
                  "description": "{data.col.description}",
                  "productIds": "{data.col.productIds}",
                  "rules": {
                    "$without": {
                      "list": "{data.col.rules}",
                      "item": "{item}"
                    }
                  },
                  "matchAll": "{data.col.matchAll}",
                  "imageUrl": "{data.col.imageUrl}",
                  "order": "{data.col.order}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Removed"
            }
          ]
        },
        {
          "type": "actions",
          "id": "add",
          "items": [
            {
              "id": "addRule",
              "label": "Add a rule",
              "icon": "plus|add",
              "url": "/api/hosts/collections",
              "prompt": [
                {
                  "key": "field",
                  "label": "Match on",
                  "kind": "select",
                  "required": true,
                  "options": [
                    {
                      "value": "tag",
                      "label": "Tag"
                    },
                    {
                      "value": "categoryId",
                      "label": "Category"
                    },
                    {
                      "value": "priceUsd",
                      "label": "Price"
                    },
                    {
                      "value": "name",
                      "label": "Name"
                    },
                    {
                      "value": "type",
                      "label": "Type"
                    }
                  ],
                  "initial": "tag"
                },
                {
                  "key": "op",
                  "label": "Condition",
                  "kind": "select",
                  "required": true,
                  "options": [
                    {
                      "value": "eq",
                      "label": "is"
                    },
                    {
                      "value": "neq",
                      "label": "is not"
                    },
                    {
                      "value": "lt",
                      "label": "below"
                    },
                    {
                      "value": "gt",
                      "label": "above"
                    },
                    {
                      "value": "contains",
                      "label": "contains"
                    }
                  ],
                  "initial": "eq"
                },
                {
                  "key": "valueText",
                  "label": "Value",
                  "kind": "text",
                  "when": "form.field != categoryId"
                },
                {
                  "key": "valueCategory",
                  "label": "Category",
                  "kind": "select",
                  "when": "form.field == categoryId",
                  "optionsFrom": {
                    "items": "data.categories.items",
                    "value": "{item.$id}",
                    "label": "{item.name}"
                  }
                }
              ],
              "body": {
                "hostId": "{site.id}",
                "action": "update",
                "kind": "catalog",
                "id": "{params.collectionId}",
                "data": {
                  "name": "{data.col.name}",
                  "slug": "{data.col.slug}",
                  "mode": "{data.col.mode}",
                  "description": "{data.col.description}",
                  "productIds": "{data.col.productIds}",
                  "rules": {
                    "$append": {
                      "list": "{data.col.rules}",
                      "item": {
                        "field": "{form.field}",
                        "op": "{form.op}",
                        "value": "{form.valueText|form.valueCategory}"
                      }
                    }
                  },
                  "matchAll": "{data.col.matchAll}",
                  "imageUrl": "{data.col.imageUrl}",
                  "order": "{data.col.order}"
                }
              },
              "then": {
                "label": "Update memberships",
                "url": "/api/commerce/collection-membership",
                "body": {
                  "hostId": "{site.id}",
                  "collectionId": "{params.collectionId}"
                },
                "loop": {
                  "cursor": "after",
                  "param": "after",
                  "until": "done"
                }
              },
              "success": "Saved"
            }
          ]
        }
      ]
    }
  ]
}
