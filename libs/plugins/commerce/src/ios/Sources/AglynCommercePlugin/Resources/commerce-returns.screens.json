            {
              "title": "Return settings",
              "subtitle": "Online requests, the window and which products",
              "icon": "gearshape|settings",
              "screen": "commerce.returnSettings"
            }
          ]
        },
        {
          "type": "list",
          "id": "returns",
          "title": "All returns",
          "items": "data.returns.items",
          "primary": "{item.orderNumber} · {item.customerName|item.customerEmail|'Guest buyer'}",
          "secondary": "{item.lines.*.name} · Requested {item.createdAtMs:date}",
          "icon": "arrow.uturn.backward.circle|undo",
          "badges": [
            {
              "text": "{const.statuses[id=item.status].label}",
