        ]
      },
      "blocks": [
        {
          "type": "form",
          "id": "settings",
          "title": "Returns",
          "footer": "Whether buyers may ask for a return online, for how many days after the order shipped (or was placed, when nothing ships), and which product types. A merchant may start a return on any order from the order.",
          "fields": [
            {
              "key": "enabled",
              "label": "Accept return requests online",
              "kind": "toggle",
              "initial": "{data.store.returns.enabled ?? 'true'}"
            },
            {
              "key": "windowDays",
              "label": "Return window in days",
              "kind": "number",
              "min": 0,
              "max": 365,
              "required": true,
              "initial": "{data.store.returns.windowDays ?? '30'}",
              "help": "0 to 365."
            },
            {
              "key": "physical",
              "label": "Physical products",
              "kind": "toggle",
              "initial": "{?data.store.returns.eligibleTypes[=const.types.physical] || !data.store.returns.eligibleTypes}"
            },
            {
              "key": "digital",
              "label": "Digital products",
              "kind": "toggle",
              "initial": "{?data.store.returns.eligibleTypes[=const.types.digital]}"
            },
            {
              "key": "service",
              "label": "Services",
              "kind": "toggle",
              "initial": "{?data.store.returns.eligibleTypes[=const.types.service]}"
            }
          ],
          "submit": {
            "label": "Save return settings",
            "write": {
              "doc": "hosts/{site.id}/settings/store",
              "siteWide": true,
              "fields": {
                "returns": {
                  "enabled": "{form.enabled}",
                  "windowDays": "{form.windowDays}",
                  "eligibleTypes": {
                    "$pick": {
                      "physical": "{form.physical}",
                      "digital": "{form.digital}",
                      "service": "{form.service}"
                    }
                  }
                }
              }
            },
            "success": "Return settings saved"
          }
        }
      ]
    }
  ]
}
