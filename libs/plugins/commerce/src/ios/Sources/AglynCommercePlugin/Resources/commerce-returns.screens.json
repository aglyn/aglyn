          },
          {
            "id": "refunded",
            "label": "Refunded"
          },
          {
            "id": "closed",
            "label": "Closed"
          }
        ],
        "reasons": [
          {
            "id": "damaged",
            "label": "Arrived damaged"
          },
          {
            "id": "wrong_item",
            "label": "Wrong item"
          },
          {
            "id": "not_as_described",
            "label": "Not as described"
          },
          {
