              "params": {
                "status": "approved"
              }
            },
            {
              "title": "Declined",
              "icon": "line.3.horizontal.decrease|filter_list",
              "screen": "commerce.returnsByStatus",
              "params": {
                "status": "declined"
              }
            },
            {
              "title": "Received",
              "icon": "line.3.horizontal.decrease|filter_list",
              "screen": "commerce.returnsByStatus",
              "params": {
                "status": "received"
