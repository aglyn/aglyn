{
  "name": "tenant-feature-instance",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tenant/feature/instance/src",
  "projectType": "library",
  "tags": [
    "scope:lib",
    "scope:aglyn",
    "scope:feature",
    "scope:tenant",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/tenant/feature/instance",
        "main": "libs/tenant/feature/instance/src/index.ts",
        "tsConfig": "libs/tenant/feature/instance/tsconfig.lib.json",
        "assets": ["libs/tenant/feature/instance/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "@swc/jest"]
        }
      ]
    }
  }
}
