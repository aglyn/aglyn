{
  "name": "tenant-data-admin",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tenant/data/admin/src",
  "projectType": "library",
  "tags": [
    "scope:lib",
    "scope:aglyn",
    "scope:data",
    "aglyn:tenancy",
    "scope:tenant",
    "type:data"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/tenant/data/admin",
        "main": "libs/tenant/data/admin/src/index.ts",
        "tsConfig": "libs/tenant/data/admin/tsconfig.lib.json",
        "assets": ["libs/tenant/data/admin/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest"]
        }
      ]
    }
  }
}
