{
  "name": "native-kotlin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "scope:mobile",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/android",
        "command": "./gradlew :native-core:assemble :native-ui:assemble :native-plugin-host:assemble :native-webview:assemble :native-shell:assemble"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/android",
        "command": "./gradlew desktopTest"
      }
    }
  }
}
