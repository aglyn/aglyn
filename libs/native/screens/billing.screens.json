{
  "$comment": "Billing: the console's [orgSlug]/billing sections. Plan and usage show natively; choosing a plan, paying and payment methods open Stripe's hosted Checkout and Customer Portal in the platform's secure in-app browser, as the console opens them in a tab. No purchase happens in the app. Routes: /api/billing/subscription, /api/billing/checkout, /api/billing/invoices, /api/billing/profile, /api/billing/host-usage, /api/billing/usage-budget, /api/billing/storage-overage. Grammar: docs/mobile/native-architecture.md §13.",
  "screens": [
    {
      "id": "core.billing",
      "title": "Billing",
      "subtitle": "Plan, usage and invoices",
      "icon": "creditcard|credit_card",
      "scope": "org",
      "group": "workspace",
      "order": 20,
      "links": [
        "/billing",
        "/billing/plans"
      ],
      "load": {
        "org": {
          "doc": "orgs/{org.id}"
        },
        "billing": {
          "doc": "orgs/{org.id}/billing/stripe",
          "optional": true
        },
        "usage": {
          "url": "/api/billing/host-usage?orgId={org.id}",
          "optional": true
        },
        "collab": {
          "url": "/api/billing/collaborator-allocations",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "siteTraffic": {
          "url": "/api/billing/host-usage?hostId={item.hostId}",
          "each": "data.collab.sites",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "notice",
          "tone": "warning",
          "when": "data.billing.subscription.status == past_due,unpaid,incomplete",
          "text": "The last payment did not go through. Update the payment method to keep the plan."
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.billing.subscription.pendingDowngrade",
          "text": "Moving to {data.billing.subscription.pendingDowngrade.plan:title} at the end of this period."
        },
        {
          "type": "fields",
          "title": "Plan",
          "rows": [
            {
              "label": "Plan",
              "value": "{data.billing.plan|data.org.plan|'Free':title}",
              "chip": true,
              "tone": "info"
            },
            {
              "label": "Status",
              "value": "{data.billing.subscription.status|data.org.subscription.status:title}",
              "chip": true,
              "tones": {
                "Active": "success",
                "Trialing": "info",
                "Past due": "error",
                "Unpaid": "error",
                "Canceled": "warning",
                "*": "neutral"
              },
              "when": "data.billing.subscription.status || data.org.subscription.status"
            },
            {
              "label": "Billed",
              "value": "{data.billing.subscription.interval|data.org.subscription.interval}ly",
              "when": "data.billing.subscription.interval || data.org.subscription.interval"
            },
            {
              "label": "Renews",
              "value": "{data.billing.subscription.currentPeriodEnd|data.org.subscription.currentPeriodEnd:date}",
              "when": "data.billing.subscription.currentPeriodEnd || data.org.subscription.currentPeriodEnd"
            }
          ]
        },
        {
          "type": "fields",
          "title": "This month, all sites",
          "when": "data.usage",
          "rows": [
            {
              "label": "Page views",
              "value": "{data.siteTraffic.*.monthPageViews + data.usage.monthPageViews?:number}"
            },
            {
              "label": "Bandwidth",
              "value": "{data.siteTraffic.*.bandwidthGb + data.usage.bandwidthGb?:number} GB"
            },
            {
              "label": "Media delivered",
              "value": "{data.siteTraffic.*.monthMediaBandwidthBytes + data.usage.monthMediaBandwidthBytes?:bytes}"
            }
          ]
        },
        {
          "type": "actions",
          "title": "Manage",
          "when": "org.manager",
          "footer": "Plans, payment methods and cancellations open on Stripe's secure pages.",
          "items": [
            {
              "id": "portal",
              "label": "Manage subscription",
              "icon": "creditcard|credit_card",
              "when": "data.billing.subscription || data.org.subscription",
              "url": "/api/billing/subscription",
              "body": {
                "orgId": "{org.id}",
                "action": "portal"
              },
              "open": "url"
            },
            {
              "id": "card",
              "label": "Update payment method",
              "icon": "creditcard.and.123|add_card",
              "when": "data.billing.subscription || data.org.subscription",
              "url": "/api/billing/subscription",
              "body": {
                "orgId": "{org.id}",
                "action": "portal",
                "flow": "payment_method_update"
              },
              "open": "url"
            },
            {
              "id": "resume",
              "label": "Keep my plan",
              "icon": "arrow.uturn.backward|undo",
              "when": "data.billing.subscription.cancelAtPeriodEnd",
              "url": "/api/billing/subscription",
              "body": {
                "orgId": "{org.id}",
                "action": "resume"
              },
              "success": "Your plan continues"
            },
            {
              "id": "plans",
              "label": "Choose a plan",
              "icon": "sparkles|workspace_premium",
              "navigate": {
                "screen": "core.billing.plans"
              }
            }
          ]
        },
        {
          "type": "links",
          "items": [
            {
              "title": "Usage",
              "subtitle": "Spend limits and storage",
              "icon": "chart.bar|bar_chart",
              "screen": "core.billing.usage"
            },
            {
              "title": "Invoices",
              "subtitle": "Every invoice and receipt",
              "icon": "doc.text|receipt_long",
              "screen": "core.billing.invoices"
            },
            {
              "title": "Seats by site",
              "subtitle": "Move purchased collaborator and register seats between sites",
              "icon": "person.2|group",
              "screen": "core.billing.seats",
              "when": "org.manager"
            },
            {
              "title": "Billing details",
              "subtitle": "Email, address, tax IDs, cards",
              "icon": "building.columns|account_balance",
              "screen": "core.billing.settings",
              "when": "org.manager"
            }
          ]
        },
        {
          "type": "zone",
          "name": "orgBillingUsage",
          "title": "Add-ons and usage"
        }
      ]
    },
    {
      "id": "core.billing.plans",
      "title": "Choose a plan",
      "icon": "sparkles|workspace_premium",
      "scope": "org",
      "requires": "org.manager",
      "blocks": [
        {
          "type": "notice",
          "tone": "info",
          "text": "Pick a plan to continue on Stripe's secure checkout, where the price and terms are shown. A workspace already on a paid plan changes it under Manage subscription."
        },
        {
          "type": "list",
          "items": "const.plans",
          "primary": "{item.label}",
          "secondary": "{item.blurb}",
          "icon": "sparkles|workspace_premium",
          "actions": [
            {
              "id": "monthly",
              "label": "Continue, billed monthly",
              "icon": "calendar|event",
              "url": "/api/billing/checkout",
              "body": {
                "orgId": "{org.id}",
                "plan": "{item.id}",
                "interval": "month"
              },
              "open": "url",
              "reload": false
            },
            {
              "id": "yearly",
              "label": "Continue, billed yearly",
              "icon": "calendar.badge.clock|event",
              "url": "/api/billing/checkout",
              "body": {
                "orgId": "{org.id}",
                "plan": "{item.id}",
                "interval": "year"
              },
              "open": "url",
              "reload": false
            }
          ]
        }
      ],
      "constants": {
        "plans": [
          {
            "id": "starter",
            "label": "Starter",
            "blurb": "One site, the essentials"
          },
          {
            "id": "pro",
            "label": "Pro",
            "blurb": "More sites, store and forms"
          },
          {
            "id": "business",
            "label": "Business",
            "blurb": "Teams and higher limits"
          },
          {
            "id": "agency",
            "label": "Agency",
            "blurb": "Client workspaces and white-label"
          }
        ]
      }
    },
    {
      "id": "core.billing.invoices",
      "title": "Invoices",
      "icon": "doc.text|receipt_long",
      "scope": "org",
      "links": [
        "/billing/invoices"
      ],
      "load": {
        "invoices": {
          "url": "/api/billing/invoices?orgId={org.id}",
          "cursor": "nextCursor",
          "items": "invoices"
        }
      },
      "blocks": [
        {
          "type": "list",
          "load": "invoices",
          "items": "data.invoices.invoices",
          "primary": "{item.number|item.id}",
          "secondary": "{item.created:date}",
          "trailing": "{item.totalCents:cents/item.currency}",
          "icon": "doc.text|receipt_long",
          "badges": [
            {
              "text": "{item.status:title}",
              "tones": {
                "Paid": "success",
                "Open": "warning",
                "Uncollectible": "error",
                "Void": "neutral",
                "*": "neutral"
              }
            }
          ],
          "actions": [
            {
              "id": "pay",
              "label": "Pay on Stripe",
              "icon": "creditcard|credit_card",
              "when": "item.status == open && item.hostedInvoiceUrl",
              "link": "{item.hostedInvoiceUrl}"
            },
            {
              "id": "view",
              "label": "View invoice",
              "icon": "doc.richtext|description",
              "when": "item.hostedInvoiceUrl",
              "link": "{item.hostedInvoiceUrl}"
            },
            {
              "id": "pdf",
              "label": "Download PDF",
              "icon": "arrow.down.doc|download",
              "when": "item.invoicePdf",
              "link": "{item.invoicePdf}"
            },
            {
              "id": "receipt",
              "label": "Receipt",
              "icon": "doc.plaintext|receipt",
              "when": "item.receiptUrl",
              "link": "{item.receiptUrl}"
            }
          ],
          "empty": "No invoices yet."
        }
      ]
    },
    {
      "id": "core.billing.usage",
      "title": "Usage",
      "icon": "chart.bar|bar_chart",
      "scope": "org",
      "links": [
        "/billing/usage"
      ],
      "load": {
        "usage": {
          "url": "/api/billing/host-usage?orgId={org.id}",
          "optional": true
        },
        "budget": {
          "url": "/api/billing/usage-budget",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "storage": {
          "url": "/api/billing/storage-overage",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "ceiling": {
          "url": "/api/billing/email-ceiling?orgId={org.id}",
          "optional": true
        },
        "ent": {
          "url": "/api/orgs/entitlements?orgId={org.id}",
          "optional": true
        },
        "org": {
          "doc": "orgs/{org.id}",
          "optional": true
        },
        "seats": {
          "url": "/api/orgs/members?orgId={org.id}&counts=1",
          "optional": true
        },
        "collab": {
          "url": "/api/billing/collaborator-allocations",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "siteTraffic": {
          "url": "/api/billing/host-usage?hostId={item.hostId}",
          "each": "data.collab.sites",
          "optional": true
        },
        "datasets": {
          "query": {
            "collection": "orgs/{org.id}/datasets",
            "count": true
          },
          "optional": true
        },
        "contacts": {
          "query": {
            "collection": "orgs/{org.id}/contacts",
            "count": true
          },
          "optional": true
        },
        "companies": {
          "query": {
            "collection": "orgs/{org.id}/companies",
            "count": true
          },
          "optional": true
        },
        "deals": {
          "query": {
            "collection": "orgs/{org.id}/deals",
            "count": true
          },
          "optional": true
        },
        "api": {
          "doc": "orgs/{org.id}/apiUsage/{now.month}",
          "optional": true
        },
        "crmEmails": {
          "doc": "orgs/{org.id}/crmEmailUsage/{now.day}",
          "optional": true
        },
        "campaignCounter": {
          "doc": "orgs/{org.id}/counters/campaignEmailSends",
          "optional": true
        },
        "workflowCounter": {
          "doc": "orgs/{org.id}/counters/workflowRuns",
          "optional": true
        },
        "actionCounter": {
          "doc": "orgs/{org.id}/counters/actionRuns",
          "optional": true
        },
        "rollup": {
          "doc": "orgs/{org.id}/usage/{now.month}",
          "optional": true
        },
        "rollupBefore": {
          "doc": "orgs/{org.id}/usage/{now.prevMonth}",
          "optional": true
        },
        "band": {
          "url": "/api/media/storage?orgId={org.id}",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "meters",
          "title": "Your plan",
          "footer": "What this workspace uses of what its plan includes. Storage is shown under Storage over the plan.",
          "meters": [
            {
              "label": "Sites",
              "used": "{data.collab.sites:count}",
              "limit": "{data.ent.quotas.hostLimit}",
              "format": "number",
              "when": "data.ent && data.collab"
            },
            {
              "label": "Team seats (incl. you)",
              "used": "{data.seats.managerSeats}",
              "limit": "{data.ent.quotas.managersPerOrg + data.org.seatAddons.managers?}",
              "format": "number",
              "when": "data.ent && data.seats && !data.seats.pendingManagerSeats"
            },
            {
              "label": "Team seats (incl. you + {data.seats.pendingManagerSeats} invited)",
              "used": "{data.seats.managerSeats}",
              "limit": "{data.ent.quotas.managersPerOrg + data.org.seatAddons.managers?}",
              "format": "number",
              "when": "data.ent && data.seats && data.seats.pendingManagerSeats"
            },
            {
              "label": "Datasets (organization)",
              "used": "{data.datasets.count}",
              "limit": "{data.ent.quotas.datasetsPerOrg + data.org.seatAddons.datasets?}",
              "format": "number",
              "when": "data.ent && data.datasets"
            },
            {
              "label": "Storage (organization), MB",
              "used": "{data.band.usedBytes:megabytes}",
              "limit": "{data.band.allowanceMb}",
              "format": "number",
              "when": "data.band && !data.band.unlimited"
            },
            {
              "label": "Data storage (organization), MB",
              "used": "{data.rollup.dataStorageMb}",
              "limit": "{data.ent.quotas.dataStorageMbPerOrg}",
              "format": "number",
              "when": "data.ent && data.rollup.dataStorageMb"
            },
            {
              "label": "Data storage (organization), MB",
              "used": "{data.rollupBefore.dataStorageMb}",
              "limit": "{data.ent.quotas.dataStorageMbPerOrg}",
              "format": "number",
              "when": "data.ent && !data.rollup.dataStorageMb && data.rollupBefore.dataStorageMb"
            },
            {
              "label": "CRM records (organization)",
              "used": "{data.contacts.count + data.companies.count + data.deals.count}",
              "limit": "{data.ent.quotas.contactsPerHost}",
              "format": "number",
              "when": "data.ent.features.crm && data.contacts && data.companies && data.deals"
            },
            {
              "label": "Stored records (organization)",
              "used": "{data.contacts.count + data.companies.count + data.deals.count}",
              "limit": "{data.ent.quotas.contactsPerHost}",
              "format": "number",
              "when": "data.ent && !data.ent.features.crm && data.contacts && data.companies && data.deals"
            },
            {
              "label": "One-to-one emails (today)",
              "used": "{data.crmEmails.count ?? '0'}",
              "limit": "{data.ent.quotas.crmEmailsPerDay}",
              "format": "number",
              "when": "data.ent.quotas.crmEmailsPerDay"
            },
            {
              "label": "API requests (this month)",
              "used": "{data.api.count ?? '0'}",
              "limit": "{data.ent.quotas.apiRequestsPerMonth}",
              "format": "number",
              "when": "data.ent.quotas.apiRequestsPerMonth"
            },
            {
              "label": "Workflow runs (this month, organization)",
              "used": "{data.workflowCounter[@now.month] ?? '0'}",
              "limit": "{data.ent.quotas.workflowRunsPerMonth}",
              "format": "number",
              "when": "data.ent.quotas.workflowRunsPerMonth"
            },
            {
              "label": "Action runs (this month, organization)",
              "used": "{data.actionCounter[@now.month] ?? '0'}",
              "limit": "{data.ent.quotas.actionRunsPerMonth}",
              "format": "number",
              "when": "data.ent.quotas.actionRunsPerMonth"
            },
            {
              "label": "Bandwidth (this month, organization), GB",
              "used": "{data.siteTraffic.*.bandwidthGb + data.usage.bandwidthGb?}",
              "limit": "{data.ent.quotas.bandwidthGb}",
              "format": "number",
              "when": "data.ent && data.siteTraffic"
            },
            {
              "label": "Campaign emails (this month, organization)",
              "used": "{data.campaignCounter[@now.month] ?? '0'}",
              "limit": "{data.ent.quotas.emailSendsPerMonth}",
              "format": "number",
              "when": "data.ent.quotas.emailSendsPerMonth"
            }
          ]
        },
        {
          "type": "fields",
          "title": "Storage (organization)",
          "when": "data.band",
          "footer": "Every site's media library and the organization library share this one allowance.",
          "rows": [
            {
              "label": "Used",
              "value": "{data.band.usedBytes:bytes} (unlimited)",
              "when": "data.band.unlimited"
            },
            {
              "label": "In the organization library",
              "value": "{data.band.scopeBytes:bytes}",
              "when": "data.band.scopeBytes"
            }
          ]
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.band && !data.band.unlimited && data.storage && !data.storage.metered",
          "text": "Uploads stop when your workspace reaches it. Free up space or upgrade to add more."
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.band && !data.band.unlimited && data.storage.metered && !data.band.hardBand",
          "text": "Past it, extra storage is billed on your invoice unless you set a storage cap."
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.band && !data.band.unlimited && data.storage.metered && data.band.hardBand",
          "text": "Past it, extra storage is billed on your invoice unless you set a storage cap. Uploads to the organization library stop at it for now, because its storage is not billed yet."
        },
        {
          "type": "fields",
          "title": "This month, all sites",
          "rows": [
            {
              "label": "Page views",
              "value": "{data.siteTraffic.*.monthPageViews + data.usage.monthPageViews?:number}"
            },
            {
              "label": "Bandwidth",
              "value": "{data.siteTraffic.*.bandwidthGb + data.usage.bandwidthGb?:number} GB"
            },
            {
              "label": "Media delivered",
              "value": "{data.siteTraffic.*.monthMediaBandwidthBytes + data.usage.monthMediaBandwidthBytes?:bytes}"
            }
          ]
        },
        {
          "type": "list",
          "title": "Usage by site",
          "when": "data.collab.sites",
          "items": "data.collab.sites",
          "count": false,
          "primary": "{item.displayName|item.hostId}",
          "icon": "globe|language",
          "empty": "No sites yet.",
          "open": {
            "screen": "core.billing.usage.site",
            "params": {
              "siteId": "{item.hostId}",
              "siteName": "{item.displayName|item.hostId}"
            }
          }
        },
        {
          "type": "fields",
          "title": "Campaign emails",
          "when": "data.ceiling.hourLimit",
          "footer": "The most a campaign can send in one hour, and the most the plan can deliver in a month.",
          "rows": [
            {
              "label": "This hour",
              "value": "{data.ceiling.hourUsed:number} of {data.ceiling.hourLimit:number}"
            },
            {
              "label": "Deliverable this month",
              "value": "{data.ceiling.deliverableMonthly:number}"
            },
            {
              "label": "Per send",
              "value": "{data.ceiling.perSend:number}"
            }
          ]
        },
        {
          "type": "notice",
          "tone": "info",
          "when": "data.budget.lastAlert.threshold",
          "text": "You passed {data.budget.lastAlert.threshold}% of the limit this month."
        },
        {
          "type": "list",
          "title": "Metered usage",
          "when": "data.budget.spend.lines",
          "items": "data.budget.spend.lines",
          "primary": "{item.label|item.key:title}",
          "trailing": "{item.units:number} {item.unitLabel}",
          "count": false,
          "empty": "Nothing metered this month."
        },
        {
          "type": "form",
          "title": "Monthly spend limit",
          "id": "budget",
          "when": "data.budget",
          "footer": "We email the billing contacts as usage nears the limit.",
          "fields": [
            {
              "key": "amountUsd",
              "label": "Limit in US dollars",
              "kind": "number",
              "initial": "{data.budget.amountUsd}",
              "placeholder": "No limit"
            },
            {
              "key": "thresholds",
              "label": "Alert me at (%)",
              "kind": "text",
              "initial": "{data.budget.thresholdPcts|data.budget.defaultThresholdPcts}",
              "placeholder": "50, 80, 100",
              "help": "Percentages of the limit, separated by commas."
            }
          ],
          "submit": {
            "label": "Save limit",
            "when": "org.manager",
            "url": "/api/billing/usage-budget",
            "body": {
              "orgId": "{org.id}",
              "action": "setBudget",
              "amountUsd": "{form.amountUsd}",
              "thresholdPcts": {
                "$split": "{form.thresholds}"
              }
            },
            "success": "Saved"
          }
        },
        {
          "type": "actions",
          "when": "org.manager && data.budget.budgetSet",
          "items": [
            {
              "id": "clearBudget",
              "label": "Remove the limit",
              "icon": "trash|delete",
              "destructive": true,
              "confirm": "Remove the monthly spend limit?",
              "url": "/api/billing/usage-budget",
              "body": {
                "orgId": "{org.id}",
                "action": "clearBudget"
              },
              "success": "Limit removed",
              "reload": true
            }
          ]
        },
        {
          "type": "fields",
          "title": "Storage over the plan",
          "when": "data.storage",
          "rows": [
            {
              "label": "Metered this month",
              "value": "{data.storage.metered:yesno}"
            },
            {
              "label": "Monthly cap",
              "value": "{data.storage.monthlyCapUsd|data.storage.defaultCapUsd:dollars}"
            }
          ]
        },
        {
          "type": "form",
          "id": "storageCap",
          "when": "data.storage && org.manager",
          "fields": [
            {
              "key": "capUsd",
              "label": "Storage overage cap (USD)",
              "kind": "number",
              "initial": "{data.storage.monthlyCapUsd}"
            }
          ],
          "submit": {
            "label": "Save cap",
            "url": "/api/billing/storage-overage",
            "body": {
              "orgId": "{org.id}",
              "action": "setCap",
              "capUsd": "{form.capUsd}"
            },
            "success": "Saved"
          }
        }
      ]
    },
    {
      "id": "core.billing.settings",
      "title": "Billing details",
      "icon": "building.columns|account_balance",
      "scope": "org",
      "requires": "org.manager",
      "links": [
        "/billing/settings"
      ],
      "load": {
        "profile": {
          "url": "/api/billing/profile",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          }
        }
      },
      "blocks": [
        {
          "type": "form",
          "title": "Billing email",
          "id": "email",
          "footer": "Invoices and receipts go here.",
          "fields": [
            {
              "key": "email",
              "label": "Email",
              "kind": "email",
              "required": true,
              "initial": "{data.profile.customer.email}"
            }
          ],
          "submit": {
            "label": "Save email",
            "url": "/api/billing/profile",
            "body": {
              "orgId": "{org.id}",
              "action": "set-billing-email",
              "email": "{form.email}"
            },
            "success": "Saved"
          }
        },
        {
          "type": "form",
          "title": "Billing address",
          "id": "address",
          "object": "data.profile.customer.address",
          "fields": [
            {
              "key": "name",
              "label": "Name on invoices",
              "kind": "text",
              "initial": "{data.profile.customer.name}"
            },
            {
              "key": "line1",
              "label": "Address",
              "kind": "text",
              "required": true,
              "initial": "{item.line1}"
            },
            {
              "key": "line2",
              "label": "Address line 2",
              "kind": "text",
              "initial": "{item.line2}"
            },
            {
              "key": "city",
              "label": "City",
              "kind": "text",
              "initial": "{item.city}"
            },
            {
              "key": "state",
              "label": "State or region",
              "kind": "text",
              "initial": "{item.state}"
            },
            {
              "key": "postalCode",
              "label": "Postal code",
              "kind": "text",
              "initial": "{item.postalCode}"
            },
            {
              "key": "country",
              "label": "Country (2 letters)",
              "kind": "text",
              "required": true,
              "initial": "{item.country}",
              "placeholder": "US"
            }
          ],
          "submit": {
            "label": "Save address",
            "url": "/api/billing/profile",
            "body": {
              "orgId": "{org.id}",
              "action": "set-billing-address",
              "name": "{form.name}",
              "line1": "{form.line1}",
              "line2": "{form.line2}",
              "city": "{form.city}",
              "state": "{form.state}",
              "postalCode": "{form.postalCode}",
              "country": "{form.country}"
            },
            "success": "Saved"
          }
        },
        {
          "type": "list",
          "title": "Payment methods",
          "items": "data.profile.paymentMethods",
          "primary": "{item.brand|item.type:title} •••• {item.last4}",
          "secondary": "Expires {item.expMonth}/{item.expYear}",
          "icon": "creditcard|credit_card",
          "badges": [
            {
              "text": "Default",
              "when": "item.isDefault",
              "tone": "success"
            }
          ],
          "actions": [
            {
              "id": "default",
              "label": "Make default",
              "icon": "checkmark.circle|check_circle",
              "when": "!item.isDefault",
              "url": "/api/billing/profile",
              "body": {
                "orgId": "{org.id}",
                "action": "set-default-card",
                "paymentMethodId": "{item.id}"
              },
              "success": "Default updated"
            },
            {
              "id": "remove",
              "label": "Remove",
              "icon": "trash|delete",
              "destructive": true,
              "when": "!item.isDefault",
              "confirm": "Remove this payment method?",
              "url": "/api/billing/profile",
              "body": {
                "orgId": "{org.id}",
                "action": "remove-card",
                "paymentMethodId": "{item.id}"
              },
              "success": "Removed"
            }
          ],
          "empty": "No payment method on file."
        },
        {
          "type": "actions",
          "items": [
            {
              "id": "addCard",
              "label": "Add a payment method on Stripe",
              "icon": "plus|add_card",
              "url": "/api/billing/subscription",
              "body": {
                "orgId": "{org.id}",
                "action": "portal",
                "flow": "payment_method_update"
              },
              "open": "url"
            }
          ]
        },
        {
          "type": "list",
          "title": "Tax IDs",
          "items": "data.profile.taxIds",
          "primary": "{item.value}",
          "secondary": "{item.type:upper}",
          "icon": "number|tag",
          "badges": [
            {
              "text": "{item.verification:title}",
              "tones": {
                "Verified": "success",
                "Pending": "warning",
                "Unverified": "error",
                "*": "neutral"
              }
            }
          ],
          "actions": [
            {
              "id": "remove",
              "label": "Remove",
              "icon": "trash|delete",
              "destructive": true,
              "confirm": "Remove {item.value}?",
              "url": "/api/billing/profile",
              "body": {
                "orgId": "{org.id}",
                "action": "remove-tax-id",
                "taxIdId": "{item.id}"
              },
              "success": "Removed"
            }
          ],
          "empty": "No tax IDs."
        },
        {
          "type": "actions",
          "items": [
            {
              "id": "addTaxId",
              "label": "Add a tax ID",
              "icon": "plus|add",
              "url": "/api/billing/profile",
              "prompt": [
                {
                  "key": "type",
                  "label": "Type",
                  "kind": "select",
                  "initial": "eu_vat",
                  "options": [
                    {
                      "value": "eu_vat",
                      "label": "EU VAT"
                    },
                    {
                      "value": "gb_vat",
                      "label": "UK VAT"
                    },
                    {
                      "value": "au_abn",
                      "label": "Australian ABN"
                    },
                    {
                      "value": "ca_bn",
                      "label": "Canadian BN"
                    },
                    {
                      "value": "us_ein",
                      "label": "US EIN"
                    },
                    {
                      "value": "in_gst",
                      "label": "Indian GST"
                    },
                    {
                      "value": "nz_gst",
                      "label": "New Zealand GST"
                    }
                  ]
                },
                {
                  "key": "value",
                  "label": "Number",
                  "kind": "text",
                  "required": true
                }
              ],
              "body": {
                "orgId": "{org.id}",
                "action": "add-tax-id",
                "taxIdType": "{form.type}",
                "taxIdValue": "{form.value}"
              },
              "success": "Added"
            }
          ]
        }
      ]
    },
    {
      "id": "core.billing.seats",
      "title": "Seats by site",
      "subtitle": "Collaborator and register seats",
      "icon": "person.2|group",
      "scope": "org",
      "requires": "org.manager",
      "load": {
        "collab": {
          "url": "/api/billing/collaborator-allocations",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "regs": {
          "url": "/api/billing/register-allocations",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "notice",
          "tone": "info",
          "text": "Seats are bought under Add-ons. Here you choose which site uses them."
        },
        {
          "type": "fields",
          "title": "Collaborator seats",
          "rows": [
            {
              "label": "Purchased",
              "value": "{data.collab.pool.purchased:number}"
            },
            {
              "label": "Assigned",
              "value": "{data.collab.pool.allocated:number}"
            },
            {
              "label": "Unassigned",
              "value": "{data.collab.pool.available:number}"
            }
          ]
        },
        {
          "type": "list",
          "title": "Sites",
          "items": "data.collab.sites",
          "primary": "{item.displayName|item.hostId}",
          "secondary": "{item.collaborators:number} collaborators in use · {item.allocatedSeats:number} extra assigned · limit {item.cap:number}",
          "icon": "globe|language",
          "badges": [
            {
              "text": "Unlimited",
              "when": "item.capUnlimited",
              "tone": "info"
            }
          ],
          "actions": [
            {
              "id": "set",
              "label": "Set seats",
              "icon": "slider.horizontal.3|tune",
              "when": "org.manager",
              "prompt": [
                {
                  "key": "seats",
                  "label": "Extra seats for this site",
                  "kind": "number",
                  "required": true,
                  "initial": "{item.allocatedSeats}"
                }
              ],
              "url": "/api/billing/collaborator-allocations",
              "body": {
                "orgId": "{org.id}",
                "action": "set",
                "hostId": "{item.hostId}",
                "seats": "{form.seats}"
              },
              "success": "Seats updated",
              "reload": true
            }
          ],
          "empty": "No sites yet."
        },
        {
          "type": "fields",
          "title": "Register seats",
          "rows": [
            {
              "label": "Purchased",
              "value": "{data.regs.pool.purchased:number}"
            },
            {
              "label": "Assigned",
              "value": "{data.regs.pool.allocated:number}"
            },
            {
              "label": "Unassigned",
              "value": "{data.regs.pool.available:number}"
            }
          ]
        },
        {
          "type": "list",
          "title": "Sites",
          "items": "data.regs.sites",
          "primary": "{item.displayName|item.hostId}",
          "secondary": "{item.registers:number} registers in use · {item.allocatedSeats:number} extra assigned · limit {item.cap:number}",
          "icon": "globe|language",
          "badges": [
            {
              "text": "Unlimited",
              "when": "item.capUnlimited",
              "tone": "info"
            }
          ],
          "actions": [
            {
              "id": "set",
              "label": "Set seats",
              "icon": "slider.horizontal.3|tune",
              "when": "org.manager",
              "prompt": [
                {
                  "key": "seats",
                  "label": "Extra seats for this site",
                  "kind": "number",
                  "required": true,
                  "initial": "{item.allocatedSeats}"
                }
              ],
              "url": "/api/billing/register-allocations",
              "body": {
                "orgId": "{org.id}",
                "action": "set",
                "hostId": "{item.hostId}",
                "seats": "{form.seats}"
              },
              "success": "Seats updated",
              "reload": true
            }
          ],
          "empty": "No sites yet."
        }
      ]
    },
    {
      "id": "core.billing.usage.site",
      "title": "{params.siteName|'Site usage'}",
      "icon": "chart.bar|bar_chart",
      "scope": "org",
      "load": {
        "ent": {
          "url": "/api/orgs/entitlements?orgId={org.id}",
          "optional": true
        },
        "collab": {
          "url": "/api/billing/collaborator-allocations",
          "method": "POST",
          "body": {
            "orgId": "{org.id}",
            "action": "get"
          },
          "optional": true
        },
        "pages": {
          "url": "/api/hosts/usage?hostId={params.siteId}",
          "optional": true
        },
        "layouts": {
          "query": {
            "collection": "hosts/{params.siteId}/layouts",
            "count": true
          },
          "optional": true
        },
        "variables": {
          "query": {
            "collection": "hosts/{params.siteId}/variables",
            "count": true
          },
          "optional": true
        },
        "functions": {
          "query": {
            "collection": "hosts/{params.siteId}/functions",
            "count": true
          },
          "optional": true
        },
        "forms": {
          "query": {
            "collection": "hosts/{params.siteId}/forms",
            "count": true
          },
          "optional": true
        },
        "componentsAll": {
          "query": {
            "collection": "hosts/{params.siteId}/components",
            "count": true
          },
          "optional": true
        },
        "componentsGone": {
          "query": {
            "collection": "hosts/{params.siteId}/components",
            "count": true,
            "where": [
              [
                "deletedAt",
                ">",
                {
                  "$date": "1970-01-01T00:00:00Z"
                }
              ]
            ]
          },
          "optional": true
        },
        "media": {
          "doc": "hosts/{params.siteId}/counters/media",
          "optional": true
        }
      },
      "blocks": [
        {
          "type": "meters",
          "title": "This site",
          "footer": "Per-site collaborators, not end-user accounts, which are never metered.",
          "meters": [
            {
              "label": "Pages",
              "used": "{data.pages.screens}",
              "limit": "{data.ent.quotas.screensPerHost}",
              "format": "number",
              "when": "data.ent && data.pages"
            },
            {
              "label": "Shared layouts",
              "used": "{data.layouts.count}",
              "limit": "{data.ent.quotas.sharedLayoutsPerHost}",
              "format": "number",
              "when": "data.ent && data.layouts"
            },
            {
              "label": "Site collaborators",
              "used": "{data.collab.sites[hostId=params.siteId].collaborators}",
              "limit": "{data.collab.sites[hostId=params.siteId].cap}",
              "format": "number",
              "when": "data.collab.sites[hostId=params.siteId] && !data.collab.sites[hostId=params.siteId].capUnlimited"
            },
            {
              "label": "Site collaborators",
              "used": "{data.collab.sites[hostId=params.siteId].collaborators}",
              "limit": "",
              "format": "number",
              "when": "data.collab.sites[hostId=params.siteId].capUnlimited"
            },
            {
              "label": "Saved forms",
              "used": "{data.forms.count}",
              "limit": "{data.ent.quotas.formsPerHost}",
              "format": "number",
              "when": "data.ent && data.forms"
            },
            {
              "label": "Reusable components",
              "used": "{data.componentsAll.count - data.componentsGone.count}",
              "limit": "{data.ent.quotas.componentsPerHost}",
              "format": "number",
              "when": "data.ent && data.componentsAll && data.componentsGone"
            },
            {
              "label": "Variables",
              "used": "{data.variables.count}",
              "limit": "{data.ent.quotas.variablesPerHost}",
              "format": "number",
              "when": "data.ent && data.variables"
            },
            {
              "label": "Functions",
              "used": "{data.functions.count}",
              "limit": "{data.ent.quotas.functionsPerHost}",
              "format": "number",
              "when": "data.ent && data.functions"
            }
          ]
        },
        {
          "type": "fields",
          "title": "Storage on this site",
          "footer": "A share of the workspace's storage, not a meter of its own.",
          "rows": [
            {
              "label": "Media",
              "value": "{data.media.bytes ?? '0':bytes}",
              "when": "data.media || data.ent"
            }
          ]
        }
      ]
    }
  ]
}
