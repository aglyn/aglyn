{
  "$comment": "Cases both renderers replay (AglynScreensTests, com.aglyn.screens ScreenValuesTest), so a spec reads the same on Apple and Kotlin. Dates print in UTC here.",
  "context": {
    "org": {
      "id": "org1",
      "name": "Acme",
      "role": "admin",
      "manager": true
    },
    "staff": {
      "is": false,
      "role": null
    },
    "params": {
      "uid": "u2",
      "empty": ""
    },
    "data": {
      "members": [
        {
          "$id": "u1",
          "email": "a@acme.test",
          "displayName": "Ada",
          "role": "owner",
          "count": 0
        },
        {
          "$id": "u2",
          "email": "b@acme.test",
          "displayName": "",
          "role": "editor",
          "joined": 1791331200
        }
      ],
      "perms": {
        "org.settings": true
      },
      "money": 123456,
      "currency": "eur",
      "bytes": 1572864,
      "ratio": 0.456,
      "when": "2026-10-07T15:04:00Z",
      "ts": {
        "_seconds": 1791385440
      },
      "flag": false,
      "list": [
        "x",
        "y"
      ],
      "big": 1234567.891,
      "access": {
        "h1": "editor",
        "h2": "viewer"
      },
      "hostKey": "h2",
      "check": {
        "ok": false,
        "ms": 12,
        "code": "job-silent",
        "schedule": "0 4 * * *",
        "lastBeatAgeMinutes": 1500,
        "newestReadyAgeDays": 3,
        "degradedEpisodes": 2,
        "held": true,
        "note": "",
        "nested": {
          "a": 1
        }
      },
      "msA": 30000,
      "msB": 720000,
      "msC": 11100000,
      "msD": 360000000,
      "rolesInfo": {
        "h1": {
          "label": "Editor"
        },
        "h2": {
          "label": "Viewer"
        }
      }
    },
    "now": {
      "ms": 1790000000000
    },
    "form": {
      "scope": "org",
      "hours": "2",
      "blank": "",
      "quota.hostLimit": 5,
      "quota.blank": null,
      "quota.typed": "12",
      "quota.empty": "",
      "feature.a": "true",
      "feature.b": "false",
      "feature.c": ""
    }
  },
  "render": [
    {
      "template": "Hi {data.members.0.displayName}",
      "expect": "Hi Ada"
    },
    {
      "template": "{data.members.1.displayName|data.members.1.email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.missing|'none'}",
      "expect": "none"
    },
    {
      "template": "{data.members.0.count|'n/a'}",
      "expect": "n/a"
    },
    {
      "template": "{data.members.0.count}",
      "expect": "0"
    },
    {
      "template": "{data.members[$id=params.uid].email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.perms[org.settings]:yesno}",
      "expect": "Yes"
    },
    {
      "template": "{data.money:cents}",
      "expect": "$1,234.56"
    },
    {
      "template": "{data.money:cents/data.currency}",
      "expect": "€1,234.56"
    },
    {
      "template": "{data.bytes:bytes}",
      "expect": "1.5 MB"
    },
    {
      "template": "{data.ratio:percent}",
      "expect": "45.6%"
    },
    {
      "template": "{data.when:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.when:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.ts:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.members.1.joined:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.flag:yesno}",
      "expect": "No"
    },
    {
      "template": "{data.list}",
      "expect": "x, y"
    },
    {
      "template": "{data.list:count} items",
      "expect": "2 items"
    },
    {
      "template": "{data.members.length}",
      "expect": "2"
    },
    {
      "template": "{data.big:number}",
      "expect": "1,234,567.89"
    },
    {
      "template": "{data.members.1.role:title}",
      "expect": "Editor"
    },
    {
      "template": "past_due",
      "expect": "past_due"
    },
    {
      "template": "{{literal}}",
      "expect": "{literal}}"
    },
    {
      "template": "{data.access[@data.hostKey]}",
      "expect": "viewer"
    },
    {
      "template": "{data.check:facts}",
      "expect": "degraded episodes: 2 · held: yes · last beat age minutes: 1,500 · newest ready age days: 3 · schedule: 0 4 * * *"
    },
    {
      "template": "{data.access:pairs}|{data.list:pairs}",
      "expect": "h1: editor, h2: viewer|x, y"
    },
    {
      "template": "{data.msA:duration}|{data.msB:duration}|{data.msC:duration}|{data.msD:duration}|{data.nothing:duration}",
      "expect": "under a minute|12 min|3h 5m|4 days|unknown"
    },
    {
      "template": "{data.rolesInfo[@data.hostKey].label}",
      "expect": "Viewer"
    }
  ],
  "url": [
    {
      "template": "/api/orgs/members?orgId={org.id}&q={data.members.0.email}",
      "expect": "/api/orgs/members?orgId=org1&q=a%40acme.test"
    }
  ],
  "resolve": [
    {
      "template": "{data.money}",
      "expect": 123456
    },
    {
      "template": "{data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing}",
      "expect": null
    },
    {
      "template": "id {org.id}",
      "expect": "id org1"
    },
    {
      "template": "{data.flag ?? 'x'}",
      "expect": false
    },
    {
      "template": "{data.missing ?? data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing ?? 'fallback'}",
      "expect": "fallback"
    }
  ],
  "body": [
    {
      "body": {
        "orgId": "{org.id}",
        "uid": "{params.uid}",
        "skip": "{data.missing}",
        "nested": {
          "on": "{data.perms[org.settings]}"
        },
        "empty": "{params.empty}"
      },
      "expect": {
        "orgId": "org1",
        "uid": "u2",
        "nested": {
          "on": true
        },
        "empty": ""
      }
    },
    {
      "body": {
        "scopes": {
          "$pick": {
            "b:write": "{data.flag}",
            "a:read": "{data.perms[org.settings]}",
            "c:x": "{'yes'}"
          }
        }
      },
      "expect": {
        "scopes": [
          "a:read",
          "c:x"
        ]
      }
    },
    {
      "body": {
        "a": {
          "$append": {
            "list": "{data.list}",
            "item": "z"
          }
        },
        "b": {
          "$append": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "c": {
          "$without": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "d": {
          "$append": {
            "list": "{data.missing}",
            "item": "q"
          }
        }
      },
      "expect": {
        "a": [
          "x",
          "y",
          "z"
        ],
        "b": [
          "x",
          "y"
        ],
        "c": [
          "y"
        ],
        "d": [
          "q"
        ]
      }
    },
    {
      "body": {
        "set": {
          "$put": {
            "map": "{data.access}",
            "key": "{params.uid}",
            "value": "viewer"
          }
        },
        "removed": {
          "$put": {
            "map": "{data.access}",
            "key": "h1",
            "value": ""
          }
        }
      },
      "expect": {
        "set": {
          "h1": "editor",
          "h2": "viewer",
          "u2": "viewer"
        },
        "removed": {
          "h2": "viewer"
        }
      }
    },
    {
      "body": {
        "pcts": {
          "$split": "{'50, 80.5, x'}"
        },
        "words": {
          "$split": "{'a, b,,c'}"
        }
      },
      "expect": {
        "pcts": [
          50,
          80.5,
          "x"
        ],
        "words": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "body": {
        "clear": null,
        "gone": "{data.missing}"
      },
      "expect": {
        "clear": null
      }
    },
    {
      "body": {
        "a": {
          "$if": {
            "when": "form.scope == org",
            "then": "{form.scope}"
          }
        },
        "b": {
          "$if": {
            "when": "form.scope == user",
            "then": true
          }
        },
        "c": {
          "$if": {
            "when": "form.scope == org",
            "then": {
              "$if": {
                "when": "form.scope == org,host",
                "then": true,
                "else": false
              }
            },
            "else": false
          }
        },
        "until": {
          "$afterHours": "{form.hours}"
        },
        "none": {
          "$afterHours": "{form.blank}"
        }
      },
      "expect": {
        "a": "org",
        "c": true,
        "until": 1790007200000
      }
    },
    {
      "body": {
        "types": {
          "$put": {
            "map": {},
            "key": "{params.uid}",
            "value": {
              "enabled": true
            }
          }
        }
      },
      "expect": {
        "types": {
          "u2": {
            "enabled": true
          }
        }
      }
    },
    {
      "body": {
        "quotas": {
          "$collect": {
            "prefix": "quota.",
            "as": "number"
          }
        },
        "features": {
          "$collect": {
            "prefix": "feature.",
            "as": "flag"
          }
        },
        "comp": {
          "$if": {
            "when": "form.scope == org",
            "then": "$null"
          }
        },
        "other": {
          "$if": {
            "when": "form.scope == user",
            "then": "$null"
          }
        }
      },
      "expect": {
        "quotas": {
          "hostLimit": 5,
          "typed": 12
        },
        "features": {
          "a": true,
          "b": false
        },
        "comp": null
      }
    }
  ],
  "condition": [
    {
      "when": "",
      "expect": true
    },
    {
      "when": "org.manager",
      "expect": true
    },
    {
      "when": "!org.manager",
      "expect": false
    },
    {
      "when": "staff.is",
      "expect": false
    },
    {
      "when": "org.manager && staff.is",
      "expect": false
    },
    {
      "when": "staff.is || org.manager",
      "expect": true
    },
    {
      "when": "org.role == admin",
      "expect": true
    },
    {
      "when": "org.role == owner,admin",
      "expect": true
    },
    {
      "when": "org.role != admin",
      "expect": false
    },
    {
      "when": "data.members[$id=params.uid].role != owner",
      "expect": true
    },
    {
      "when": "data.list",
      "expect": true
    },
    {
      "when": "data.flag",
      "expect": false
    }
  ]
}
