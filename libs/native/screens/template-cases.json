{
  "$comment": "Cases both renderers replay (AglynScreensTests, com.aglyn.screens ScreenValuesTest), so a spec reads the same on Apple and Kotlin. Dates print in UTC here.",
  "context": {
    "org": {
      "id": "org1",
      "name": "Acme",
      "role": "admin",
      "manager": true
    },
    "staff": {
      "is": false,
      "role": null
    },
    "params": {
      "uid": "u2",
      "empty": "",
      "col": "1",
      "mrow": "r1",
      "mcol": "c2"
    },
    "data": {
      "members": [
        {
          "$id": "u1",
          "email": "a@acme.test",
          "displayName": "Ada",
          "role": "owner",
          "count": 0
        },
        {
          "$id": "u2",
          "email": "b@acme.test",
          "displayName": "",
          "role": "editor",
          "joined": 1791331200
        }
      ],
      "perms": {
        "org.settings": true
      },
      "money": 123456,
      "currency": "eur",
      "bytes": 1572864,
      "ratio": 0.456,
      "when": "2026-10-07T15:04:00Z",
      "ts": {
        "_seconds": 1791385440
      },
      "flag": false,
      "list": [
        "x",
        "y"
      ],
      "big": 1234567.891,
      "access": {
        "h1": "editor",
        "h2": "viewer"
      },
      "hostKey": "h2",
      "addons": {
        "plan": "pro",
        "catalog": {
          "hosts": {
            "unitUsd": 5,
            "max": 20,
            "configured": true,
            "upgradeRequired": false
          },
          "aiAddon": {
            "unitUsd": null,
            "max": 0,
            "configured": false,
            "upgradeRequired": true
          }
        },
        "quantities": {
          "hosts": 2
        }
      },
      "kindKey": "hosts",
      "groups": [
        {
          "label": "Sequences",
          "items": [
            {
              "key": "outreach/a",
              "name": "Welcome"
            },
            {
              "key": "outreach/b"
            }
          ]
        },
        {
          "label": "Campaigns",
          "items": [
            {
              "key": "campaign/c"
            }
          ]
        },
        {
          "label": "Empty",
          "items": []
        }
      ],
      "pick": "y",
      "samples": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "d",
          "e",
          "f"
        ],
        [
          "g",
          "h"
        ]
      ],
      "matrix": {
        "r1": {
          "c1": "x",
          "c2": "y"
        }
      },
      "picklists": [
        {
          "fieldId": "status",
          "proposals": {
            "x": {
              "action": "leaveBlank"
            }
          }
        },
        {
          "fieldId": "tier",
          "proposals": {
            "gold": {
              "action": "mapTo",
              "valueId": "g"
            }
          }
        }
      ],
      "from": "2026-09",
      "monthKey": "2026-10",
      "badFrom": "true",
      "hundred": 100
    }
  },
  "render": [
    {
      "template": "Hi {data.members.0.displayName}",
      "expect": "Hi Ada"
    },
    {
      "template": "{data.members.1.displayName|data.members.1.email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.missing|'none'}",
      "expect": "none"
    },
    {
      "template": "{data.members.0.count|'n/a'}",
      "expect": "n/a"
    },
    {
      "template": "{data.members.0.count}",
      "expect": "0"
    },
    {
      "template": "{data.members[$id=params.uid].email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.perms[org.settings]:yesno}",
      "expect": "Yes"
    },
    {
      "template": "{data.money:cents}",
      "expect": "$1,234.56"
    },
    {
      "template": "{data.money:cents/data.currency}",
      "expect": "€1,234.56"
    },
    {
      "template": "{data.bytes:bytes}",
      "expect": "1.5 MB"
    },
    {
      "template": "{data.ratio:percent}",
      "expect": "45.6%"
    },
    {
      "template": "{data.when:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.when:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.ts:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.members.1.joined:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.flag:yesno}",
      "expect": "No"
    },
    {
      "template": "{data.list}",
      "expect": "x, y"
    },
    {
      "template": "{data.list:count} items",
      "expect": "2 items"
    },
    {
      "template": "{data.members.length}",
      "expect": "2"
    },
    {
      "template": "{data.big:number}",
      "expect": "1,234,567.89"
    },
    {
      "template": "{data.members.1.role:title}",
      "expect": "Editor"
    },
    {
      "template": "past_due",
      "expect": "past_due"
    },
    {
      "template": "{{literal}}",
      "expect": "{literal}}"
    },
    {
      "template": "{data.access[@data.hostKey]}",
      "expect": "viewer"
    },
    {
      "template": "{data.addons.catalog[@data.kindKey].unitUsd:dollars}/mo",
      "expect": "$5.00/mo"
    },
    {
      "template": "{data.addons.quantities[@data.kindKey]|'0'} of {data.addons.catalog[@data.kindKey].max}",
      "expect": "2 of 20"
    },
    {
      "template": "{data.missing + 1}",
      "expect": ""
    },
    {
      "template": "{data.money + data.bytes - 1:number}",
      "expect": "1,696,319"
    },
    {
      "template": "{data.big - 1000000:number}",
      "expect": "234,567.89"
    },
    {
      "template": "{data.members.*.count + 1}",
      "expect": "1"
    },
    {
      "template": "{data.members.*.joined}",
      "expect": "1791331200"
    },
    {
      "template": "{data.big - 1000000 + data.nothing?:number}",
      "expect": "234,567.89"
    },
    {
      "template": "{data.big - 1000000 + data.nothing:number}",
      "expect": ""
    },
    {
      "template": "{data.groups.*.items.*.key}",
      "expect": "outreach/a, outreach/b, campaign/c"
    },
    {
      "template": "{data.groups.*.label}",
      "expect": "Sequences, Campaigns, Empty"
    },
    {
      "template": "{data.groups[label='Campaigns'].items.0.key}",
      "expect": "campaign/c"
    },
    {
      "template": "{data.samples.*.[@params.col]}",
      "expect": "b, e, h"
    },
    {
      "template": "{data.matrix[@params.mrow][@params.mcol]}",
      "expect": "y"
    },
    {
      "template": "{data.groups[label='Missing'].items.0.key|'none'}",
      "expect": "none"
    },
    {
      "template": "{data.list:first1}",
      "expect": "x"
    },
    {
      "template": "{data.groups.*.items.*.key:first2}",
      "expect": "outreach/a, outreach/b"
    },
    {
      "template": "{data.access.*}",
      "expect": "editor, viewer"
    },
    {
      "template": "{data.money / 100}",
      "expect": "1234.56"
    },
    {
      "template": "{max(0, data.money - 200000)}",
      "expect": "0"
    },
    {
      "template": "{max(0, data.money - 100000) / 1000 * 2}",
      "expect": "46.912"
    },
    {
      "template": "{round(data.ratio * 100) / 100}",
      "expect": "0.46"
    },
    {
      "template": "{(data.money - 56) * 2}",
      "expect": "246800"
    },
    {
      "template": "{min(3, 2 + 5, data.money / 1000)}",
      "expect": "3"
    },
    {
      "template": "{ceil(data.ratio * 10)} {floor(data.ratio * 10)} {abs(0 - 5)}",
      "expect": "5 4 5"
    },
    {
      "template": "{data.missing * 2}",
      "expect": ""
    },
    {
      "template": "{data.money / 0}",
      "expect": ""
    },
    {
      "template": "{data.missing? * 2 + 1}",
      "expect": "1"
    },
    {
      "template": "{data.members.*.joined * 2}",
      "expect": "3582662400"
    },
    {
      "template": "{- data.hundred * 2 + 250}",
      "expect": "50"
    },
    {
      "template": "{round(data.money / 100):number}",
      "expect": "1,235"
    },
    {
      "template": "{data.hundred * 1.5:dollars}",
      "expect": "$150.00"
    },
    {
      "template": "{data.hundred * 0.00001:usd} {data.hundred * 0.5:usd}",
      "expect": "<$0.01 $50.00"
    }
  ],
  "url": [
    {
      "template": "/api/orgs/members?orgId={org.id}&q={data.members.0.email}",
      "expect": "/api/orgs/members?orgId=org1&q=a%40acme.test"
    }
  ],
  "resolve": [
    {
      "template": "{data.money}",
      "expect": 123456
    },
    {
      "template": "{data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing}",
      "expect": null
    },
    {
      "template": "id {org.id}",
      "expect": "id org1"
    },
    {
      "template": "{data.flag ?? 'x'}",
      "expect": false
    },
    {
      "template": "{data.missing ?? data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing ?? 'fallback'}",
      "expect": "fallback"
    }
  ],
  "body": [
    {
      "body": {
        "orgId": "{org.id}",
        "uid": "{params.uid}",
        "skip": "{data.missing}",
        "nested": {
          "on": "{data.perms[org.settings]}"
        },
        "empty": "{params.empty}"
      },
      "expect": {
        "orgId": "org1",
        "uid": "u2",
        "nested": {
          "on": true
        },
        "empty": ""
      }
    },
    {
      "body": {
        "scopes": {
          "$pick": {
            "b:write": "{data.flag}",
            "a:read": "{data.perms[org.settings]}",
            "c:x": "{'yes'}"
          }
        }
      },
      "expect": {
        "scopes": [
          "a:read",
          "c:x"
        ]
      }
    },
    {
      "body": {
        "a": {
          "$append": {
            "list": "{data.list}",
            "item": "z"
          }
        },
        "b": {
          "$append": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "c": {
          "$without": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "d": {
          "$append": {
            "list": "{data.missing}",
            "item": "q"
          }
        }
      },
      "expect": {
        "a": [
          "x",
          "y",
          "z"
        ],
        "b": [
          "x",
          "y"
        ],
        "c": [
          "y"
        ],
        "d": [
          "q"
        ]
      }
    },
    {
      "body": {
        "set": {
          "$put": {
            "map": "{data.access}",
            "key": "{params.uid}",
            "value": "viewer"
          }
        },
        "removed": {
          "$put": {
            "map": "{data.access}",
            "key": "h1",
            "value": ""
          }
        }
      },
      "expect": {
        "set": {
          "h1": "editor",
          "h2": "viewer",
          "u2": "viewer"
        },
        "removed": {
          "h2": "viewer"
        }
      }
    },
    {
      "body": {
        "pcts": {
          "$split": "{'50, 80.5, x'}"
        },
        "words": {
          "$split": "{'a, b,,c'}"
        }
      },
      "expect": {
        "pcts": [
          50,
          80.5,
          "x"
        ],
        "words": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "body": {
        "clear": null,
        "gone": "{data.missing}"
      },
      "expect": {
        "clear": null
      }
    },
    {
      "body": {
        "merged": {
          "$merge": [
            {
              "$index": {
                "rows": "data.picklists",
                "key": "{item.fieldId}",
                "value": "{item.proposals}"
              }
            },
            {
              "status": {
                "x": {
                  "action": "addValue"
                }
              }
            }
          ]
        }
      },
      "expect": {
        "merged": {
          "status": {
            "x": {
              "action": "addValue"
            }
          },
          "tier": {
            "gold": {
              "action": "mapTo",
              "valueId": "g"
            }
          }
        }
      }
    },
    {
      "body": {
        "a?": "{data.missing}",
        "b?": "",
        "c?": "{data.flag}",
        "d": "x",
        "e?": "{data.list}",
        "f?": "{org.name}",
        "g?": []
      },
      "expect": {
        "c": false,
        "d": "x",
        "e": [
          "x",
          "y"
        ],
        "f": "Acme"
      }
    }
  ],
  "condition": [
    {
      "when": "",
      "expect": true
    },
    {
      "when": "org.manager",
      "expect": true
    },
    {
      "when": "!org.manager",
      "expect": false
    },
    {
      "when": "staff.is",
      "expect": false
    },
    {
      "when": "org.manager && staff.is",
      "expect": false
    },
    {
      "when": "staff.is || org.manager",
      "expect": true
    },
    {
      "when": "org.role == admin",
      "expect": true
    },
    {
      "when": "org.role == owner,admin",
      "expect": true
    },
    {
      "when": "org.role != admin",
      "expect": false
    },
    {
      "when": "data.members[$id=params.uid].role != owner",
      "expect": true
    },
    {
      "when": "data.list",
      "expect": true
    },
    {
      "when": "data.flag",
      "expect": false
    },
    {
      "when": "data.addons.catalog[@data.kindKey].configured && !data.addons.catalog[@data.kindKey].upgradeRequired",
      "expect": true
    },
    {
      "when": "data.addons.catalog[@data.kindKey].upgradeRequired",
      "expect": false
    },
    {
      "when": "data.addons.plan == enterprise",
      "expect": false
    },
    {
      "when": "!data.addons.quantities[@data.kindKey]",
      "expect": false
    },
    {
      "when": "data.money > 100000",
      "expect": true
    },
    {
      "when": "data.money >= 123456",
      "expect": true
    },
    {
      "when": "data.money < data.bytes",
      "expect": true
    },
    {
      "when": "data.money <= 100",
      "expect": false
    },
    {
      "when": "data.missing > 1",
      "expect": false
    },
    {
      "when": "data.list ~= x",
      "expect": true
    },
    {
      "when": "data.list ~= z",
      "expect": false
    },
    {
      "when": "org.name ~= cm",
      "expect": true
    },
    {
      "when": "params.uid == @data.members.1.$id",
      "expect": true
    },
    {
      "when": "params.uid != @data.members.0.$id",
      "expect": true
    },
    {
      "when": "data.list !~= z",
      "expect": true
    },
    {
      "when": "data.list !~= x",
      "expect": false
    },
    {
      "when": "data.list ~= @data.pick",
      "expect": true
    },
    {
      "when": "data.list !~= @data.pick",
      "expect": false
    },
    {
      "when": "data.groups.*.label ~= @data.missing",
      "expect": false
    },
    {
      "when": "staff.is && org.manager || org.role == admin",
      "expect": true
    },
    {
      "when": "staff.is && org.manager || org.role == owner",
      "expect": false
    },
    {
      "when": "data.from <= data.monthKey",
      "expect": true
    },
    {
      "when": "data.monthKey <= data.from",
      "expect": false
    },
    {
      "when": "data.monthKey >= data.from",
      "expect": true
    },
    {
      "when": "data.missing <= data.monthKey",
      "expect": false
    },
    {
      "when": "data.from < 2026-10",
      "expect": true
    },
    {
      "when": "data.badFrom <= data.monthKey",
      "expect": false
    },
    {
      "when": "max(0, data.money - 100000) > 0",
      "expect": true
    },
    {
      "when": "max(0, data.money - 200000) > 0",
      "expect": false
    },
    {
      "when": "data.hundred + data.hundred >= 200",
      "expect": true
    },
    {
      "when": "data.hundred + data.hundred > data.money / 1000",
      "expect": true
    }
  ]
}
