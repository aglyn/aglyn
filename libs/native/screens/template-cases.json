{
  "$comment": "Cases both renderers replay (AglynScreensTests, com.aglyn.screens ScreenValuesTest), so a spec reads the same on Apple and Kotlin. Dates print in UTC here.",
  "context": {
    "org": {
      "id": "org1",
      "name": "Acme",
      "role": "admin",
      "manager": true
    },
    "staff": {
      "is": false,
      "role": null
    },
    "params": {
      "uid": "u2",
      "empty": ""
    },
    "data": {
      "members": [
        {
          "$id": "u1",
          "email": "a@acme.test",
          "displayName": "Ada",
          "role": "owner",
          "count": 0
        },
        {
          "$id": "u2",
          "email": "b@acme.test",
          "displayName": "",
          "role": "editor",
          "joined": 1791331200
        }
      ],
      "perms": {
        "org.settings": true
      },
      "money": 123456,
      "currency": "eur",
      "bytes": 1572864,
      "ratio": 0.456,
      "when": "2026-10-07T15:04:00Z",
      "ts": {
        "_seconds": 1791385440
      },
      "flag": false,
      "list": [
        "x",
        "y"
      ],
      "big": 1234567.891,
      "access": {
        "h1": "editor",
        "h2": "viewer"
      },
      "hostKey": "h2",
      "addons": {
        "plan": "pro",
        "catalog": {
          "hosts": {
            "unitUsd": 5,
            "max": 20,
            "configured": true,
            "upgradeRequired": false
          },
          "aiAddon": {
            "unitUsd": null,
            "max": 0,
            "configured": false,
            "upgradeRequired": true
          }
        },
        "quantities": {
          "hosts": 2
        }
      },
      "kindKey": "hosts",
      "holds": {
        "b": {
          "expiresAtMs": 4102444800000
        },
        "a": {
          "expiresAtMs": 1000
        }
      },
      "stub": {
        "num": 1042,
        "id": "abcdef123456",
        "day": 1791590400000,
        "recent": 0,
        "one": 1
      },
      "qty": [
        2,
        1,
        3
      ]
    }
  },
  "render": [
    {
      "template": "Hi {data.members.0.displayName}",
      "expect": "Hi Ada"
    },
    {
      "template": "{data.members.1.displayName|data.members.1.email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.missing|'none'}",
      "expect": "none"
    },
    {
      "template": "{data.members.0.count|'n/a'}",
      "expect": "n/a"
    },
    {
      "template": "{data.members.0.count}",
      "expect": "0"
    },
    {
      "template": "{data.members[$id=params.uid].email}",
      "expect": "b@acme.test"
    },
    {
      "template": "{data.perms[org.settings]:yesno}",
      "expect": "Yes"
    },
    {
      "template": "{data.money:cents}",
      "expect": "$1,234.56"
    },
    {
      "template": "{data.money:cents/data.currency}",
      "expect": "€1,234.56"
    },
    {
      "template": "{data.bytes:bytes}",
      "expect": "1.5 MB"
    },
    {
      "template": "{data.ratio:percent}",
      "expect": "45.6%"
    },
    {
      "template": "{data.when:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.when:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.ts:datetime}",
      "expect": "Oct 7, 2026, 3:04 PM"
    },
    {
      "template": "{data.members.1.joined:date}",
      "expect": "Oct 7, 2026"
    },
    {
      "template": "{data.flag:yesno}",
      "expect": "No"
    },
    {
      "template": "{data.list}",
      "expect": "x, y"
    },
    {
      "template": "{data.list:count} items",
      "expect": "2 items"
    },
    {
      "template": "{data.members.length}",
      "expect": "2"
    },
    {
      "template": "{data.big:number}",
      "expect": "1,234,567.89"
    },
    {
      "template": "{data.members.1.role:title}",
      "expect": "Editor"
    },
    {
      "template": "past_due",
      "expect": "past_due"
    },
    {
      "template": "{{literal}}",
      "expect": "{literal}}"
    },
    {
      "template": "{data.access[@data.hostKey]}",
      "expect": "viewer"
    },
    {
      "template": "{data.members.*.email}",
      "expect": "a@acme.test, b@acme.test"
    },
    {
      "template": "{data.members.*.joined}",
      "expect": "1791331200"
    },
    {
      "template": "{data.money:amount}",
      "expect": "1234.56"
    },
    {
      "template": "{data.missing:amount}",
      "expect": ""
    },
    {
      "template": "{data.addons.catalog[@data.kindKey].unitUsd:dollars}/mo",
      "expect": "$5.00/mo"
    },
    {
      "template": "{data.addons.quantities[@data.kindKey]|'0'} of {data.addons.catalog[@data.kindKey].max}",
      "expect": "2 of 20"
    },
    {
      "template": "{?org.manager && !staff.is}",
      "expect": "true"
    },
    {
      "template": "{?data.perms.missing || org.role == viewer}",
      "expect": "false"
    },
    {
      "template": "{data.hostKey:code}",
      "expect": "H2"
    },
    {
      "template": "{data.members.0.displayName:token}",
      "expect": "ada"
    },
    {
      "template": "{data.big:sum}",
      "expect": "0"
    },
    {
      "template": "{data.holds.*.expiresAtMs:ahead}",
      "expect": "1"
    },
    {
      "template": "{data.access.*:count}",
      "expect": "2"
    },
    {
      "template": "{data.holds.*.expiresAtMs:count}",
      "expect": "2"
    },
    {
      "template": "{data.hostKey:code/1}",
      "expect": "H"
    },
    {
      "template": "{data.hostKey:code/9}",
      "expect": "H2"
    },
    {
      "template": "{data.stub.num:ordernumber/data.stub.id}",
      "expect": "#1042"
    },
    {
      "template": "{data.stub.missing:ordernumber/data.stub.id}",
      "expect": "#123456"
    },
    {
      "template": "{data.stub.id:upper}",
      "expect": "ABCDEF123456"
    },
    {
      "template": "{data.stub.nothing:ordernumber/data.stub.none}",
      "expect": "#—"
    },
    {
      "template": "{data.stub.num:plural/item}",
      "expect": "1042 items"
    },
    {
      "template": "{data.stub.recent:plural/item}",
      "expect": "0 items"
    },
    {
      "template": "{data.stub.day:isodate}",
      "expect": "2026-10-10"
    },
    {
      "template": "{data.stub.nothing:isodate}",
      "expect": "—"
    },
    {
      "template": "{data.stub.num:minus/data.stub.day}",
      "expect": "0"
    },
    {
      "template": "{data.stub.day:minus/data.stub.num}",
      "expect": "1791590398958"
    },
    {
      "template": "{data.stub.nothing:ago}",
      "expect": "—"
    },
    {
      "template": "{data.stub.num:minus/data.stub.recent}",
      "expect": "1042"
    },
    {
      "template": "{data.stub.one:plural/item}",
      "expect": "1 item"
    },
    {
      "template": "{data.hostKey:take/1}",
      "expect": "h"
    },
    {
      "template": "{data.money:lesscents/data.stub.num}",
      "expect": "$1,224.14"
    },
    {
      "template": "{data.stub.num:lesscents/data.money}",
      "expect": "$0.00"
    },
    {
      "template": "{data.list:plural/x}",
      "expect": "0 xs"
    },
    {
      "template": "{data.qty:plural/item}",
      "expect": "6 items"
    }
  ],
  "url": [
    {
      "template": "/api/orgs/members?orgId={org.id}&q={data.members.0.email}",
      "expect": "/api/orgs/members?orgId=org1&q=a%40acme.test"
    }
  ],
  "resolve": [
    {
      "template": "{data.money}",
      "expect": 123456
    },
    {
      "template": "{data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing}",
      "expect": null
    },
    {
      "template": "id {org.id}",
      "expect": "id org1"
    },
    {
      "template": "{data.flag ?? 'x'}",
      "expect": false
    },
    {
      "template": "{data.missing ?? data.flag}",
      "expect": false
    },
    {
      "template": "{data.missing ?? 'fallback'}",
      "expect": "fallback"
    }
  ],
  "body": [
    {
      "body": {
        "orgId": "{org.id}",
        "uid": "{params.uid}",
        "skip": "{data.missing}",
        "nested": {
          "on": "{data.perms[org.settings]}"
        },
        "empty": "{params.empty}"
      },
      "expect": {
        "orgId": "org1",
        "uid": "u2",
        "nested": {
          "on": true
        },
        "empty": ""
      }
    },
    {
      "body": {
        "scopes": {
          "$pick": {
            "b:write": "{data.flag}",
            "a:read": "{data.perms[org.settings]}",
            "c:x": "{'yes'}"
          }
        }
      },
      "expect": {
        "scopes": [
          "a:read",
          "c:x"
        ]
      }
    },
    {
      "body": {
        "a": {
          "$append": {
            "list": "{data.list}",
            "item": "z"
          }
        },
        "b": {
          "$append": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "c": {
          "$without": {
            "list": "{data.list}",
            "item": "x"
          }
        },
        "d": {
          "$append": {
            "list": "{data.missing}",
            "item": "q"
          }
        }
      },
      "expect": {
        "a": [
          "x",
          "y",
          "z"
        ],
        "b": [
          "x",
          "y"
        ],
        "c": [
          "y"
        ],
        "d": [
          "q"
        ]
      }
    },
    {
      "body": {
        "set": {
          "$put": {
            "map": "{data.access}",
            "key": "{params.uid}",
            "value": "viewer"
          }
        },
        "removed": {
          "$put": {
            "map": "{data.access}",
            "key": "h1",
            "value": ""
          }
        }
      },
      "expect": {
        "set": {
          "h1": "editor",
          "h2": "viewer",
          "u2": "viewer"
        },
        "removed": {
          "h2": "viewer"
        }
      }
    },
    {
      "body": {
        "pcts": {
          "$split": "{'50, 80.5, x'}"
        },
        "words": {
          "$split": "{'a, b,,c'}"
        },
        "lines": {
          "$split": "{'a\nb, c'}"
        }
      },
      "expect": {
        "pcts": [
          50,
          80.5,
          "x"
        ],
        "words": [
          "a",
          "b",
          "c"
        ],
        "lines": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "body": {
        "clear": null,
        "gone": "{data.missing}"
      },
      "expect": {
        "clear": null
      }
    },
    {
      "body": {
        "swapped": {
          "$replace": {
            "list": "{data.members}",
            "key": "$id",
            "match": "{params.uid}",
            "value": {
              "$id": "{params.uid}",
              "role": "viewer"
            }
          }
        }
      },
      "expect": {
        "swapped": [
          {
            "$id": "u1",
            "email": "a@acme.test",
            "displayName": "Ada",
            "role": "owner",
            "count": 0
          },
          {
            "$id": "u2",
            "role": "viewer"
          }
        ]
      }
    },
    {
      "body": {
        "c1": {
          "$cents": "12.50"
        },
        "c2": {
          "$cents": "$1,200"
        },
        "c3": {
          "$cents": ".5"
        },
        "c4": {
          "$cents": "abc"
        },
        "c5": {
          "$cents": "7"
        }
      },
      "expect": {
        "c1": 1250,
        "c2": 120000,
        "c3": 50,
        "c5": 700
      }
    },
    {
      "body": {
        "rows": {
          "$gather": {
            "from": {
              "restock_10": "2",
              "restock_2": "1",
              "note": "x"
            },
            "prefix": "restock_",
            "key": "lineItemId",
            "value": "quantity"
          }
        }
      },
      "expect": {
        "rows": [
          {
            "lineItemId": 10,
            "quantity": "2"
          },
          {
            "lineItemId": 2,
            "quantity": "1"
          }
        ]
      }
    },
    {
      "body": {
        "rows": {
          "$gather": {
            "from": {
              "qty_0": 2,
              "qty_1": 0,
              "qty_2": 1,
              "reason_0": "damaged",
              "reason_1": "other",
              "reason_2": "size_or_fit"
            },
            "prefix": "qty_",
            "key": "lineItemId",
            "value": "quantity",
            "with": {
              "reason": "reason_"
            },
            "skipEmpty": true
          }
        }
      },
      "expect": {
        "rows": [
          {
            "lineItemId": 0,
            "quantity": 2,
            "reason": "damaged"
          },
          {
            "lineItemId": 2,
            "quantity": 1,
            "reason": "size_or_fit"
          }
        ]
      }
    },
    {
      "body": {
        "slug": {
          "$slug": "Café Latte"
        },
        "parent": {
          "$orNull": "{params.empty}"
        },
        "kept": {
          "$orNull": "{params.uid}"
        },
        "swapped": {
          "$replace": {
            "list": "{data.list}",
            "key": "*",
            "match": "y",
            "value": "z"
          }
        }
      },
      "expect": {
        "slug": "cafe-latte",
        "parent": null,
        "kept": "u2",
        "swapped": [
          "x",
          "z"
        ]
      }
    },
    {
      "body": {
        "s": {
          "$dateMs": {
            "value": "2026-10-09",
            "time": "23:59:59"
          }
        },
        "e": {
          "$dateMs": {
            "value": "",
            "time": "00:00:00"
          }
        },
        "n": {
          "$orNull": {
            "$dateMs": {
              "value": "nope"
            }
          }
        }
      },
      "expect": {
        "s": 1791590399000,
        "n": null
      }
    }
  ],
  "condition": [
    {
      "when": "",
      "expect": true
    },
    {
      "when": "org.manager",
      "expect": true
    },
    {
      "when": "!org.manager",
      "expect": false
    },
    {
      "when": "staff.is",
      "expect": false
    },
    {
      "when": "org.manager && staff.is",
      "expect": false
    },
    {
      "when": "staff.is || org.manager",
      "expect": true
    },
    {
      "when": "org.role == admin",
      "expect": true
    },
    {
      "when": "org.role == owner,admin",
      "expect": true
    },
    {
      "when": "org.role != admin",
      "expect": false
    },
    {
      "when": "data.members[$id=params.uid].role != owner",
      "expect": true
    },
    {
      "when": "data.list",
      "expect": true
    },
    {
      "when": "data.flag",
      "expect": false
    },
    {
      "when": "data.hostKey == @params.uid",
      "expect": false
    },
    {
      "when": "data.hostKey != @params.uid",
      "expect": true
    },
    {
      "when": "params.uid == @params.uid",
      "expect": true
    },
    {
      "when": "data.money < 200000",
      "expect": true
    },
    {
      "when": "data.money > 200000",
      "expect": false
    },
    {
      "when": "data.money <= @data.money",
      "expect": true
    },
    {
      "when": "data.money < @data.money",
      "expect": false
    },
    {
      "when": "data.money < @data.money+1d",
      "expect": true
    },
    {
      "when": "data.money > @data.money-1h",
      "expect": true
    },
    {
      "when": "data.money < @data.money-1d",
      "expect": false
    },
    {
      "when": "data.missing < 5",
      "expect": false
    },
    {
      "when": "data.money > 100 && data.money < 200000",
      "expect": true
    },
    {
      "when": "data.addons.catalog[@data.kindKey].configured && !data.addons.catalog[@data.kindKey].upgradeRequired",
      "expect": true
    },
    {
      "when": "data.addons.catalog[@data.kindKey].upgradeRequired",
      "expect": false
    },
    {
      "when": "data.addons.plan == enterprise",
      "expect": false
    },
    {
      "when": "!data.addons.quantities[@data.kindKey]",
      "expect": false
    },
    {
      "when": "data.holds.*.expiresAtMs > 4000000000000",
      "expect": true
    },
    {
      "when": "data.holds.*.expiresAtMs > 5000000000000",
      "expect": false
    },
    {
      "when": "data.holds.*.expiresAtMs < 5000",
      "expect": true
    },
    {
      "when": "data.nothing.*.expiresAtMs > 5",
      "expect": false
    }
  ]
}
