      "scope": "site",
      "expect": { "mode": "main", "area": { "row": "orders", "screen": "commerce.reservations", "params": {} }, "pushed": [], "opensSection": true, "starredRowStays": true },
      "entries": [
        { "via": "link", "link": "/acme/hosts/shop/products/reservations" },
        { "via": "aglyn", "link": "aglyn://acme/hosts/shop/products/reservations" },
        { "via": "notification", "link": "/h1/products/reservations", "orgSlug": "acme", "hostId": "h1", "hostSubdomain": "shop" },
        { "via": "starred", "item": { "kind": "screen", "id": "orders", "orgId": "org-acme", "hostId": "h1", "label": "Reservations", "screen": "commerce.reservations" } },
        { "via": "searchScreen", "rowId": "site.orders.reservations", "screen": "commerce.reservations", "inSite": true }
      ]
    },
    {
