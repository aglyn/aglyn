{
  "about": "AGL-4059: every way into a place opens the same path as a link to it (the sidebar's mode, the area row or section, then each screen pushed over it). Replayed by libs/native/apple/Tests/AglynCoreTests/NavPathTests.swift and libs/native/kotlin/shell/src/desktopTest/kotlin/com/aglyn/shell/NavPathCasesTest.kt against the real nav manifest. Routes are the console paths the platform, the spec screens and the plugins register; staff is the staff list (its rows are the staff spec screens). Each case also names the scope every entry opens on (site, workspace: the whole workspace, leaving a site on screen; unchanged: where the window stands) whether the area is one of its row's sections (pushed over the row's own place on a pinned phone tab), and whether a Starred row it was opened from stays selected (only in the everyday list; a setting selects its own row). An entry's via: link (a console path), universal (https), aglyn, notification and push (a stored link, put in the console's form by notificationLink), search (a record row's link), starred and recent (account items), searchScreen (a screens-and-settings row: its id and screen, in the scope in use).",
  "routes": [
    { "path": "/hosts", "screen": "site.sites" },
    { "path": "/screens", "screen": "site.pages" },
    { "path": "/screens/list", "screen": "site.pages" },
    { "path": "/screens/:screenId", "screen": "site.pages" },
    { "path": "/screens/:screenId/versions/:versionId/view", "screen": "site.pages" },
    { "path": "/media", "screen": "site.media" },
    { "path": "/setup", "screen": "site.setup" },
    { "path": "/setup/:section", "screen": "site.setup" },
    { "path": "/theme", "screen": "site.theme" },
    { "path": "/products", "screen": "commerce.products" },
    { "path": "/products/orders", "screen": "commerce.orders" },
    { "path": "/products/orders?order=:orderId", "screen": "commerce.order" },
    { "path": "/products/orders?quote=:quote", "screen": "commerce.quote" },
    { "path": "/products/returns", "screen": "commerce.returns" },
    { "path": "/products/returns?return=:returnId", "screen": "commerce.return" },
    { "path": "/products/reservations", "screen": "commerce.reservations" },
    { "path": "/crm", "screen": "crm.contacts" },
    { "path": "/crm/contacts", "screen": "crm.contacts" },
    { "path": "/crm/leads", "screen": "crm.leads" },
    { "path": "/crm/leads/:lead", "screen": "crm.lead" },
    { "path": "/inbox", "screen": "inbox.submissions" },
    { "path": "/inbox/campaigns", "screen": "marketing.campaigns" },
    { "path": "/marketing", "screen": "marketing.overview" },
    { "path": "/marketing/campaigns", "screen": "marketing.campaigns" },
    { "path": "/marketing/campaigns/:campaign", "screen": "marketing.campaigns" },
    { "path": "/marketplace", "screen": "marketplace.browse" },
    { "path": "/marketplace/browse", "screen": "marketplace.browse" },
    { "path": "/marketplace/:section(profile|listings|payouts|sales)", "screen": "marketplace.sell" },
    { "path": "/marketplace/:listingId(!upload)", "screen": "marketplace.listing" },
    { "path": "/settings", "screen": "core.settings" },
    { "path": "/settings/sso", "screen": "core.settings.sso" },
    { "path": "/team", "screen": "core.team" },
    { "path": "/team/:uid", "screen": "core.team.member" },
    { "path": "/team/roles", "screen": "core.team.roles" },
    { "path": "/ai-jobs", "screen": "ai.jobs" },
    { "path": "/ai-jobs/:jobId", "screen": "ai.job" },
    { "path": "/admin/orgs", "screen": "core.staff.orgs" },
    { "path": "/admin/orgs/:orgId", "screen": "core.staff.org" }
  ],
  "staff": ["core.staff.orgs"],
  "cases": [
    {
      "name": "an order: the site's Orders, then the order",
      "scope": "site",
      "expect": { "mode": "main", "area": { "row": "orders", "screen": "commerce.orders", "params": {} }, "pushed": [{ "screen": "commerce.order", "params": { "order": "o1", "orderId": "o1" } }], "opensSection": false, "starredRowStays": true },
      "entries": [
        { "via": "link", "link": "/acme/hosts/shop/products/orders?order=o1" },
        { "via": "universal", "link": "https://console.example.com/acme/hosts/shop/products/orders?order=o1#items" },
        { "via": "aglyn", "link": "aglyn://acme/hosts/shop/products/orders?order=o1" },
        { "via": "notification", "link": "/h1/products/orders?order=o1", "orgSlug": "acme", "hostId": "h1", "hostSubdomain": "shop" },
        { "via": "push", "link": "/h1/products/orders?order=o1", "orgSlug": "acme", "hostId": "h1", "hostSubdomain": "shop" },
        { "via": "search", "link": "/acme/hosts/shop/products/orders?order=o1" },
        { "via": "starred", "item": { "kind": "order", "id": "o1", "orgId": "org-acme", "hostId": "h1", "label": "Order 1042", "screen": "commerce.order", "params": { "orderId": "o1" } } },
        { "via": "recent", "item": { "kind": "record", "id": "screen:commerce.order?orderId=o1", "orgId": "org-acme", "hostId": "h1", "label": "Order 1042", "screen": "commerce.order", "params": { "orderId": "o1" } } }
      ]
    },
    {
