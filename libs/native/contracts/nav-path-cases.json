        { "via": "recent", "item": { "kind": "record", "id": "screen:site.pages?screenId=s1&versionId=v1", "orgId": "org-acme", "hostId": "h1", "label": "Spring menu", "screen": "site.pages", "params": { "screenId": "s1", "versionId": "v1" } } }
