{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cli/src",
  "projectType": "library",
  "tags": [
    "scope:lib",
    "scope:cli"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/cli",
        "main": "libs/cli/src/index.ts",
        "additionalEntryPoints": [
          "libs/cli/src/bin.ts"
        ],
        "tsConfig": "libs/cli/tsconfig.lib.json",
        "assets": [
          "libs/cli/*.md"
        ]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build"
        }
      ],
      "options": {
        "command": "node tools/scripts/publish.mjs cli {args.ver} {args.tag}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/cli/jest.config.ts"
      }
    }
  }
}
