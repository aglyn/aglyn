{
  "name": "shared-util-dom",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/util/dom/src",
  "projectType": "library",
  "tags": ["scope:lib", "scope:shared", "scope:util", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/util/dom",
        "main": "libs/shared/util/dom/src/index.ts",
        "tsConfig": "libs/shared/util/dom/tsconfig.lib.json",
        "assets": ["libs/shared/util/dom/*.md"]
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest"]
        }
      ]
    }
  }
}
