{
  "name": "shared-ui-jsx",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/jsx/src",
  "projectType": "library",
  "tags": ["scope:lib", "scope:shared", "scope:ui", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/ui/jsx",
        "main": "libs/shared/ui/jsx/src/index.ts",
        "tsConfig": "libs/shared/ui/jsx/tsconfig.lib.json",
        "assets": ["libs/shared/ui/jsx/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "babel-jest"]
        }
      ]
    }
  }
}
