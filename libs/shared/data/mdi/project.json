{
  "name": "shared-data-mdi",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/data/mdi",
  "projectType": "library",
  "tags": ["scope:lib", "scope:shared", "scope:data", "type:data"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/data/mdi",
        "main": "libs/shared/data/mdi/src/index.ts",
        "tsConfig": "libs/shared/data/mdi/tsconfig.lib.json",
        "assets": [
          "libs/shared/data/mdi/*.md",
          {
            "input": "libs/shared/data/mdi/generated/6.5.95",
            "glob": "*.json",
            "output": "generated/6.5.95"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/shared/data/mdi"],
      "options": {
        "jestConfig": "libs/shared/data/mdi/jest.config.ts"
      }
    }
  }
}
