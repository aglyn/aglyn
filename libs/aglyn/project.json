{
  "name": "aglyn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/aglyn/src",
  "projectType": "library",
  "tags": [
    "scope:lib",
    "scope:aglyn",
    "scope:data",
    "scope:feature",
    "aglyn:framework",
    "scope:core",
    "type:data",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/aglyn",
        "main": "libs/aglyn/src/index.ts",
        "tsConfig": "libs/aglyn/tsconfig.lib.json",
        "assets": ["libs/aglyn/*.md"]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build"
        }
      ],
      "options": {
        "command": "node tools/scripts/publish.mjs aglyn {args.ver} {args.tag}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "babel-jest"]
        }
      ]
    }
  }
}
