{
  "name": "@aglyn/aglyn-node-renderer",
  "version": "1.0.0-beta.128",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/lib/*.d.ts",
      "default": "./src/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "sideEffects": false
}
