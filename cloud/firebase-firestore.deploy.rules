function hostMemberRole(hostId) {
return get(/databases/$(database)/documents/hosts/$(hostId))
.data.get('memberRoles', {}).get(request.auth.uid, null);
}



















function isHostMember(hostId) {
return isSignedIn() && hostMemberRole(hostId) != null;
}
















function canWriteHostContent(hostId) {
return isVerified() &&
hostMemberRole(hostId) in ['admin', 'editor', 'author'];
}






































function canPublishHostContent(hostId) {
return isVerified() && hostMemberRole(hostId) in ['admin', 'editor'];
}




function routeRemovalAllowed() {
let d = request.resource.data.get('screens', {})
.diff(resource.data.get('screens', {}));
let r = d.removedKeys();
return r.size() == 0 || (r.size() == 1 &&
(d.affectedKeys().size() == 1 ||
(r.hasOnly([resource.data.get('defaultHomeScreenId', '')]) &&
!('defaultHomeScreenId' in request.resource.data))));
}
















function canReadHostSensitive(hostId) {
return isSignedIn() && hostMemberRole(hostId) in ['admin', 'editor'];
}








































function suspensionActive(carrier) {
return lockWindowActive(
carrier.get('suspendedAt', null) != null,
carrier.get('suspendedUntilMs', null));
}



















function lockWindowActive(placed, untilMs) {
return placed &&
!(untilMs is number && untilMs <= request.time.toMillis());
}


































function platformLockdownActive() {
return exists(/databases/$(database)/documents/lockdowns/platform) &&
lockWindowActive(
true,
get(/databases/$(database)/documents/lockdowns/platform)
.data.get('untilMs', null));
}



function orgSuspendedById(orgId) {
return orgId != null &&
exists(/databases/$(database)/documents/orgs/$(orgId)) &&
suspensionActive(
get(/databases/$(database)/documents/orgs/$(orgId)).data);
}
function hostOrgSuspended(hostId) {
return orgSuspendedById(
get(/databases/$(database)/documents/hosts/$(hostId))
.data.get('orgId', null));
}





























function hostSuspended(hostId) {
return suspensionActive(
get(/databases/$(database)/documents/hosts/$(hostId)).data);
}











function hostWritesFrozen(hostId) {
return hostSuspended(hostId) || hostOrgSuspended(hostId) ||
platformLockdownActive();
}
match /hosts/{hostId} {


allow read: if isStaff() || (isSignedIn() &&
resource.data.get('memberRoles', {}).get(request.auth.uid, null) != null);


allow create: if false;










































































allow update: if isStaff() ||
(canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['memberRoles', 'memberPermissions', 'orgId', 'admins',
'hosts', 'subdomain',
'cname', 'cnameAttachmentPending',
'cnameDetachmentPending', 'themeInstalledFrom',
'suspendedAt', 'suspendedReasonCode', 'suspendedMessage',
'suspendedUntilMs', 'suspendedMode', 'suspendedEnforcement',
'suspended', 'bandwidthCeiling',



'starterProvisionedAt',




'funnelRecording',















'sendingDomain', 'sendingLocalPart',
















'sendingLabel', 'sendingDomainRequestedAtMs',
'sendingDomainRequestedBy',
'projectId', 'projectNumber']) &&




































(hostMemberRole(hostId) == 'admin' ||
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['disabledPlugins', 'enabledPlugins', 'authScreens',
'approvedImageHosts', 'approvedMediaHosts',
'approvedFontHosts', 'approvedFormActions',
'approvedConnectHosts', 'approvedFrameHosts'])) &&












(canPublishHostContent(hostId) ||
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['screens', 'defaultHomeScreenId'])) &&
routeRemovalAllowed());
allow delete: if isStaff() ||
(hostMemberRole(hostId) == 'admin' && isVerified() &&
!hostWritesFrozen(hostId));



































































