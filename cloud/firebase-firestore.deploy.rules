}








match /aiJobs/{jobId} {
allow read: if isStaff() || isOrgMember();
allow write: if false;
}

































function canReadOutreach() {
return isOrgWideMember() &&
(memberStamps('outreach.use') ||
(orgMember().role in ['owner', 'admin'] &&
memberResolves('outreach.use'))) &&
orgCarriesOutreach(orgId);
}










match /shippingAccounts/{accountId} {
allow read, write: if false;
}
