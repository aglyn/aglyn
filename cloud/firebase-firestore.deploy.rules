function crmWriteScope() {
return resource.data.get('writeTo', resource.data.visibleTo);
}
function canWriteScopedCrm() {
return canWriteOrgData() &&
(isOrgWideMember() ||
(isOrgMember() &&
crmWriteScope().hasAny(orgMember().get('scopeTokens', ['org']))));
}
function crmHeldScope() {
return resource.data.visibleTo.removeAll(
resource.data.get(['sharing', 'added'], []));
}
function crmSharingUnchanged() {
return !request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['sharing', 'writeTo']);
}
function crmSharingAbsent() {
return !request.resource.data.keys().hasAny(['sharing', 'writeTo']);
}






function scopeUnchanged() {
return !request.resource.data.diff(resource.data)
.affectedKeys().hasAny(['visibleTo']);
}






function canCreateScoped() {
return isOrgWideMember() ||
request.resource.data.visibleTo.hasAny(orgMember().get('scopeTokens', ['org']));
}















function crmMediaIdsOk() {
return !('mediaIds' in request.resource.data) ||
(request.resource.data.mediaIds is list &&
request.resource.data.mediaIds.size() <= 20);
}
















match /datasets/{datasetId} {
allow read: if isStaff() || canReadScoped();
allow create: if isStaff();
allow update: if isStaff() ||
(canWriteScopedOrgDatasets() && (isOrgWideMember() || scopeUnchanged()));
allow delete: if isStaff();
match /records/{recordId} {









function parentDatasetVisible() {
return isOrgWideMember() ||
(isOrgMember() &&
get(/databases/$(database)/documents/orgs/$(orgId)/datasets/$(datasetId))
.data.visibleTo
.hasAny(orgMember().get('scopeTokens', ['org'])));
}
allow read: if isStaff() || parentDatasetVisible();
allow create: if isStaff();
allow update, delete: if isStaff() ||
(canWriteOrgDatasets() && parentDatasetVisible());
}
}




















































