rules_version = '2'; // GENERATED from firebase-firestore.rules by `npm run generate:rules-deploy`; edit that file, never this one (AGL-3544).




service cloud.firestore {
match /databases/{database}/documents {
function isSignedIn() { return request.auth != null; }



































































function isVerified() {
return isSignedIn() &&
(request.auth.token.get('email_verified', false) == true ||
isImpersonating());
}














function isImpersonating() {
return isSignedIn() &&
request.auth.token.get('impersonatedBy', '') is string &&
request.auth.token.get('impersonatedBy', '') != '';
}



















function isStaff() {
return isSignedIn() && request.auth.token.get('staff', false) == true;
}









function staffRole() {
return request.auth.token.get('staffRole', 'support');
}
function isBillingStaff() {
return isStaff() && (staffRole() == 'super' || staffRole() == 'billing');
}
function isSuperStaff() { return isStaff() && staffRole() == 'super'; }



































































































function mediaObjectFieldsUnset() {
return !request.resource.data.keys().hasAny([
'storagePath', 'private', 'cdnPath', 'url', 'contentType',
'contentHash', 'contentSha256', 'sizeBytes', 'variants',
'variantsError', 'svgSanitized', 'uploadedBy', 'createdAt',
'video', 'poster', 'posterError', 'videoRenditions',
'deliveryCopies', 'embeddedMetadata', 'variantEncoderVersion',
'display', 'variantRegeneration']);
}
function mediaObjectFieldsUnchanged() {
return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
'storagePath', 'private', 'cdnPath', 'url', 'contentType',
'contentHash', 'contentSha256', 'sizeBytes', 'variants',
'variantsError', 'svgSanitized', 'uploadedBy', 'createdAt',
'video', 'poster', 'posterError', 'videoRenditions',
'deliveryCopies', 'embeddedMetadata', 'variantEncoderVersion',
'display', 'variantRegeneration']);
}





















function orgCarriesCrmSuite(orgId) {
return orgId != null &&
exists(/databases/$(database)/documents/orgs/$(orgId)) &&
crmSuiteCarried(get(/databases/$(database)/documents/orgs/$(orgId)).data);
}
function crmSuiteCarried(org) {
return crmSuiteOverride(org) == true ||
(crmSuiteOverride(org) == null &&
((org.get('plan', 'free') in
['starter', 'pro', 'business', 'scale', 'advanced', 'agency', 'enterprise'] &&
!(orgSubscriptionStatus(org) in
['canceled', 'unpaid', 'incomplete', 'incomplete_expired'])) ||
(orgPlanComp(org) in
['starter', 'pro', 'business', 'scale', 'advanced', 'agency', 'enterprise'] &&
orgSubscriptionStatus(org) in
['', 'canceled', 'unpaid', 'incomplete', 'incomplete_expired'])));
}
function crmSuiteOverride(org) {
return org.get('entitlements', {}) is map &&
org.get('entitlements', {}).get('features', {}) is map
? org.get('entitlements', {}).get('features', {}).get('crm', null)
: null;
}
function orgPlanComp(org) {
return org.get('entitlements', {}) is map &&
org.get('entitlements', {}).get('planComp', {}) is map
? org.get('entitlements', {}).get('planComp', {}).get('plan', '')
: '';
}
function orgSubscriptionStatus(org) {
return org.get('billingStatus', '') is string && org.get('billingStatus', '') != ''
? org.get('billingStatus', '')
: (org.get('subscription', {}) is map
? org.get('subscription', {}).get('status', '')
: '');
}





























function orgCarriesOutreach(orgId) {
return orgId != null &&
exists(/databases/$(database)/documents/orgs/$(orgId)) &&
outreachOverride(get(/databases/$(database)/documents/orgs/$(orgId)).data) == true;
}
function outreachOverride(org) {
return org.get('entitlements', {}) is map &&
org.get('entitlements', {}).get('features', {}) is map
? org.get('entitlements', {}).get('features', {}).get('outreach', null)
: null;
}







match /orgs/{orgId} {
function isOrgMember() {
return isSignedIn() &&
exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
}
function orgMember() {
return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
}
function canManageOrg() {
return isOrgMember() && orgMember().role in ['owner', 'admin'];
}
















function isOrgWideMember() {
return isOrgMember() &&
(orgMember().role in ['owner', 'admin'] ||
orgMember().get('allHosts', false) == true);
}
function orgNotSuspended() {
return orgMember().get('orgSuspended', false) != true;
}



























function memberGrants(permission) {
return orgMember().get('permissions', {}).get(permission, true) == true;
}
















allow read: if isStaff() || isOrgMember();










allow create, delete: if false;







































































































































































allow update: if (isSuperStaff() &&
!request.resource.data.diff(resource.data).affectedKeys().hasAny(
['slug', 'ownerUid', 'createdByUid', 'hosts', 'sso',
'plan', 'entitlements', 'releaseFlags',
'seatAddons', 'registerAllocations', 'collaboratorAllocations',
'storageOverage', 'assistOverage',
'bandwidthCap', 'stripeCustomerId', 'subscription',
'billingStatus', 'brandingProfile', 'discount', 'enterprise',
'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
'suspendedMessage', 'suspendedUntilMs', 'suspendedMode',
'suspendedEnforcement', 'suspended', 'crmInbound', 'acquisition',
'consentGroups', 'consentGroupsAwaitConfirmation', 'consentGroupsChange',
'marketingConsentPolicy', 'upgradeProposal'])) ||
(isBillingStaff() &&
!request.resource.data.diff(resource.data).affectedKeys().hasAny(
['slug', 'ownerUid', 'createdByUid', 'hosts', 'enabledPlugins',
'sso',
'plan', 'entitlements', 'releaseFlags',
'seatAddons', 'registerAllocations', 'collaboratorAllocations',
'storageOverage', 'assistOverage',
'bandwidthCap', 'stripeCustomerId', 'subscription',
'billingStatus', 'brandingProfile', 'discount', 'enterprise',
'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
'suspendedMessage', 'suspendedUntilMs', 'suspendedMode',
'suspendedEnforcement', 'suspended',
'erasureRequestedAt', 'crmInbound', 'acquisition',
'consentGroups', 'consentGroupsAwaitConfirmation', 'consentGroupsChange',
'marketingConsentPolicy', 'upgradeProposal'])) ||



(canManageOrg() && isVerified() && orgNotSuspended() &&
!request.resource.data.diff(resource.data).affectedKeys().hasAny(
['slug', 'ownerUid', 'createdByUid', 'hosts', 'plan',
'entitlements', 'releaseFlags',
'enabledPlugins', 'seatAddons', 'registerAllocations',
'collaboratorAllocations', 'storageOverage', 'assistOverage',
'bandwidthCap', 'stripeCustomerId', 'subscription',
'billingStatus', 'brandingProfile', 'sso', 'discount',
'enterprise',









'usageBudget', 'usageAlerts', 'usageAlertsSeeded',
'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
'suspendedMessage', 'suspendedUntilMs', 'suspendedMode',
'suspendedEnforcement', 'suspended',
'erasureRequestedAt',








'timeZone',







'defaultResourceScope', 'defaultMediaScope',







'nameLower', 'nameTokens', 'nameReversed',
'crmInbound',



'acquisition',










'consentGroups', 'consentGroupsAwaitConfirmation',
'marketingConsentPolicy',


'consentGroupsChange',




'upgradeProposal']));















































match /billing/{billingDocId} {
allow read: if isStaff() ||
(canManageOrg() && memberGrants('billing.view'));
allow write: if false;
}










match /members/{memberUid} {
allow read: if isStaff() ||
(isSignedIn() && memberUid == request.auth.uid) ||
isOrgWideMember();
