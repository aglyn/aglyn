match /aiUsageByUser/{subjectUid}/months/{month} {
allow read: if isStaff() ||
(isOrgMember() && subjectUid == request.auth.uid) ||
(isOrgWideMember() &&
((canManageOrg() &&
(memberResolves('billing.view') || memberResolves('org.auditLog'))) ||
memberStamps('billing.view') ||
memberStamps('org.auditLog')));
allow write: if false;
}


























match /aiAllotments/{subject} {
allow read: if isStaff() ||
(subject == 'org' && isOrgMember()) ||
(isOrgMember() &&
(subject == 'member:' + request.auth.uid ||
(subject.matches('collab:[A-Za-z0-9_-]+:[A-Za-z0-9_-]+') &&
subject.split(':')[2] == request.auth.uid))) ||
(isOrgWideMember() &&
((canManageOrg() &&
(memberResolves('billing.view') || memberResolves('billing.manage'))) ||
memberStamps('billing.view') ||
memberStamps('billing.manage'))) ||
(isOrgMember() &&
subject.matches('(collab|host):[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?') &&
orgMember().get('hostAccess', {}).get(subject.split(':')[1], '') == 'admin');
allow write: if false;
}

















match /aiBilling/{document} {
allow read: if isStaff() ||
(isOrgWideMember() &&
((canManageOrg() &&
