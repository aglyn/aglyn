request.resource.data.paths is list &&
request.resource.data.paths.size() > 0 &&



request.resource.data.paths.size() <= 250 &&
request.resource.data.attempts == 0 &&
request.resource.data.createdAt == request.time &&
(canPublishHostContent(request.resource.data.hostId) ||
('entireHost' in request.resource.data &&
canWriteHostContent(request.resource.data.hostId))) &&
!hostWritesFrozen(request.resource.data.hostId));
allow update: if false;
allow delete: if isStaff() ||
(resource.data.hostId is string &&
