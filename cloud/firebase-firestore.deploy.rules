match /passkeys/{credentialId} {
allow read: if isStaff() ||
(isSignedIn() && request.auth.uid == userId);
allow write: if false;
}


















match /emails/{address} {
allow read: if isStaff() ||
(isSignedIn() && request.auth.uid == userId);
allow write: if false;
}








match /legalAcceptances/{version} {
allow read: if isStaff() ||
(isSignedIn() && request.auth.uid == userId);
allow write: if false;
}










match /aiUsage/{month} {
allow read, write: if false;
}


match /transferPrefs/{resourceKey} {
allow read, write: if isSignedIn() && request.auth.uid == userId;
}








match /devices/{deviceId} {
allow read, delete: if isSignedIn() && request.auth.uid == userId;
allow create, update: if isSignedIn() && request.auth.uid == userId &&
request.resource.data.keys().hasOnly(['token', 'transport', 'apnsEnvironment',
'platform', 'app', 'appVersion', 'lastSeen', 'createdAt']) &&
request.resource.data.token is string &&
((request.resource.data.transport == 'apns' &&
request.resource.data.token.size() >= 64 &&
request.resource.data.token.size() <= 200 &&
request.resource.data.token.matches('^[0-9A-Fa-f]+$') &&
request.resource.data.get('apnsEnvironment', '') in ['sandbox', 'production'] &&
request.resource.data.platform in ['ios', 'macos']) ||
(request.resource.data.transport == 'fcm' &&
request.resource.data.token.size() >= 100 &&
request.resource.data.token.size() <= 4096 &&
request.resource.data.token.matches('^[A-Za-z0-9_:-]+$') &&
!('apnsEnvironment' in request.resource.data) &&
request.resource.data.platform == 'android')) &&
request.resource.data.app in ['aglyn', 'aglyn-pos'] &&
(!('appVersion' in request.resource.data) ||
(request.resource.data.appVersion is string &&
request.resource.data.appVersion.size() <= 32)) &&
request.resource.data.lastSeen == request.time;
}
}






match /webauthnChallenges/{challengeId} {
allow read, write: if false;
}
match /passkeyCredentialIndex/{credentialId} {
allow read, write: if false;
}

















match /emailIdentityIndex/{address} {
allow read, write: if false;
}
match /emailVerifications/{tokenId} {
allow read, write: if false;
}




match /profiles/{profileUid} {
allow read: if true;














function profileFieldsValid() {
return request.resource.data.handle is string &&
request.resource.data.handle.size() >= 3 &&
request.resource.data.handle.size() <= 30 &&
request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
request.resource.data.displayName is string &&
request.resource.data.displayName.size() <= 80;
}
function profileOwner() {
return isStaff() || (isSignedIn() && request.auth.uid == profileUid);
}
allow create: if profileOwner() && profileFieldsValid() &&
!request.resource.data.keys()
.hasAny(['stripeAccountId', 'stripeChargesEnabled',
'stripeAccountLivemode', 'stripePayoutsEnabled']);
allow update: if profileOwner() && profileFieldsValid() &&
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['stripeAccountId', 'stripeChargesEnabled',
'stripeAccountLivemode', 'stripePayoutsEnabled']);
}







match /publisherProfiles/{orgId} {
allow read: if true;



function publisherManager() {
return isStaff() || (isSignedIn() &&
exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)) &&
get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid))
.data.role in ['owner', 'admin']);
}
function publisherFieldsValid() {
return request.resource.data.handle is string &&
request.resource.data.handle.size() >= 3 &&
request.resource.data.handle.size() <= 30 &&
request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
request.resource.data.displayName is string &&
request.resource.data.displayName.size() <= 80;
}
















allow create: if false;





allow update: if publisherManager() && publisherFieldsValid() &&
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['handle', 'stripeAccountId', 'stripeChargesEnabled',
'stripeAccountLivemode', 'stripePayoutsEnabled',
'publisherAgreement', 'avatarUrl', 'website',
'supportEmail', 'supportUrl', 'githubUrl', 'xUrl',
'linkedinUrl', 'displayName', 'bio',
'payoutDelayDays', 'payoutPolicyAtMs']);
allow delete: if isStaff();
}





match /publisherHandles/{handle} {
allow read: if true;
allow write: if false;
}






match /marketplaceListings/{listingId} {
allow read: if true;
allow create: if false;






function listingManager() {
return isSignedIn() &&
exists(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid)) &&
get(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid))
.data.role in ['owner', 'admin'];
}









allow update: if isStaff() ||
(listingManager() &&
!request.resource.data.diff(resource.data).affectedKeys()
.hasAny(['installCount', 'priceUsd', 'profileId',
'reviewStatus', 'reviewedBy', 'reviewedAt',
'rejectionReason',






'latestApprovedVersion',




'ratingSum', 'ratingCount', 'ratingAverage',
'commentCount',














'activeInstalls', 'pinnedActiveInstalls',
'pinsVerifiedAtMs', 'pinnedVersionInstalls',



'hiddenAt', 'hiddenBy', 'hiddenReason',












'artifactType', 'type', 'kind',






'verificationRequest',





'latestVersion',





'publisherOrgId', 'sourceComponentId', 'sourceHostId',
'versionHistory', 'screenCount', 'previewImageUrl',
'createdAt', 'updatedAt',

















'logoUrl', 'screenshots',

'nameLower', 'nameTokens', 'nameReversed',
'browseAudience', 'browseTokens', 'takenDown',

'displayName', 'deletedAt', 'visibility',

'description', 'readme', 'homepageUrl', 'repositoryUrl',
'license', 'workspaceLockedAt']));
allow delete: if isStaff() || listingManager();



