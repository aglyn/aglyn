function canWriteOrgData() {
return isOrgMember() && isVerified() &&
orgMember().role in ['owner', 'admin', 'editor'] &&
orgNotSuspended();
}









































function memberResolves(permission) {
return orgMember()
.get('resolvedPermissions', orgMember().get('permissions', {}))
.get(permission, true) == true;
}
















function memberStamps(permission) {
return orgMember()
.get('resolvedPermissions', orgMember().get('permissions', {}))
.get(permission, false) == true;
}




















function canWriteOrgDatasets() {
return canWriteOrgData() && memberResolves('data.manage');
}

function canReadTransferJobs() {
return isOrgWideMember() && isVerified() &&
((orgMember().role in ['owner', 'admin', 'editor'] && memberResolves('data.manage')) ||
