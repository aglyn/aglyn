        (hostMemberRole(hostId) == 'admin' && !hostWritesFrozen(hostId));
      // Screen/layout DOC creates are API-only (AGL-473): /api/hosts/
      // resources enforces screensPerHost / sharedLayoutsPerHost (and the
      // owning org's suspension) server-side. Their `versions` (and any
      // other) subcollections stay editor-writable — not quota-governed.
      // These are carved OUT of the catch-all below (rules OR their allows,
      // so a dedicated deny can't win unless the catch-all stops matching).
      // Version CREATE is API-only (AGL-1369); update/delete stay client-side.
      //
      // `versioning` (Pro+) was a UI gate only: the console checked the
      // entitlement and then wrote `versions/{new}` with the client SDK, so a
      // Free org got Pro version history by writing the document directly.
      //
      // The split that makes this enforceable is create-vs-update, and it is
      // exact. An ordinary canvas save is `transaction.set(ref, …, {merge:true})`
      // on a version doc that ALREADY EXISTS (see `saveNodesGuarded`) — a rules
      // UPDATE, which stays open on every plan. Authoring is untouched.
      // A rules CREATE means one more version document than there was before,
      // which is precisely what the entitlement sells. /api/hosts/versions owns
      // it: the route counts the existing versions with the Admin SDK and
      // allows the FIRST one on any plan (a resource must have a version to be
      // editable at all), requiring `versioning` only to retain a second.
      //
      // Rules alone cannot make that call. The tempting test — "allow the
      // create when the parent's `versionId` already points at it" — is
      // defeated in two writes, because publishing is a legitimate client
      // action and so the parent's `versionId` is client-writable: point it at
      // the id about to be created, create, then point it back. Counting
      // documents is not something rules can do, which is why this is a route
      // and not a condition.
      // The two fields `countBillableScreens` subtracts on are frozen against
      // the client (AGL-1383), for the same reason `collections.kind` is
      // frozen below: a field the console reads as descriptive metadata is an
      // INPUT TO A PAID LIMIT, and it was writable by the party the limit is
      // enforced against.
      //
      // `kind` is set once, by /api/hosts/resources, and no client path has
      // ever written it again — the email composer sends it on the CREATE the
      // route owns, and `kind: 'email'` is what takes a screen off
      // `screensPerHost`. `deletedAt` is write-ONCE rather than frozen,
      // because soft-delete is a legitimate client write (the screens page and
      // the Emails card both stamp it) — what is denied is clearing or moving
      // it, i.e. UN-deleting, which no console surface offers.
      //
      // Both halves matter because the quota is a CREATE-TIME gate and nothing
      // re-counts afterwards. Without this, either field could be flipped on
      // and back off in a loop — create five, mark them excluded, create five
      // more — minting permanent slots a plan never sold, which no amount of
      // counting correctly at the moment of create can see. Serve-side refusal
      // and the routing-map count make an excluded screen worthless while it
      // is excluded; this is what stops it being laundered back into a page.
      //
      // The publish freeze for `author` (AGL-2334) is the last condition on
      // update. `slug` and `publishedAt` are written by `publishScreenRoute`
      // and nothing else; `versionId` is the LIVE-VERSION pointer, moved only
      // by the Publish action in the versions panel; `publishSchedule` is the
      // same act deferred, and leaving it out would make the other three
      // decorative — the cron executor applies it with the Admin SDK.
      // `deletedAt` joins them because the console's delete soft-deletes the
      // screen AND removes its routing-map entry in one `Promise.all`, and
      // the routing-map half is already refused above: allowing this half
      // alone would leave a deleted screen still serving its old route.
      //
      // Everything else on a screen stays open to an author — `name`,
      // `parentId`, `order`, `visibility`, translations, SEO. That is the
      // half of this that has to keep working, and a permission test that
      // only proves the refusals would pass just as well for a role that can
      // do nothing at all.
      match /screens/{screenId} {
        allow read: if isStaff() || isHostMember(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['kind']) &&
            !(('deletedAt' in resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['deletedAt'])) &&
            (canPublishHostContent(hostId) ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['slug', 'publishedAt', 'versionId',
                         'publishSchedule', 'deletedAt'])));
        allow delete: if isStaff() ||
          (canPublishHostContent(hostId) && !hostWritesFrozen(hostId));
        // THE WORKING DRAFT (AGL-1152), one per version, id `current`.
        //
        // A draft is the working document: you save into it as you work and
        // publish when you are done, and there is exactly ONE per target. The fixed document id is what enforces that: there is no
        // second name to create.
        //
        // It needs its own rule because the recursive matcher below allows
        // `create` only to staff, so an author's FIRST save of a draft — the
        // one that brings the document into existence — would be refused while
        // every save after it succeeded. Rules are OR'd across matching paths,
        // so this grants that create without loosening anything below.
        //
        // Deleting is deliberately open to the same role that writes: clearing
        // a draft is what PUBLISHING it does, and it is not a publish act. The
        // version document itself is untouched by this pattern — a path must
        // end in `/draft/{id}` to match here, so the delete protection the
        // matcher below puts on `versions` is intact.
        //
        // Frozen writes still freeze it. A draft is authoring, and a freeze
        // stops authoring.
        match /versions/{versionId}/draft/{draftId} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create, update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }

        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create: if isStaff();
          // Saving the canvas is an UPDATE on a version document, and it is
          // the whole of what an author does — open to every content role.
          allow update: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
          // DELETING a version is not. The live page serves whichever version
          // `versionId` points at, so deleting that document takes the page
          // down without ever touching a publish field — the freeze above,
          // walked around from underneath. Refused for an author across the
          // whole `versions` subcollection rather than only for the live one,
          // because telling which is live needs a `get()` of the parent and
          // pruning version history is a maintenance act, not authoring.
          allow delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
              (canPublishHostContent(hostId) || sub != 'versions'));
        }
      }
      // A layout has no route of its own, so its publish surface is just the
      // `versionId` pointer and the `publishSchedule` that moves it later —
      // but a layout wraps pages that ARE live, so moving that pointer
      // changes the live site exactly as a screen publish does (AGL-2334).
      match /layouts/{layoutId} {
        allow read: if isStaff() || isHostMember(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            (canPublishHostContent(hostId) ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['versionId', 'publishSchedule'])));
        allow delete: if isStaff() ||
          (canPublishHostContent(hostId) && !hostWritesFrozen(hostId));
        // THE WORKING DRAFT (AGL-1152), one per version, id `current`.
        //
        // A draft is the working document: you save into it as you work and
        // publish when you are done, and there is exactly ONE per target. The fixed document id is what enforces that: there is no
        // second name to create.
        //
        // It needs its own rule because the recursive matcher below allows
        // `create` only to staff, so an author's FIRST save of a draft — the
        // one that brings the document into existence — would be refused while
        // every save after it succeeded. Rules are OR'd across matching paths,
        // so this grants that create without loosening anything below.
        //
        // Deleting is deliberately open to the same role that writes: clearing
        // a draft is what PUBLISHING it does, and it is not a publish act. The
        // version document itself is untouched by this pattern — a path must
        // end in `/draft/{id}` to match here, so the delete protection the
        // matcher below puts on `versions` is intact.
        //
        // Frozen writes still freeze it. A draft is authoring, and a freeze
        // stops authoring.
        match /versions/{versionId}/draft/{draftId} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create, update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }

        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create: if isStaff();
          allow update: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
          allow delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
              (canPublishHostContent(hostId) || sub != 'versions'));
        }
      }
      // Reusable components (AGL-679) now carry editing history like screens
      // and layouts. The component DOC stays API-create-only (the catch-all
      // below excludes `components`, and the resources route enforces the
      // reusableComponents entitlement) — but its `versions` subcollection
      // has to be client-writable, and the catch-all's create exclusion is
      // by collection NAME, so `components/{id}/versions/{v}` was caught by
      // it too. This dedicated block carves the versions back out.
      //
      // The `author` publish freeze on the component DOC (AGL-2334) is the
      // sharpest of the three: a component republish pushes changes to every
      // page that uses it, with no route touched and nothing to review.
      //
      // ⚠️ This freeze only bites because `components` was ADDED to the host
      // catch-all's UPDATE exclusion list in the same change. It was in none
      // of the three lists — only `screens` and `layouts` were — so the
      // catch-all granted an unrestricted update on this very path, and
      // sibling match blocks are OR'd with the LOOSER one winning. Writing
      // the freeze here alone would have been theatre. The dedicated block
      // re-grants what the exclusion takes, exactly as it does for `screens`.
      match /components/{componentId} {
        allow read: if isStaff() || isHostMember(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            (canPublishHostContent(hostId) ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['versionId', 'publishSchedule'])));
        allow delete: if isStaff() ||
          (canPublishHostContent(hostId) && !hostWritesFrozen(hostId));
        // THE WORKING DRAFT (AGL-1152), one per version, id `current`.
        //
        // A draft is the working document: you save into it as you work and
        // publish when you are done, and there is exactly ONE per target. The fixed document id is what enforces that: there is no
        // second name to create.
        //
        // It needs its own rule because the recursive matcher below allows
        // `create` only to staff, so an author's FIRST save of a draft — the
        // one that brings the document into existence — would be refused while
        // every save after it succeeded. Rules are OR'd across matching paths,
        // so this grants that create without loosening anything below.
        //
        // Deleting is deliberately open to the same role that writes: clearing
        // a draft is what PUBLISHING it does, and it is not a publish act. The
        // version document itself is untouched by this pattern — a path must
        // end in `/draft/{id}` to match here, so the delete protection the
        // matcher below puts on `versions` is intact.
        //
        // Frozen writes still freeze it. A draft is authoring, and a freeze
        // stops authoring.
        match /versions/{versionId}/draft/{draftId} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create, update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }

        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostMember(hostId);
          allow create: if isStaff();
          allow update: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
          allow delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
              (canPublishHostContent(hostId) || sub != 'versions'));
        }
      }
      // Templates (AGL-666): saved starting points for pages, components and
      // layouts, and where marketplace downloads land instead of becoming
      // live pages. Creates go through /api/hosts/resources like screens and
      // layouts so templatesPerHost is enforced server-side.
      //
      // `source` is frozen on update: it records whether a template was
      // authored here, downloaded from the marketplace, or came from a
      // first-party starter, and the library shows that to the user. A client
      // able to rewrite it could stamp marketplace provenance on its own work.
      match /templates/{templateId} {
        allow read: if isStaff() || isHostMember(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['source']));
        allow delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
      }
      // Secret-/PII-bearing subcollections are carved out of the viewer-
      // readable catch-all below (AGL-502): `webhooks` docs hold an HMAC
      // signing secret + target URL, and `orders` hold customer PII/payment
      // data — reads are admin/editor only, never viewer.
      //
      // Webhook CREATE is now API-only (AGL-1360) — see the catch-all's
      // create exclusion below. The console used to create them client-side
      // and enforce WEBHOOK_MAX_PER_HOST by counting the rows its Firestore
      // LISTENER held; with `persistentLocalCache` that count could be
      // arbitrarily stale and low, so the cap was bypassable. Update/delete
      // stay client-side (delete is a soft delete, and neither consumes a
      // slot the cap has not already granted).
      match /webhooks/{webhookId} {
        allow read: if isStaff() || canReadHostSensitive(hostId);
        // Update/delete ask the SENSITIVE role, not the write role (AGL-1881).
        //
        // `webhooks` sat in the catch-all's CREATE exclusion only, so update
        // and delete fell through to it — and the catch-all asks
        // `canWriteHostContent`, which admits `author`. An author could not
        // READ this document (the rule above refuses, and the suite proves
        // it) yet could repoint its `url` at an endpoint they control and
        // overwrite its `secret`. That is the order payload leaving the site
        // through the one role AGL-2334 added so an agency could hand a
        // client LESS. The read gate was never the boundary on its own:
        // writing the destination is reading the data, one delivery later.
        //
        // The comment above this block said update/delete "stay client-side"
        // and the suite asserted it for an EDITOR, which stayed true; the
        // role that arrived afterwards is what nobody re-asked. The same
        // omission as `components` in AGL-2334, one collection over.
        //
        // The name now sits in the catch-all's update and delete exclusions
        // too, because a dedicated block cannot narrow a sibling — rules OR
        // their allows and the LOOSER one wins. This block is the re-grant,
        // and it keeps every write the console legitimately makes from the
        // browser: the soft delete that frees a capped slot (AGL-1360) and
        // the card's enable/disable. `canReadHostSensitive` is admin/editor
        // — exactly who can already read the secret off that card — so no
        // existing surface loses a write. `hostWritesFrozen` carries over
        // from the catch-all: a suspended site must not keep editing its
        // webhooks, and dropping it here would have been a quiet re-grant of
        // its own.
        allow update, delete: if isStaff() ||
          (canReadHostSensitive(hostId) && !hostWritesFrozen(hostId));
      }
      // Order STATUS is server-owned (AGL-1827). Every transition goes
      // through an Admin-SDK route that re-asks ORDER_TRANSITIONS inside the
      // transaction that writes it — cancel (AGL-1808/1818), fulfil and
      // mark-delivered (AGL-1819), refund, the supplier update and the
      // webhook paths — so a client write of `status` is by definition a
      // bypass of that guard, the stale-dialog hole those routes closed.
      // `orders` therefore joins all THREE catch-all exclusion lists below
      // (one list is not denial, and a bare deny here would lose the OR),
      // and this block re-grants exactly what the console still legitimately
      // writes client-side: the order-detail dialog's note (`timeline` only)
      // and its restock answer (`restockCheck` + `timeline`, AGL-1806). The
      // key-diff is on VALUES (the AGL-1795/1813/1824 pattern), so a patch
      // that names `status` unchanged is not refused. No client path creates
      // or deletes an order — creates are checkout/POS/draft/webhook routes,
      // and delete stays closed because delete-and-recreate would re-mint
      // the document with any status at all.
      // AN ALLOWLIST, NOT A STATUS DENYLIST (AGL-2233). The paragraph above
      // states what the client legitimately writes — the note's `timeline`
      // and the restock answer's `restockCheck` — and `hasOnly` is what
      // actually says it. `hasAny(['status'])` said only "not the status",
      // which left every OTHER field on an order client-writable, and an
      // order carries the money:
      //
      //  - `refundedCents` and `totals` are the two figures `refund.ts` reads
      //    inside its reserve transaction to cap an over-refund. Zeroing one
      //    resets the cap; raising the other lifts the ceiling.
      //  - Pre-writing `refundedCents` up to the total makes
      //    `recordDisputeClosed` compute a `reversedCents` of 0, so a LOST
      //    chargeback records nothing and `reverseSellerShare` never pulls
      //    the seller's share back — Aglyn eats the whole principal.
      //  - `dispute.reversedTransferCents` is that reversal's own once-only
      //    marker; present, it short-circuits before any Stripe call.
      //  - `supplierToken` is the bearer credential for the unauthenticated
      //    supplier-update route, and `downloadAttempts` is the download cap.
      //
      // None of those has a client writer, so an allowlist costs nothing and
      // is the shape the comment already claimed. `diff()` reports CHANGED
      // keys only, so a patch that spells out an unchanged `status` still
      // passes — the AGL-1795/1813/1824 property, unchanged.
      match /orders/{orderId} {
        allow read: if isStaff() || canReadHostSensitive(hostId);
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['timeline', 'restockCheck']));
      }
      // Per-site plugin settings (AGL-428, AGL-1014): the keys ONE site
      // answers for itself, inheriting every other key from the org's
      // `pluginSettings/{pluginId}`. Same access class as that org document,
      // at host scope — any member of the site reads it, and only a site
      // ADMIN writes it.
      //
      // READ is what the org twin grants: a member of the scope. It is
      // deliberately no wider than the host doc's own read, so a settings
      // document can never be readable by someone who cannot already read the
      // site it configures. Readers coerce types defensively (the doc is
      // admin-writable), so junk here can misconfigure only that plugin.
      //
      // WRITE is admin-only, matching `disabledPlugins`/`enabledPlugins` on
      // the host document above rather than the catch-all's
      // `canWriteHostContent`. Those keys decide WHETHER a plugin runs on this
      // site and are already frozen against an editor; this decides what it
      // runs WITH, which is the same administrative act one level in. An
      // editor who could write here could not turn a plugin on, but could
      // change what it does on a live site — a booking horizon, a discount
      // ceiling — with no publish step in front of it.
      //
      // `hostWritesFrozen` carries the suspension arm that `orgNotSuspended()`
      // carries on the org twin, and takes the host and platform arms with it:
      // a suspended site must not keep reconfiguring what it serves.
      //
      // THE EXCLUSION LIST IS THE MECHANISM, not this block. Sibling matches
      // are OR'd and the LOOSER allow wins, so `pluginSettings` is named in
      // the catch-all's create, update and delete exclusions below and this is
      // the re-grant — exactly the `webhooks`/`orders` shape. Without the
      // exclusions this block would narrow nothing and every editor and author
      // on the site would keep the catch-all's write.
      match /pluginSettings/{pluginId} {
        allow read: if isStaff() || isHostMember(hostId);
        allow write: if isStaff() ||
          (hostMemberRole(hostId) == 'admin' && !hostWritesFrozen(hostId));
      }
      // The extra {subcollection} segment matters: a bare {document=**}
      // matches ZERO or more segments in rules v2, i.e. the host doc
      // itself too — which would let editors delete the host through
      // this write rule (caught by rules-tests, AGL-235).
      match /{subcollection}/{document=**} {
        // `mediaTombstones` joins the READ exclusion too (AGL-1467), which
        // `webhooks`/`orders` are the only other members of. A tombstone holds
        // a deleted media document VERBATIM — file name, alt text,
        // description, tags, custom metadata, the `visibleTo` tokens that
        // decided who could see the asset — and it is written and consumed
        // entirely by /api/media/upload and /api/media/restore, which use the
        // Admin SDK and are not subject to these rules. Nothing in the console
        // lists them, deliberately: a browsable copy of deleted customer
        // content is the object AGL-1443 is open on, and the undo affordance
        // does not need one. No client read means no such surface can appear
        // by accident.
        allow read: if isStaff() ||
          (isHostMember(hostId) &&
            !(subcollection in ['webhooks', 'orders', 'mediaTombstones']));
        // Quota-governed collections are created via /api/hosts/resources
        // ONLY (AGL-473) — the route enforces the per-plan quota (and the
        // feature entitlement, where paid) server-side. These flat
        // collections have no client-written subcollections, so denying
        // client `create` by name is safe. Screens/layouts also appear
        // here — their dedicated blocks above own create; excluding them
        // from update/delete too keeps this catch-all from re-granting.
        // `installs` (plugin pins) are create/update API-only (AGL-508): the
        // install route enforces entitlement + purchase + kill-switch before
        // writing the pin; only DELETE (uninstall) stays client-side, so
        // update/delete is split to allow the console's uninstall.
        // `datasets` is excluded from all three (AGL-1050). Datasets moved to
        // the org in AGL-237 and the org block above has enforced API-only
        // create/delete since AGL-473/945 — but this catch-all never learned
        // the name, so `hosts/{hostId}/datasets/*` stayed a client-writable
        // path with NO quota enforcement: the same resource, one path over,
        // free. Nothing in production lives there (AGL-1061 counted 0 across
        // every host) and AGL-1050 removed the client fallback that used to
        // address it, so the exclusion takes the whole subtree — `records`
        // included, since {document=**} spans them — with nothing to re-grant.
        // `webhooks` joins the exclusion (AGL-1360): WEBHOOK_MAX_PER_HOST is
        // a flat platform cap that was only ever checked in the console, by
        // counting listener rows, so it did not survive a stale cache.
        // /api/hosts/resources now counts the live webhooks server-side.
        //
        // `counters`, `analytics` and `members` join all THREE lists
        // (AGL-1367). AGL-1360 moved a cap off a client-held COUNT; these are
        // the same untrusted number persisted in a client-writable DOCUMENT,
        // which is strictly worse — it survives the page.
        //
        //   - `counters` is the entire enforcement state of five quotas.
        //     `formSubmissionsPerMonth`, `emailSendsPerMonth`,
        //     `workflowRunsPerMonth` and `actionRunsPerMonth` each read
        //     `counters/<name>[YYYY-MM]`, compare, and proceed; `storagePerHostMb`
        //     reads `counters/media.bytes`. Every one is read-compare-proceed,
        //     so writing the counter back to 0 removes the wall — and for
        //     storage that is unbounded Firebase Storage against a Free plan's
        //     250 MB, real infrastructure cost rather than a feature.
        //   - `analytics/{day}.total` is the month's page views.
        //   - Both are ALSO the metered invoice: /api/billing/report-usage
        //     computes `storageBytes`, `formSubmissions` and `pageViews` from
        //     exactly these documents, and AGL-1280 turned the metered
        //     pass-through on for every paid plan. Lowering a counter lowers
        //     the customer's bill. `rateLimits` states the principle above —
        //     a client that can write a counter can reset its own counter.
        //   - `members` is the site roster. A raw delete does NOT revoke
        //     anything (real access lives in `orgs/{orgId}/members/{uid}
        //     .hostAccess`, which is `write: false`, projected into the frozen
        //     `memberRoles`), but the seat cap in /api/hosts/members counts
        //     these rows — so deleting N rows leaves N collaborators working
        //     and frees N seats to sell to nobody, at $1-3/seat.
        //
        // A dedicated `match /counters/{counterId} { allow write: if false; }`
        // would NOT have closed any of this: sibling match blocks are OR'd and
        // the LOOSER one wins, so the catch-all would have re-granted every
        // write. The exclusion lists ARE the mechanism, exactly as for
        // `webhooks`. Nothing is lost: every writer of all three is an
        // Admin-SDK route, and every client reference in the console and the
        // plugin components is a read, which the catch-all's `allow read`
        // above still grants.
        //
        // `mediaTombstones` joins all three as well (AGL-1467), and for the
        // `counters` reason rather than the privacy one above: a restore
        // re-increments `counters/media` by the tombstone's OWN `sizeBytes`.
        // A client that could write a tombstone could therefore hand itself a
        // negative `sizeBytes` and lower the storage meter — AGL-1367's
        // read-compare-proceed wall, reached one collection to the left — or
        // forge a media document with `visibleTo` tokens it was never granted.
        // A client that could DELETE one destroys the only route back to an
        // asset it just deleted. Both writers are Admin-SDK routes.
        //
        // `formSubmissions` joins CREATE ONLY (AGL-1668), and the asymmetry is
        // the decision rather than an oversight. `counters` above is the
        // number; this is the ROW the number counts. /api/forms/submit is its
        // only writer and it increments `counters/formSubmissions[YYYY-MM]` in
        // the same request — the document /api/billing/report-usage invoices
        // from, and the one AGL-1655's abuse ceiling is evaluated against. A
        // client `add()` here entered neither: an editor could hold
        // submissions the Free plan's 20/month wall would have refused, and
        // paid rows the meter never billed. Not a spam vector (it needs
        // membership) and NOT a way to lower a bill either — AGL-1367 already
        // made the counter itself unreachable on all three operations, so the
        // ceiling's read point was never the exposure. Only the create path
        // was.
        //
        // Update and delete stay OPEN, deliberately. The inbox plugin marks a
        // submission read with a client `updateDoc` and deletes one with a
        // client `deleteDoc` — the product's own reader — and neither touches
        // the counter, which is monotonic per month and does not fall when a
        // row is removed. Following the `counters` precedent onto all three
        // lists would have broken the inbox to close nothing.
        //
        // `orders` joins all THREE lists (AGL-1827): status is server-owned,
        // and the dedicated block above owns the reasoning and re-grants the
        // one thing the console still writes — the status-frozen update.
        //
        // `screenAnalytics` joins all THREE lists (AGL-2038), for the
        // `analytics` reason minus the money. It is the same beacon written
        // one document finer — /api/analytics/collect increments
        // `screenAnalytics/{screenId}:{day}.total` from the Admin SDK in the
        // same request that increments `analytics/{day}.total` — and every
        // client reference is a READ, which `allow read` above still grants.
        // It was in NONE of these lists purely because nobody added it when
        // AGL-151 created the collection; the catch-all is permissive by
        // default, so a new subcollection is granted rather than denied.
        //
        // Unlike `analytics` it is NOT a billing input: /api/billing/
        // report-usage computes `pageViews` from `analytics` only, so nothing
        // here lowers a bill and the AGL-1367 sentence does not transfer.
        // What it does buy is integrity of a Pro+ panel — a per-screen
        // history the customer consumes rather than authors — and the fact
        // that the only writer is server-side, which is the AGL-1367 test for
        // whether denial costs the product anything. It does not.
        //
        // That it was missed is the actual finding. `screenAnalytics` is not
        // read by the billing rollup, so the coverage spec — which swept
        // `apps/console/app/api/billing` — was right and still silent. The
        // second half of that spec now asks the broader question: every host
        // subcollection anywhere in the repo must be server-owned here or
        // named in its classification map, so the NEXT one fails the build
        // rather than inheriting write access quietly.
        //
        // SIX SERVER-WRITTEN COLLECTIONS JOIN ALL THREE LISTS (AGL-2042).
        //
        // `carts`, `checkouts`, `giftCards`, `stripeTaxRates`,
        // `restockAlerts` and `inventoryReconciliation` were parked in the
        // coverage guard's SERVER_WRITTEN_NOT_YET_DENIED because nothing
        // writes any of them from a client. That was re-checked here rather
        // than taken on the parking note's word: no `'hosts', hostId,
        // '<name>'` client path in `apps` or `libs` produces a write, and the
        // repo contains no `addDoc`/`setDoc`/`updateDoc`/`deleteDoc` against
        // one. The three client-SDK references that DO exist are READS —
        // `recovery-queue-card` queries `checkouts` and `restockAlerts`,
        // `gift-cards-card` queries `giftCards` — and `allow read` above is
        // untouched, so all three console panels keep working.
        //
        // Denying them costs the product nothing because the catch-all only
        // ever grants EDITORS (`canWriteHostContent`). Every shopper-facing
        // write to these — add to cart, start a checkout, redeem a gift card,
        // subscribe to a restock alert — is an Admin-SDK route that these
        // rules do not govern at all. There is no storefront flow to break.
        //
        // What it buys, worst first:
        //  • `giftCards` is STORED VALUE. An editor who can write one can mint
        //    balance, which is the AGL-1367 shape with money in it rather than
        //    on the invoice.
        //  • `inventoryReconciliation` is the per-order idempotency marker
        //    that stops a stock decrement being applied twice; writing one by
        //    hand makes a lost decrement permanent.
        //  • `restockAlerts` holds shopper email addresses captured by an
        //    UNAUTHENTICATED storefront endpoint — third-party PII an editor
        //    had no reason to be able to rewrite.
        //  • `carts` and `checkouts` are pre-purchase state the checkout reads
        //    back; `stripeTaxRates` is a cache of Stripe rate ids, where a
        //    forged id is a wrong tax on a real order.
        //
        // NOT `suppressions`, which AGL-2042's description also names. That
        // premise went stale on AGL-2410: the Emails console page's
        // Suppressions tab now removes an entry with a plain client
        // `deleteDoc` (`suppressions-card.tsx:176`) — the only way to undo a
        // suppression a link prescanner caused (AGL-2408). It has moved to
        // EDITOR_WRITABLE_HOST_SUBCOLLECTIONS in the coverage guard, and
        // denying it here would break a shipped surface. Recorded because the
        // issue text still reads the other way.
        //
        // All THREE lists, not one: one list is not denial, and a dedicated
        // `allow write: if false` block would not close it either, because
        // sibling match blocks are OR'd and the LOOSER one wins — the trap
        // that left `components` publishable by an author for as long as it
        // did. Checked for these six specifically: the rules file contains no
        // dedicated `match` block for any of the names, so nothing re-grants
        // them one line below.
        //
        // `actions` joins CREATE ONLY (AGL-2266), the `formSubmissions`
        // asymmetry for the `webhooks` reason. It was in NONE of these lists —
        // the catch-all is permissive by default, so a subcollection nobody
        // classified is granted — and the import route's own table had already
        // written down what that meant: "no `RESOURCES` entry and no quota key
        // anywhere; all three creators write the document client-direct." A
        // free org could mint unbounded Firestore documents from the browser
        // against a $0 subscription, which is the AGL-1360 / AGL-1399 shape:
        // uncapped infrastructure rather than a bypass of anything we sell.
        // /api/hosts/resources now owns the create and counts live rows
        // against `ACTIONS_MAX_PER_HOST`.
        //
        // Update and delete stay OPEN, and that is the decision rather than an
        // oversight. The actions card toggles `enabled`, the besigner's
        // interactions provider flips one in place, and both RETIRE an action
        // by stamping `deletedAt` — a soft delete, which is a client update.
        // Following `counters` onto all three lists would break every one of
        // those surfaces to close nothing: neither operation creates a
        // document, so neither can raise the count the cap is about. The cap
        // counts LIVE rows, so the soft delete frees a slot, which is the
        // property that makes leaving update open safe rather than merely
        // convenient.
        //
        // `authors` joins CREATE ONLY (AGL-2486), which is the `actions` split
        // AGL-2266 made and for the same single reason: a new host
        // subcollection the browser can create is unbounded Firestore
        // documents against a $0 subscription. Nothing about a byline is
        // priced — `AUTHORS_MAX_PER_HOST` is a flat platform cap counted by
        // /api/hosts/resources, like `ACTIONS_MAX_PER_HOST` and
        // `WEBHOOK_MAX_PER_HOST` before it.
        //
        // Update and delete are deliberately NOT excluded. The authors tab
        // edits a record in place and removes one outright; neither creates a
        // document, so neither can raise the count the cap is about, and
        // adding the name to those lists would break both surfaces to close
        // nothing. Deleting frees a slot, which is the property that lets a
        // host at the ceiling recover without support — and a deleted author
        // does not strip the byline off its posts, because
        // `resolveEntryAuthor` falls through a dangling `authorId` to the
        // entry's own `authorName` and then to the site.
        //
        // `media` joins CREATE and UPDATE (AGL-1881), and it is the one name
        // on these lists that is NOT being denied. The dedicated block below
        // re-grants both operations with the object fields frozen, because
        // `storagePath` addresses the shared Storage bucket through the Admin
        // SDK and was client-writable — the CRITICAL finding of the pre-launch
        // review — and the rest of the set is server-written beside it.
        //
        // The exclusion is the MECHANISM, not an extra: sibling matches are
        // OR'd and the LOOSER one wins, so a dedicated block that freezes a
        // field while this catch-all still grants the same operation freezes
        // nothing at all. That is exactly how `components` stayed
        // author-publishable after its own block was narrowed (AGL-2334), and
        // it is why a tighter `match /media/{mediaId}` on its own would have
        // read correct and enforced nothing.
        //
        // DELETE is deliberately NOT excluded. Removing the document does not
        // set a field, so it cannot address another tenant's object, and the
        // re-create is already refused by the create freeze — a client that
        // deleted and re-made the document would get a doc with no
        // `storagePath`, which `mediaStoragePathInScope` resolves to the
        // document's OWN key. Adding the name here would take the DAM's delete
        // with it to close nothing.
        //
        // `memberPosts` joins CREATE and UPDATE, with DELETE excluded and
        // re-granted by the dedicated block below (AGL-2372). This is the
        // DATABASE half of the route fix in `f78705249`, which made
        // `member-post.ts` refuse an `author` and closed the front door only:
        // the name was in NONE of these three lists, so this catch-all
        // granted it on `canWriteHostContent`, and that has included `author`
        // since AGL-2334. The role the route had just refused could `addDoc`
        // the identical document straight from the browser. Only the
        // subscriber email is lost in that path — it lives on the route — and
        // the post itself is what paying subscribers read.
        //
        // The split is written from the call sites, and they are unanimous:
        // the ONLY client-SDK write to this collection anywhere in `apps` or
        // `libs` is the `deleteDoc` at `member-posts-card.component.tsx:166`.
        // /api/commerce/member-post owns the create on the Admin SDK, so
        // denying it here costs the product nothing and makes that route the
        // single door — its `admin | editor` allowlist becomes the whole
        // policy instead of half of it. Nothing updates one at all.
        //
        // DELETE could not simply join them. Excluding the name outright is
        // what the previous pass declined to do, and correctly: it breaks the
        // card's Delete button for the admins and editors entitled to press
        // it. But leaving delete in the catch-all lets an `author` destroy
        // content paying subscribers read, and AGL-2334 already answered that
        // exact question for `components` — taking live content down is the
        // publish act in the other direction. So the name is excluded here
        // and the block below re-grants delete on `canPublishHostContent`.
        //
        // `topicOptOuts` joins all THREE lists. It records which email streams
        // a RECIPIENT has left — third-party PII captured by an
        // unauthenticated endpoint behind a signed link, on the same footing
        // as `restockAlerts`, and read by the send path to decide who a
        // campaign skips. An editor who could write one would be forging a
        // preference somebody else expressed; one who could delete one would
        // be putting an address back into a stream it asked to leave, and
        // destroying the record that the request was ever honored. The
        // preference page is the only writer and it runs on the Admin SDK.
        allow create: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'variables',
              'functions', 'workflows', 'services', 'redirects',
              'locations', 'products', 'components', 'registers', 'installs',
              'templates', 'collections', 'datasets', 'webhooks', 'orders',
              'counters', 'analytics', 'screenAnalytics', 'members',
              'media', 'mediaTombstones', 'formSubmissions', 'actions',
              'authors', 'carts', 'memberPosts', 'pluginSettings',
              'checkouts', 'giftCards', 'stripeTaxRates', 'restockAlerts',
              'inventoryReconciliation', 'stockHolds', 'themeHistory',
              'topicOptOuts']));
        // `themeHistory` joins all THREE lists (AGL-1302), and has no client
        // writer of any kind. It holds the PREVIOUS theme verbatim so that
        // "Go back to the previous theme" can restore it, written only by
        // `install-theme.ts` on the Admin SDK. A client that could forge one
        // would be choosing the CSS a publisher's revert restores — arbitrary
        // styling pushed onto a live site from the narrowest role we sell,
        // and it would arrive looking like the site's own history.
        //
        // `stockHolds` joins all THREE lists (AGL-2356). It is the release
        // index for the units a live checkout has reserved: written inside the
        // same transaction as the holds it names, read by id when the session
        // expires or settles, and never touched by any client. An editor who
        // could delete one would strand a merchant's stock until the hold's TTL
        // lapsed, and one who could forge one would have this webhook release
        // reservations it does not own. Same footing as `carts`/`checkouts`
        // beside it — server-only state on the money path, with no client-SDK
        // writer to break.
        // `templates` is excluded from update as well as create: its
        // dedicated block above freezes `source`, and leaving it here would
        // re-grant the unrestricted update this catch-all allows (AGL-666).
        // `collections` is excluded from create and update (AGL-978): the
        // slug is the collection's public address and must be claimed
        // transactionally, like the host subdomain (AGL-642), so
        // /api/hosts/collections owns both. The dedicated block below
        // re-grants the non-identity updates the console still makes
        // client-side (template assignment, categories).
        // `registers` joins update and delete (AGL-1775). It was excluded from
        // create only, which is not denial: the POS register add-on is a
        // per-org POOL allocated per site, the billing rollup reads these
        // docs, and an editor who can rewrite or delete one can re-allocate
        // registers the org is billed for. Same shape as AGL-1367 — a
        // document the invoice is computed from is a document the customer
        // must not be able to write. Allocation is an Admin-SDK route, so
        // denying the client changes nothing about the product.
        //
        // Re-applied after fcf1017eb reverted it from a stale worktree. If
        // this comment is here and `registers` is NOT in both lists below,
        // the same clobber has happened a third time — the coverage spec
        // host-subcollection-write-deny-coverage is what catches it.
        //
        // `inventoryAdjustments` joins UPDATE and DELETE, not create
        // (AGL-2269). It is an append-only LEDGER, and it is load-bearing
        // rather than historical: `cancel-order.ts` reads its
        // `reason: 'sale'` rows to decide whether a POS card order decremented
        // at all, and caps the units it releases at each row's
        // `appliedDelta` (AGL-2149) so a backordered sale cannot be
        // cancelled into stock nobody has. A row an editor can rewrite or
        // delete is a row that changes how much inventory a cancellation
        // invents — the AGL-1367 shape again, one collection over.
        //
        // CREATE stays client-side, deliberately: the products hub's "Adjust
        // stock" writes a row with `addDoc` in the same act as the count, and
        // moving that server-side is a different change. Appending is also the
        // one operation a ledger is supposed to allow.
        //
        // `components` joins UPDATE only (AGL-2334), and for the `templates`
        // reason rather than the AGL-1367 one: its dedicated block above now
        // freezes `versionId`/`publishSchedule` for an `author`, and leaving
        // the name here would re-grant the unrestricted update this catch-all
        // allows — sibling matches are OR'd and the looser one wins, so the
        // freeze would never have fired. `screens` and `layouts` were already
        // excluded, which is why only the component publish was open.
        //
        // Create and delete are deliberately NOT changed: create is already
        // API-only via the list above, and the dedicated block owns delete.
        //
        // `media` joins UPDATE for the `components` reason stated on the
        // create list above (AGL-1881): the block below freezes the object
        // fields, and a freeze under a looser sibling never fires.
        //
        // `memberPosts` joins UPDATE for the reason stated on the create list
        // (AGL-2372), and it is a deny rather than a re-grant: no client
        // updates one — the card has no edit control — so the operation is
        // dead client-side, and leaving it open would let an `author` rewrite
        // a live post's title and body in place, which reaches paying
        // subscribers by the same door the create fix just shut.
        //
        // `redirects` joins UPDATE and DELETE (AGL-1881). It was on the create
        // list ALONE, which for this collection is not a control at all: the
        // console's create rides /api/hosts/resources, but its EDIT is a
        // client-direct `setDoc(..., {merge: true})` and its delete is a
        // client-direct `updateDoc` stamping `deletedAt`. So the one operation
        // the exclusion covered was the one no client performed, and both
        // operations that decide what a redirect DOES resolved here, on
        // `canWriteHostContent` — which has admitted `author` since AGL-2334.
        //
        // A redirect rule is the strongest routing statement on the platform.
        // It is evaluated in `resolveRedirect` BEFORE route resolution, on
        // every path of every render, and a `kind: 'regex'` rule's `source`
        // can be written to match every path at once — so one update to one
        // document decides what the whole live site serves, with no publish
        // step in front of it and no version pointer to move. `destination`
        // may be an absolute https URL (a documented feature — vanity domains
        // and campaign links), so that one write can also send the site's
        // entire traffic off-platform.
        //
        // That is the AGL-2334 question with the highest possible answer:
        // "registering a path is what makes a page reachable" is the reason
        // `screens` is publish-gated, and a redirect OVERRIDES the routing map
        // rather than adding to it. The role docs promise an Author that
        // "nothing they do goes live" and that they cannot "change its
        // address"; a redirect is live the moment it is written and changes
        // every address at once. The dedicated block below therefore re-grants
        // both operations on `canPublishHostContent`.
        //
        // The exclusion is the MECHANISM, as on `media`/`components` above:
        // sibling matches are OR'd and the looser one wins, so the block below
        // decides nothing at all while this list still names neither operation.
        allow update: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'components', 'installs',
              'templates', 'collections', 'datasets', 'orders', 'registers',
              'webhooks', 'memberPosts', 'redirects', 'pluginSettings',
              'counters', 'analytics', 'screenAnalytics', 'members',
              'media', 'mediaTombstones', 'inventoryAdjustments', 'carts',
              'checkouts',
              'giftCards', 'stripeTaxRates', 'restockAlerts',
              'inventoryReconciliation', 'stockHolds', 'themeHistory',
              'topicOptOuts']));
        // `collections` joins the delete exclusion (AGL-947): a collection
        // owns `entries`, Firestore doesn't cascade, and a client delete
        // orphaned them — /api/resources/erase recursiveDeletes instead.
        // The exclusion is by NAME and {document=**} spans deeper paths, so
        // it would take single-entry deletes with it; the block below
        // re-grants those (rules OR, so a dedicated allow still wins).
        //
        // `components` joins DELETE for the same reason it joined UPDATE
        // above (AGL-2334), and it is worth recording that the emulator suite
        // is what found it: the dedicated block's `allow delete` had already
        // been narrowed to `canPublishHostContent`, the comment above it said
        // so, and an author could still delete a component — because this
        // list did not name it and the looser sibling wins. `screens` and
        // `layouts` were here already, which is exactly why only the
        // component came out wrong and why reading the diff would not have
        // shown it. A rules test against a MOCK of this file would have
        // agreed with the comment.
        //
        // `memberPosts` joins DELETE so that the dedicated block below can
        // decide it (AGL-2372) — the `media`/`components` mechanism, not an
        // outright denial. The console card really does delete client-side,
        // so the block re-grants exactly that, narrowed from
        // `canWriteHostContent` to `canPublishHostContent`. Remove the name
        // from this list and the block stops deciding anything at all, since
        // the looser sibling wins; the emulator suite's
        // `an author cannot create or delete a member post (AGL-2372)` is
        // what says so.
        //
        // `redirects` joins DELETE for the reason stated on the update list
        // above (AGL-1881), and it is a re-grant rather than a denial: the
        // console's Delete button really is a client write. A hard delete is
        // not the console's path — the button soft-deletes with `deletedAt`,
        // which is an UPDATE — but leaving hard delete on `canWriteHostContent`
        // would leave an author able to remove a publisher's redirect outright,
        // which is the same routing decision in the other direction and is
        // exactly the AGL-2334 `components` argument.
        allow delete: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'components',
              'collections', 'datasets', 'orders', 'registers', 'webhooks',
              'counters', 'memberPosts', 'redirects', 'pluginSettings',
              'analytics', 'screenAnalytics', 'members', 'mediaTombstones',
              'inventoryAdjustments', 'carts', 'checkouts', 'giftCards',
              'stripeTaxRates', 'restockAlerts',
              'inventoryReconciliation', 'stockHolds', 'themeHistory',
              'topicOptOuts']));
      }
      // Members-only posts (AGL-2372). Create and update are denied outright
      // by the exclusions above — /api/commerce/member-post is the only
      // writer and it runs on the Admin SDK — and this block re-grants the
      // one client operation that exists: the Delete button on the member
      // posts card (`member-posts-card.component.tsx:166`).
      //
      // `canPublishHostContent` rather than `canWriteHostContent`, so an
      // `author` is refused. Removing a post that paying subscribers can read
      // is the AGL-2334 `components` act in the other direction, and the
      // route's own allowlist has said `admin | editor` since f78705249; the
      // database now says the same thing rather than the opposite.
      //
      // READ is deliberately left to the catch-all. The card is not
      // role-gated, and denying the read here would render it as an empty
      // list with no error rather than as a refusal anyone can see.
      match /memberPosts/{postId} {
        allow delete: if isStaff() ||
          (canPublishHostContent(hostId) && !hostWritesFrozen(hostId));
      }
      /**
       * URL redirects (AGL-1881). Excluded from all THREE catch-all lists
       * above; this block is the only client grantor, and it grants the two
       * operations the console actually performs.
       *
       * `canPublishHostContent` rather than `canWriteHostContent`, so an
       * `author` is refused — see the note on the update exclusion for why a
       * redirect is a publish act and not an authoring one. Create is left
       * denied: it rides /api/hosts/resources for the quota, and that route
       * asks the same publish-axis question on the Admin SDK.
       *
       * `externalDestinationApprovedBy` is the serve-path's provenance stamp
       * (`matchRedirect` will not send traffic to an absolute destination
       * without it). It is NOT separately gated here, and deliberately so:
       * every write to this collection already meets `canPublishHostContent`,
       * so the field cannot be written by anyone the stamp is meant to exclude.
       * A field-level freeze would be a second place to keep true, saying the
       * same thing as the block it sits inside.
       *
       * READ is left to the catch-all, like `media` and `memberPosts`: the
       * redirects card is entitlement-gated, not role-gated, and denying the
       * read here would render it as an empty list rather than as a refusal.
       */
      match /redirects/{redirectId} {
        allow update, delete: if isStaff() ||
          (canPublishHostContent(hostId) && !hostWritesFrozen(hostId));
      }
      // The site's media library, re-granted with the object fields frozen
      // (AGL-1881). `media` is excluded from the catch-all's create and update
      // above so that this block is the ONLY grantor of both — see the note on
      // that create list for why the exclusion is the mechanism rather than
      // belt-and-braces, and `mediaObjectFieldsUnset` for the frozen set.
      //
      // Everything the DAM actually writes from the browser still lands:
      // `fileName` (rename), `alt`, `description`, `tags`, `folderId`/`folder`
      // (a move) and `visibleTo` (sharing). What it cannot write is the object
      // key its bytes live at, the flag that decides whether the CDN asks for
      // a signature, the digest a takedown is keyed on, or the type the bytes
      // come back as — none of which any client surface has ever sent.
      //
      // Read and delete are left to the catch-all on purpose. `media` is in
      // neither the read nor the delete exclusion list, so both still resolve
      // there, and re-stating them here would be a second place to keep true.
      match /media/{mediaId} {
        allow create: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           mediaObjectFieldsUnset());
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           mediaObjectFieldsUnchanged());
      }
      // Editors keep full client control of a collection doc EXCEPT the two
      // identity keys. `slug` is its public address (uniqueness is claimed in
      // /api/hosts/collections) and `kind` decides which console surface owns
      // it — a client rewrite of either is the AGL-954 collision or the
      // AGL-957 shadowing, back again.
      //
      // The three template pointers were frozen here too (AGL-1390), because
      // they were the last exclusion `countBillableScreens` made that the
      // metered party could both apply and REVERSE: point `entryScreenId` at a
      // live screen and it stopped counting, create a screen through the
      // create-time gate, clear the pointer and the screen counted again — one
      // free slot per cycle, unbounded.
      //
      // AGL-1400 took the entitlement out of the pointer. An entry template
      // says what it is on its OWN document (`kind: 'template'`, on
      // `screens/{screenId}`, frozen four blocks up since AGL-1383), the count
      // reads nothing else, and clearing a pointer therefore raises no count —
      // it leaves an orphaned template, and promoting one back to a page is a
      // gated act on /api/hosts/screens. So these three are a pointer again,
      // with nothing to launder through them, and the freeze is lifted rather
      // than left standing as a rule whose reason has gone. /api/hosts/
      // collections keeps the write while it also owns the CONVERSION that goes
      // with designating an entry template; what it no longer needs is the
      // rules to make it the only writer.
      match /collections/{collectionId} {
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['slug', 'kind']));
      }
      // Entries are a separate resource that merely lives underneath, so the
      // name-based exclusions above must not reach them: create/update/delete
      // stay editor-writable here (rules OR, so a dedicated allow wins).
      //
      // Entries are the FIFTH publish surface (AGL-2334) and the one with no
      // version pointer at all: an entry goes live by having its own `status`
      // set to `published`, or `scheduled` with a `publishAt` that the tenant
      // runtime later flips to `published` with the Admin SDK — the same
      // deferred-publish shape as `publishSchedule`, spelled differently.
      // `publishedAt` is frozen alongside them because it is what the live
      // listing sorts and filters on.
      //
      // CREATE is API-ONLY since AGL-2266, and this block is where that had to
      // be said. The catch-all's name-based exclusions cannot reach entries —
      // that is the whole reason this dedicated block exists — so entries were
      // the one quota-governed content shape under a host that no cap could be
      // attached to, and a free org could mint unbounded Firestore documents
      // from the browser. `ENTRIES_MAX_PER_COLLECTION` is now counted from a
      // server read in /api/hosts/resources, paired with
      // `COLLECTIONS_MAX_PER_HOST` on /api/hosts/collections because either
      // number alone bounds nothing.
      //
      // The draft condition this replaces has NOT been dropped, it has moved
      // where it cannot be argued with: `status` is off that route's field
      // allow-list and `'draft'` is stamped server-side, so a create arriving
      // as `published` is not refused — it is impossible to express. The rule
      // it enforced still holds on UPDATE below, which is where publishing
      // actually happens.
      //
      // UPDATE stays open, and it is what keeps the entry editor client-direct:
      // the console's save is a `setDoc(…, { merge: true })`, which is a create
      // only for the FIRST save. Every later save of the same entry is an
      // update and never touches this route.
      //
      // DELETE stays open to an author, unlike a screen's. There is no paired
      // routing-map write to leave half-applied, and an entry is the one
      // content shape where the console offers deletion as ordinary editing.
      // It also frees a slot under the cap, which is the property that lets a
      // host at the ceiling recover without support.
      match /collections/{collectionId}/entries/{entryId} {
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            (canPublishHostContent(hostId) ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'publishedAt', 'publishAt'])));
        allow delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
      }
    }

    // User profile docs (AGL-158): the console account page reads/writes
    // users/{uid}; the AGL-42 hardening dropped the blanket rule without
    // adding this match, which default-denied the collection.
    match /users/{userId} {
      allow read, write: if isStaff() ||
        (isSignedIn() && request.auth.uid == userId);

      // "My organizations" reverse index (AGL-233): API-maintained
      // beside the member docs; each user reads only their own.
      match /orgs/{orgId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // "My sites" reverse index (AGL-844): API-maintained mirror of each
      // host's memberRoles, so the site switcher and subdomain routing query
      // a user's own hosts by name without scanning the hosts collection.
      // Owner-read, server-written; a convenience index, not an auth source.
      match /hostMemberships/{hostId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // In-app notifications (AGL-259): Admin-SDK-written fan-out; the
      // owner reads, marks read (update), and clears them.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() &&
          request.auth.uid == userId;
        allow create: if false;
      }

      // Passkey credentials (AGL-662): SERVER-WRITE ONLY — a client-writable
      // credential store is a full auth bypass (swap in your own public key,
      // sign in as anyone). The owner reads their own list for the
      // management UI; every write goes through the Admin SDK ceremony
      // endpoints.
      match /passkeys/{credentialId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // Email addresses on this account (AGL-2486): SERVER-WRITE ONLY, and
      // this one is the sharpest case of the rule `passkeys` above states.
      //
      // `users/{userId}` itself is `allow read, write` for its owner with no
      // field validation at all, so anything stored ON that document is a
      // field its owner may set to any value they like. `verified` is the
      // entire security property of this feature: a verified address is a
      // SIGN-IN IDENTIFIER and can be promoted to primary, and the primary is
      // the Firebase Auth record's email — the string `decoded.email`
      // carries, which the session mint's SSO domain policy and the
      // invite-accept comparison both read. An owner who could write
      // `verified: true` could therefore claim an address they have never
      // received mail at and turn it into an authorization input.
      //
      // So every write goes through /api/account/emails, which proves
      // delivery by an emailed round-trip before it sets the bit. The owner
      // reads their own list for the management card, exactly like passkeys.
      match /emails/{address} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // Clickwrap acceptance records (AGL-1497): SERVER-WRITE ONLY, for the
      // same reason as passkeys above — this is evidence ABOUT the person who
      // would be writing it. A client-writable acceptance could be forged
      // ("I never agreed to that version"), back-dated, or deleted outright,
      // which is precisely the dispute the record exists to settle. One
      // document per accepted version, written by the Admin SDK with a server
      // timestamp; the owner may read their own history, and nobody amends it.
      match /legalAcceptances/{version} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }
    }

    // WebAuthn machinery (AGL-662): server-only, both of them. Challenges
    // are single-use secrets; the credential index maps credentialId → uid
    // and is consulted before minting sign-in tokens. Subcollection-less
    // top-level docs would already be denied by default — the explicit
    // matches document that the denial is load-bearing.
    match /webauthnChallenges/{challengeId} {
      allow read, write: if false;
    }
    match /passkeyCredentialIndex/{credentialId} {
      allow read, write: if false;
    }

    // Account email machinery (AGL-2486): server-only, both of them, on the
    // same reasoning as the WebAuthn pair directly above.
    //
    // `emailIdentityIndex/{address}` -> `{ uid }` is THE uniqueness guard:
    // one verified address, one account. A client that could WRITE one could
    // point somebody else's address at their own uid, which makes the sign-in
    // identifier ambiguous and is account takeover with no password involved.
    // A client that could READ the collection could enumerate which addresses
    // exist and which account holds each — the address book of every user we
    // have, keyed for lookup.
    //
    // `emailVerifications/{tokenId}` holds the SHA-256 of a secret that
    // confirms an address. Readable would let an attacker compare candidates
    // offline; writable would let them mint a confirmation for an address
    // they do not own, which defeats the round-trip that the whole feature
    // rests on. Single-use and TTL'd, deleted by the route that consumes it.
    match /emailIdentityIndex/{address} {
      allow read, write: if false;
    }
    match /emailVerifications/{tokenId} {
      allow read, write: if false;
    }

    // Marketplace marketplace (AGL-44). Profiles are public publisher pages
    // keyed by the publisher's uid; the owner or staff may write. Handle
    // and names are length-capped here since any owner writes client-side.
    match /profiles/{profileUid} {
      allow read: if true;
      // handle/displayName are length-capped since the owner writes client
      // side. `stripeAccountId` (payout destination) and `stripeChargesEnabled`
      // (payments-enabled gate) are set ONLY server-side after Connect
      // onboarding/KYC and are trusted by every checkout path — the client
      // must never set or change them (block on create, freeze on update).
      //
      // `stripeAccountLivemode` joined them in AGL-2471 and MUST be frozen for
      // the same reason, only more so: it is a direct INPUT to the sale gate.
      // A profile owner who could write it could assert their own test-mode
      // account into live readiness and rebuild the exact defect. Every money
      // door asks `connectLinkageIsReady`, which trusts this field.
      // `stripePayoutsEnabled` is frozen alongside it — it was left writable
      // when AGL-1547 added it, and a seller could forge their own
      // "payouts are enabled" banner.
      function profileFieldsValid() {
        return request.resource.data.handle is string &&
          request.resource.data.handle.size() >= 3 &&
          request.resource.data.handle.size() <= 30 &&
          request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 80;
      }
      function profileOwner() {
        return isStaff() || (isSignedIn() && request.auth.uid == profileUid);
      }
      allow create: if profileOwner() && profileFieldsValid() &&
        !request.resource.data.keys()
          .hasAny(['stripeAccountId', 'stripeChargesEnabled',
                   'stripeAccountLivemode', 'stripePayoutsEnabled']);
      allow update: if profileOwner() && profileFieldsValid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['stripeAccountId', 'stripeChargesEnabled',
                   'stripeAccountLivemode', 'stripePayoutsEnabled']);
    }

    // Org publisher identity (AGL-652). Publishing is ORG-ONLY: this is the
    // org's public marketplace presence, keyed by org id so authorization is
    // a plain role check with no ownership indirection. Public read — buyers
    // see who they are installing from. `profiles/{uid}` above stays as the
    // personal identity (the support forum renders author names from it) and
    // is no longer a publisher.
    match /publisherProfiles/{orgId} {
      allow read: if true;
      // The org rules' helpers are scoped to `match /orgs/{orgId}`, so this
      // block resolves membership itself. `exists()` first: reading `.data`
      // off a missing member doc errors rather than denying cleanly.
      function publisherManager() {
        return isStaff() || (isSignedIn() &&
          exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid))
            .data.role in ['owner', 'admin']);
      }
      function publisherFieldsValid() {
        return request.resource.data.handle is string &&
          request.resource.data.handle.size() >= 3 &&
          request.resource.data.handle.size() <= 30 &&
          request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 80;
      }
      // The payout keys decide who receives money — Connect route only.
      // `stripeAccountLivemode` (AGL-2471) is one of them: it is the field the
      // marketplace sale gate compares against the platform's Stripe mode, so
      // a publisher who could write it could sell from a test-mode account.
      // `stripePayoutsEnabled` is frozen with it.
      // `handle` is equally server-owned: it must be claimed transactionally
      // in `publisherHandles` (AGL-652), and a client read-then-write lets
      // two orgs racing for one handle both "succeed", silently taking each
      // other's marketplace URL. Creates go through the save route entirely;
      // updates may edit the cosmetic fields but never the handle.
      //
      // `publisherAgreement` (AGL-1077) is server-owned for the same reason
      // the payout keys are: an acceptance the accepting party can forge is
      // not evidence of anything. It is written only by the
      // `accept-agreement` action, which checks the submitted version
      // against the one in force.
      allow create: if false;
      // The AGL-1009 contact/link fields are server-owned too: the save
      // route is what enforces https-only and the fixed social hosts, and a
      // client that could write `avatarUrl` directly could store a
      // `javascript:` URL the storefront would then have to distrust.
      allow update: if publisherManager() && publisherFieldsValid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['handle', 'stripeAccountId', 'stripeChargesEnabled',
                   'stripeAccountLivemode', 'stripePayoutsEnabled',
                   'publisherAgreement', 'avatarUrl', 'website',
                   'supportEmail', 'supportUrl', 'githubUrl', 'xUrl',
                   'linkedinUrl']);
      allow delete: if isStaff();
    }

    // Handle uniqueness (AGL-652), mirroring orgSlugs: public read so a
    // handle resolves pre-auth, and claimed ONLY by the publish API inside a
    // transaction. Client-writable reservations would race, and whoever wrote
    // last would take another publisher's marketplace URL.
    match /publisherHandles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // Listings are public reads. Creates and version snapshots happen ONLY
    // through the publish API (Admin SDK, server-side sanitization) — no
    // client create. Owners may update/delete their own listing metadata
    // (unpublish via deletedAt); staff may moderate anything.
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if false;
      // Listings are ORG-owned since AGL-652, so `profileId` holds an org
      // id. The owner check used to compare it to `request.auth.uid`, which
      // a uid can never satisfy — it did not error, it just silently denied
      // every publisher access to their own listing. Same shape as the
      // publisherProfiles block above; `exists()` first because reading
      // `.data` off a missing member doc errors rather than denying.
      function listingManager() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid))
            .data.role in ['owner', 'admin'];
      }
      // Owners toggle metadata (deletedAt un/republish) client-side, but
      // must NOT touch server-managed fields (AGL-503): installCount is
      // incremented by the install API (ranking integrity), priceUsd gates
      // purchases, and profileId is the ownership key. The review verdict is
      // equally server-owned (AGL-651): `reviewStatus` decides both the
      // trust badge and whether a plugin is publicly browsable at all, so an
      // owner who could write it could self-promote to 'verified' and skip
      // staff review outright. Delete stays open to the owner; staff moderate
      // anything.
      allow update: if isStaff() ||
        (listingManager() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['installCount', 'priceUsd', 'profileId',
                     'reviewStatus', 'reviewedBy', 'reviewedAt',
                     'rejectionReason',
                     // The newest version that passed review (AGL-1016),
                     // denormalised here because `pluginVersions` is
                     // server-only. It is what the console's update badge
                     // offers, so a publisher who could write it could
                     // advertise unreviewed code as an available update —
                     // the exact leak AGL-966 closed.
                     'latestApprovedVersion',
                     // Rating aggregates (AGL-655) drive ranking and the
                     // trust signal buyers read, so they are maintained by
                     // the reviews API alone — a publisher who could write
                     // them could invent a five-star average.
                     'ratingSum', 'ratingCount', 'ratingAverage',
                     'commentCount',
                     // `installCount`'s live sibling and AGL-1419's derived
                     // cache for it (AGL-1420). `installCount` was denied on
                     // the first pass and `activeInstalls` was not, though
                     // the listing header and the browse grid print both —
                     // it was invisible to the AGL-1361 guard because it was
                     // in neither this list nor `MarketplaceListing`, which
                     // is the guard's whole field universe. The cache triple
                     // is worse than a wrong number: `verifiedLivePins`
                     // treats it as FRESH when `pinnedActiveInstalls` equals
                     // `activeInstalls` inside the TTL and then serves
                     // `pinnedVersionInstalls` without querying, so writing
                     // all four pins the cache open on chosen numbers and
                     // suppresses the re-derivation that exists to bring a
                     // count back DOWN.
                     'activeInstalls', 'pinnedActiveInstalls',
                     'pinsVerifiedAtMs', 'pinnedVersionInstalls',
                     // Staff takedown (AGL-658). An owner who could clear
                     // `hiddenAt` could un-hide their own listing, which
                     // makes moderation a suggestion.
                     'hiddenAt', 'hiddenBy', 'hiddenReason',
                     // The artifact discriminators (AGL-1364). Denying
                     // `reviewStatus` closed self-promotion, but
                     // `isListingBrowsable` only CONSULTS reviewStatus when
                     // the listing is a plugin — pre-publication review is
                     // plugin-only, because plugins execute code. So a
                     // publisher whose plugin sits at 'submitted' or
                     // 'rejected' could write `artifactType: 'component'` and
                     // become publicly browsable without ever touching the
                     // field the gate reads. All three are denied because
                     // `listingArtifactType` falls back through them in turn:
                     // `artifactType`, then `kind == 'template'`, then
                     // `type == 'plugin'`.
                     'artifactType', 'type', 'kind',
                     // The publisher's standing ask for the Verified badge
                     // (AGL-1217) is server-owned by its own doc comment: the
                     // publisher route only moves it to pending/withdrawn and
                     // only staff decide it. The staff queue is built by
                     // filtering `state == 'pending'`, so a client write is a
                     // way into the queue and a way to erase a declineReason.
                     'verificationRequest',
                     // `latestApprovedVersion` above is the offer for PLUGINS;
                     // for every other artifact type the offer is
                     // `latestVersion` (marketplace-update-state.ts). Denying
                     // one sibling and not the other left the same advertise-
                     // anything hole open one artifact type over.
                     'latestVersion',
                     // The rest of the type's own "Server-managed" banner:
                     // written by the publish/install/review paths, never by
                     // a client. The only client write to a listing anywhere
                     // in the repo is the unpublish toggle, which writes
                     // `deletedAt` alone — so denying these costs nothing.
                     'publisherOrgId', 'sourceComponentId', 'sourceHostId',
                     'versionHistory', 'screenCount', 'previewImageUrl',
                     'createdAt', 'updatedAt',
                     // Listing ARTWORK (AGL-1701). `previewImageUrl` was
                     // denied on the pass above and its two siblings were
                     // not, though all three end up in an `<img src>` that
                     // OTHER orgs' users load — `logoUrl` and every entry of
                     // `screenshots` are handed straight to `src` by
                     // listing-content.component.tsx, and `logoUrl` is also
                     // an `og:image` an UNAUTHENTICATED unfurler fetches.
                     //
                     // `validateListingContent` now holds these to
                     // first-party media, which is the actual fix; this line
                     // is what makes that fix load-bearing rather than
                     // advisory. `marketplaceListings` is `allow read: if
                     // true` and a listingManager is any org owner/admin, so
                     // while these keys were writable here the API was one
                     // way to set them, not the way — a publisher could put
                     // an arbitrary beacon host in either field with a direct
                     // client write and never touch the route that validates.
                     //
                     // Costs nothing for the same reason the block above
                     // does: the listing editor saves through
                     // `/api/marketplace/publish-plugin` (`update-listing`),
                     // and the only client write to a listing in the repo is
                     // the unpublish toggle, which writes `deletedAt` alone.
                     'logoUrl', 'screenshots']));
      allow delete: if isStaff() || listingManager();
      // Version snapshots hold the actual (possibly paid) content — no
      // client reads; installs go through /api/marketplace/install, which
      // checks the purchase record server-side (AGL-46).
      match /versions/{version} {
        allow read, write: if isStaff();
      }
      // Ratings and comments (AGL-655). Public read so the detail page can
      // render them without auth. Writes are API-ONLY: the route decides
      // whether the author is a verified installer, blocks the publisher's
      // own org, and adjusts the listing aggregates in the same
      // transaction. Letting a client write here would make every one of
      // those checks advisory.
      match /reviews/{authorUid} {
        allow read: if true;
        allow write: if false;
      }
      // Plugin version records hold the artifact sha256 + manifest (AGL-45).
      // Server-only, same as component versions: installs go through
      // /api/marketplace/install-plugin, which checks entitlement + kill
      // switch and copies the pin into the host's installs.
      match /pluginVersions/{version} {
        allow read, write: if isStaff();
      }
    }

    // Immutable base snapshots of installed marketplace content (AGL-1015),
    // keyed by their own content hash. Written only by the install routes
    // through the Admin SDK, and never rewritten — a document at a given hash
    // already holds byte-identical content, which is what makes re-installing
    // the same version free.
    //
    // Closed to clients in both directions. Reads because a base can hold paid
    // content: the hash is recorded on the installed document, so a client that
    // could read this collection could fetch any listing's content by hash
    // without buying it — exactly the leak the version subcollection is closed
    // for. The diff and reset paths (AGL-1018) read it server-side.
    match /marketplaceArtifactBases/{sha256} {
      allow read, write: if false;
    }

    // Plugin kill switch (AGL-45): loaders check this before executing a
    // pinned plugin, so it is a PUBLIC read; only staff (or the Admin SDK)
    // may write a revocation.
    match /revocations/{listingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Lockdown records (AGL-1501): `platform` and `user--{uid}` docs — the
    // two panic-button scopes with no existing carrier (org and host
    // lockdowns live on their own docs as `suspendedAt` families). Staff-only
    // READS: enforcement happens server-side through the Admin SDK, and the
    // visitor-facing notice is served by an API route that returns only the
    // sanitized reason/message — a public read here would let anyone
    // enumerate which users are locked. Writes are closed to everyone
    // INCLUDING staff clients on purpose: /api/admin/lockdown is the only
    // writer, because a lockdown write must also revoke sessions, fan out
    // projections and revalidate cached pages — a bare client write would be
    // a lockdown that looks set and enforces nothing.
    match /lockdowns/{lockdownId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Public abuse reports (AGL-1964) — the intake the lockdown levers above
    // never had. Written by POST /api/report-abuse, which is unauthenticated
    // by design: the people who find a phishing site on `*.aglyn.app` are a
    // bank's fraud team, a browser vendor or Safe Browsing, and none of them
    // has an account here.
    //
    // Staff-only READS, for both of the reasons `marketplaceReports` is
    // staff-only and one more. A row can name its reporter, and letting the
    // reported party see who reported them invites retaliation — sharper here
    // than on a marketplace listing, because a DMCA notice carries a real
    // legal name by statute. And the collection as a whole is a map of which
    // sites are under suspicion, which would tell an abuser whether they had
    // been noticed yet.
    //
    // Writes closed to EVERYONE including staff clients, the /lockdowns and
    // /contactSuppressions posture rather than `marketplaceReports`'s. Two
    // reasons, and the first is the load-bearing one:
    //
    //  - **The reporter is not authenticated, so the document id is the only
    //    thing standing between the queue and a forgery.** The route derives
    //    it from a one-way hash of (url, category, reporter IP) precisely so
    //    one source reporting one page repeatedly merges into one row instead
    //    of looking like a groundswell. A client that could choose its own id
    //    could manufacture that groundswell against a competitor's site — and
    //    the queue's whole value is that a human believes it.
    //  - A staff status change (`open` → `actioned`) is not one document
    //    write: it is the moment a lockdown or a quarantine gets justified, so
    //    it goes through an Admin-SDK route that writes the `adminAudit` row
    //    in the same act. A bare client write would be a decision with no
    //    record of who made it.
    match /abuseReports/{reportId} {
      allow read: if isStaff();
      allow write: if false;
    }

    /**
     * §512(g) counter-notices (AGL-1983). Same posture as `abuseReports`
     * above, and for sharper versions of the same reasons.
     *
     * STAFF-READ, and not readable by the subscriber who filed it even though
     * it is their own document. There is no authenticated identity on the
     * intake at all — the filer is by definition someone whose site is down
     * and who may be locked out of the console entirely — so there is no uid
     * on the row to match against, and a rule that admitted a reader would be
     * admitting an unverified claim to be that person. The row also carries
     * the complainant's side of the dispute once staff work it.
     *
     * NOBODY-WRITE, including staff, including the filer. A counter-notice is
     * a sworn statement: its whole evidentiary value is that the text is
     * exactly what was submitted, at the time it says. `receivedAt` in
     * particular is the instant §512(g)(2)(C)'s 10-to-14 business day clock
     * counts from — a client able to write it could move its own restoration
     * date, in either direction. Written only by /api/counter-notice and
     * transitioned only by /api/admin/abuse-reports, both Admin SDK, both
     * writing an `adminAudit` row for any staff decision.
     */
    match /dmcaCounterNotices/{noticeId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Marketplace purchase records (AGL-46): written only by the Stripe
    // webhook (Admin SDK). Buyers read their own purchases (install
    // gating); sellers read sales of their listings (revenue ledger).
    // Abuse reports on listings and reviews (AGL-658). Staff-only reads:
    // a report names its reporter, and letting a publisher see who reported
    // them invites retaliation. Written through /api/marketplace/report so
    // the reporter is the verified token, never a client-supplied uid.
    match /marketplaceReports/{reportId} {
      allow read, write: if isStaff();
    }

    match /marketplacePurchases/{purchaseId} {
      // The seller is an ORG (AGL-652), so the sales side is a membership
      // check, not a uid match — a uid never equals an org id, and leaving
      // the old comparison would hide every publisher's own revenue.
      //
      // THE BUYING SIDE IS AN ORG TOO SINCE AGL-2331. A purchase licenses the
      // installing organization, so the workspace that holds a licence has to
      // be able to SEE it: without this clause the only person who could read
      // an org's own licence was whoever happened to click Buy, and a
      // colleague — or their replacement after they leave — saw a listing the
      // org already paid for as unbought. `buyerUid` stays for the buyer's own
      // receipt and for pre-AGL-2331 purchases, which carry no `buyerOrgId` at
      // all and would otherwise become unreadable by anyone.
      //
      // The `is string` test is what keeps a legacy document from building the
      // path `orgs//members/{uid}` — the membership `exists()` must be asked
      // about a real org or not asked at all.
      allow read: if isStaff() || (isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid ||
         (resource.data.buyerOrgId is string &&
          exists(/databases/$(database)/documents/orgs/$(resource.data.buyerOrgId)/members/$(request.auth.uid))) ||
         exists(/databases/$(database)/documents/orgs/$(resource.data.sellerOrgId)/members/$(request.auth.uid))));
      allow write: if false;
    }

    // Refunds and lost disputes that arrived BEFORE their purchase document
    // (AGL-2148), keyed by payment intent. Written and drained only by the
    // Stripe webhook (Admin SDK); a document here means marketplace money is
    // in flight, so staff can see the queue and nobody can write to it.
    match /marketplaceRefundOrphans/{paymentIntentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Staff-only, append-only audit log of admin actions
    // ({ actorUid, action, target, before, after, at }), plus an optional
    // top-level { reason, note } pair recording WHY — required by the staff
    // override dialog since AGL-1652, and rendered on all three staff
    // surfaces that read these rows.
    //
    // The shape is NOT validated here, deliberately: every field above is
    // already trusted from a staff client, and a rule that policed one
    // action's `reason` would imply the rest are enforced when they are not.
    // The reason gate lives where the override is actually made.
    match /adminAudit/{entryId} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    // Do-not-contact list for marketing calls and texts (AGL-1592), the
    // mechanism behind Privacy Policy v4 §11. One document per phone number,
    // id = the E.164 digits without the leading '+'.
    //
    // Read is staff-only because the collection IS a list of phone numbers,
    // annotated with the fact that each one asked us to stop — which is more
    // sensitive than the numbers alone, not less.
    //
    // Write is closed to EVERYONE INCLUDING STAFF CLIENTS, deliberately, and
    // for the same reason as /lockdowns: recording an opt-out is not one
    // document write. It has to normalize the number to E.164 (an id computed
    // client-side would land the record where nothing looks for it), union
    // the channels rather than overwrite them, and — on an erasure request —
    // clear the profile copy and stamp the marker that stops SSO re-asserting
    // it. A bare client write would produce a suppression that looks recorded
    // and suppresses nothing, which is the exact failure this collection was
    // created to end.
    //
    // Delete stays closed to everything, Admin SDK aside. Opting back in is
    // `revokedAt` on the existing document: the record is the evidence that
    // the request was honoured while it was in force, and a deleted record
    // cannot show that.
    match /contactSuppressions/{phoneKey} {
      allow read: if isStaff();
      allow write: if false;
    }

    // The PLATFORM email suppression list (AGL-2407): addresses that hard
    // bounced or complained, on any send, with or without a site to attribute
    // it to. Same posture as `contactSuppressions` above and for the same
    // reasons — staff may read it to answer "why did this person stop getting
    // mail", and nothing but the Admin SDK may write it, because every writer
    // is a signed Resend webhook or a staff action that has already been
    // authorized server-side.
    //
    // Delete stays closed. Putting an address back in circulation is
    // `releasedAt` on the existing document, not a delete: the record is the
    // evidence that the suppression was honoured while it stood.
    //
    // Note this is NOT `hosts/{hostId}/suppressions`, which is a merchant's
    // own list of their own unsubscribes and is governed by the host rules.
    match /emailSuppressions/{emailKey} {
      allow read: if isStaff();
      allow write: if false;
    }

    // The per-recipient DELIVERY LOG: one document per message we sent an
    // address, carrying its subject, its lifecycle timestamps and its open
    // and click counts. Keyed by the same `sha256(address)` the suppression
    // lists use, so the two can never describe different people under one id.
    //
    // Client reads are CLOSED, staff included, and that is the difference
    // from the two lists above. Those answer "may we mail this person", a
    // question with one document and one answer. This is a per-person message
    // history whose read is a QUERY — and the staff console reads it through
    // `/api/admin/users/detail`, which has already established a staff claim
    // AND recorded who looked. An open rule here would be the same data with
    // neither, reachable from any browser holding a staff token.
    //
    // Every writer is the Admin SDK behind a signed delivery webhook, and
    // deletes happen on the erasure path — also Admin SDK.
    match /emailDeliveries/{emailKey} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Designed templates for Aglyn's own outbound email — invites, usage
    // summaries, staff alerts (AGL-747). Platform-level, not per-org: there
    // is no membership to check, only the staff claim.
    //
    // Delete stays closed deliberately. The catalog of system emails is
    // code-defined, so a template document is either present (customized) or
    // absent (using the built-in copy); "reset to default" clears the fields
    // through the same update path rather than removing the document, which
    // keeps the audit trail of who changed what.
    //
    // The send path reads these through the Admin SDK and bypasses rules.
    match /systemEmailTemplates/{templateKey} {
      allow read, create, update: if isStaff();
      allow delete: if false;

      match /versions/{versionId} {
        allow read, create, update: if isStaff();
        allow delete: if false;
      }
    }
  }
}
