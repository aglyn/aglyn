rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    // Staff access is a Firebase custom claim set via
    // tools/scripts/set-staff-claim.mjs (Aglyn Admin Console, AGL-42).
    function isStaff() { return isSignedIn() && request.auth.token.staff == true; }
    // Staff RBAC (AGL-206): roles ride a second claim; a missing role
    // means 'super' so pre-RBAC staff keep full access (migration path).
    // support = read-only surfaces; billing = plan/entitlement writes;
    // super = everything including suspension and user management.
    function staffRole() {
      return request.auth.token.get('staffRole', 'super');
    }
    function isBillingStaff() {
      return isStaff() && (staffRole() == 'super' || staffRole() == 'billing');
    }
    function isSuperStaff() { return isStaff() && staffRole() == 'super'; }

    // ------------------------------------------------------------------
    // Organizations (AGL-233/235, docs/MULTI_TENANT_FIRESTORE.md): the
    // org is the tenant boundary. Authorization resolves from the single
    // membership doc read below — identical get()s within one evaluation
    // are billed once, so the helpers can share it freely.
    // ------------------------------------------------------------------
    match /orgs/{orgId} {
      function isOrgMember() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
      }
      function orgMember() {
        return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
      }
      function canManageOrg() {
        return isOrgMember() && orgMember().role in ['owner', 'admin'];
      }
      /**
       * A member whose reach is the WHOLE org, not a named set of sites
       * (AGL-1026).
       *
       * Adding a site collaborator writes a real org membership — that is
       * what projects into `memberRoles` and lets them into the console —
       * scoped with `allHosts: false` and a `hostAccess` map naming their
       * sites. `isOrgMember()` is a bare exists() and never looked at that
       * scoping, so a contractor invited to one microsite could read the
       * whole org's CRM, every shared dataset row, the billing state and the
       * full team roster with everyone's email. The console never showed
       * them any of it; the rules are the boundary, and they were open.
       *
       * Owners and admins span the org by definition. Everyone else needs
       * `allHosts` — the same predicate `hostRoleFor` applies in code.
       */
      function isOrgWideMember() {
        return isOrgMember() &&
          (orgMember().role in ['owner', 'admin'] ||
           orgMember().get('allHosts', false) == true);
      }
      function orgNotSuspended() {
        return orgMember().get('orgSuspended', false) != true;
      }

      // Still ANY member, including a scoped collaborator (AGL-1026): this doc
      // carries `plan` and `entitlements`, which every console surface gates
      // features on, so denying it would lock a collaborator out of the site
      // they were invited to.
      //
      // It no longer carries the commercial keys. `stripeCustomerId`,
      // `subscription` and `seatAddons` moved to `billing/stripe` below, gated
      // on `canManageOrg()` (AGL-1028) — Firestore has no field-level reads, so
      // moving them was the only way to narrow this without locking anyone out.
      // What stays is deliberate: `plan`/`entitlements` because that is the
      // whole reason this doc is readable, `suspendedAt`/`suspendedReason`
      // because the tenant runtime reads suspension on every published page
      // render and moving it would buy no confidentiality (this doc is member-
      // readable regardless), and `billingStatus` because the dunning banner is
      // shown to every member on purpose.
      allow read: if isStaff() || isOrgMember();
      // Org creation/deletion and the slug/owner/billing keys are
      // Admin-SDK-only (org APIs, Stripe webhook, staff tooling), with
      // two staff exceptions mirroring the retired tenants rules
      // (AGL-206/238). After AGL-1517/1795/1813/1824 the two staff branches
      // deny the SAME server-owned keys, with exactly two deliberate
      // differences, both asserted by org-write-deny-coverage.spec.ts:
      // super staff keeps `enabledPlugins` (the AGL-501 carve-out) and
      // `erasureRequestedAt` (the erasure toggle's client batch); billing
      // staff keeps the rename. Members with the admin role may rename the
      // org; nothing else is client-writable.
      allow create, delete: if false;
      // `enabledPlugins` is the runtime plugin switchboard, written ONLY by
      // the install API after entitlement + kill-switch checks (AGL-501) —
      // it must stay out of every client-writable branch, or an admin can
      // enable gated/paid plugins for free.
      //
      // The same reasoning reaches four more keys the list had drifted past
      // (AGL-1354). None of them looks commercial, and all four are the input
      // to a decision made somewhere else:
      //  - `brandingProfile` — what `resolveBrandingProfile` applies behind
      //    the `whiteLabel` entitlement, written only by /api/orgs/settings
      //    `update-branding` after `checkEntitlement(org, 'whiteLabel')`.
      //    White-label is Enterprise/Agency; the console gates it, but the
      //    console is not a boundary, and AGL-1099 turns
      //    `brandingProfile.customConsoleDomain` into a ROUTING input — a
      //    client-writable hostname deciding which org a domain serves;
      //  - `sso` — the GCIP tenant/provider `sso-lookup` and `sso-jit` sign
      //    the org in through, written only by /api/orgs/sso behind the
      //    `ssoEnabled` entitlement. Client-writable, it is an auth-routing
      //    field, not a settings field;
      //  - `discount`/`enterprise` — staff-set commercial markers. They grant
      //    no entitlement, but they are what the billing page and the staff
      //    MRR rollup report, so a self-served value quietly falsifies
      //    revenue.
      // Every console surface writes all four through an Admin-SDK route, so
      // denying them client-side costs the product nothing.
      //
      // `plan`, `entitlements` and `releaseFlags` are Admin-SDK-only for
      // EVERY client, staff included (AGL-1795). AGL-1786 moved the staff
      // override to /api/admin/org-override, which was the last client
      // writer of the three: what remains on this document from a browser is
      // the org rename (`canManageOrg()`, which already excludes them) and
      // the erasure toggle's `erasureRequestedAt`. So denying them costs the
      // product nothing, and it is what makes the reason gate a BOUNDARY —
      // `adminAudit` validates no shape at all (`allow create: if isStaff()`),
      // so while a staff session could still write these keys directly it
      // could change a fee percentage and write a reasonless audit row, or
      // none. AGL-1652 declined to police the reason's shape in these rules,
      // and that judgement stands: validating one action's field here would
      // imply the other client-written rows are validated when they are not.
      // Closing the WRITE is the thing rules can say honestly, so that is
      // what they say.
      //
      // This empties the `isBillingStaff()` branch of its original purpose —
      // plan and entitlement writes were the whole point of that role — and
      // that is the honest outcome rather than a regression: billing staff
      // still make those changes, through the route, where the role is
      // re-checked.
      //
      // THE ROLE SPLIT IS NOT EXPRESSED HERE ANY MORE, and cannot be. It was
      // `releaseFlags` super-only (AGL-1635: the per-org override of "is this
      // feature launched", matching the super-staff-only platform-wide editor
      // at /api/admin/flags, and not a billing act since nothing about it is
      // priced) while `plan`/`entitlements` stayed open to billing staff.
      // Once both branches deny all three keys there is no split left for a
      // rule to draw. It lives in the route, restated server-side because the
      // Admin SDK bypasses rules — and enforced there on the CHANGE, not the
      // payload, exactly as `affectedKeys()` does below: every override write
      // NAMES `releaseFlags`, so refusing billing staff for naming it
      // unchanged would take away quota overrides they can make today.
      //
      // The org `suspended*` family is Admin-SDK-only for EVERY client,
      // super staff included (AGL-1517). AGL-1505 removed the last client
      // writer — the legacy staff toggle now POSTs /api/admin/lockdown — and
      // a bare client write would set the flag without the four effects that
      // make a suspension real (the `orgSuspended` member projection fan-out,
      // token revocation, tenant ISR eviction, the audit row). This mirrors
      // the AGL-1501 host takedown keys below. `erasureRequestedAt` stays
      // super-writable: the erasure toggle still legitimately writes it
      // client-side.
      //
      // `discount`, `enterprise`, `brandingProfile` and `billingStatus` are
      // Admin-SDK-only for EVERY client, staff included (AGL-1813) — the
      // AGL-1354 reasoning that closed them to an org admin reaches a staff
      // browser console just as well, and doing it client-side leaves no
      // `adminAudit` row. Re-established per key, as AGL-1795's method
      // requires:
      //  - `discount` — written only by /api/admin/org-discount (staff
      //    apply/remove, audited) and the Stripe webhook's coupon mirror;
      //  - `enterprise` — the pre-AGL-1118 comped marker. NOTHING in the
      //    product writes it any more; `isEnterpriseOrg` only reads it, and
      //    the one writer anywhere is tools/scripts/migrate-enterprise-plan
      //    .mjs, an audited Admin-SDK migration;
      //  - `brandingProfile` — written only by /api/orgs/settings
      //    `update-branding` behind `checkEntitlement(org, 'whiteLabel')`,
      //    and a ROUTING input via `customConsoleDomain` (AGL-1099);
      //  - `billingStatus` — the derived dunning mirror `writeOrgBilling`
      //    stamps from `subscription.status`; a hand-set value would just be
      //    a lie until the next webhook.
      // The only client Web SDK write to a top-level org document anywhere
      // is still the erasure batch (re-swept for AGL-1813), so denying the
      // four costs the product nothing.
      //
      // `seatAddons`, `stripeCustomerId` and `subscription` — the org-doc
      // copies AGL-1028 moved to `billing/stripe` below — are Admin-SDK-only
      // for EVERY client, staff included (AGL-1824). Vestigial but NOT dead:
      // `readOrgBilling` falls back to the org-doc fields when the billing
      // subdoc is missing, and `findOrgIdByStripeCustomer` falls back to a
      // `where('stripeCustomerId' == …)` query on `orgs` — so a client-written
      // `stripeCustomerId` on an org without a billing doc is an input to
      // webhook → org resolution. Re-established per key (AGL-1795's method):
      //  - all three are written only by `writeOrgBilling` (Admin-SDK batch;
      //    `writeInline` defaults OFF and nothing passes it) and the
      //    backfill-org-billing.mjs / drop-inline-org-billing.mjs scripts;
      //  - both fallbacks are Admin-SDK READS, so denying the client write
      //    cannot break the healing path — it only closes the poisoning one.
      // The identity keys `sso`/`slug`/`ownerUid`/`hosts` join the super
      // branch's list for the reasons that already put them on the other two
      // (AGL-1354/1824): `sso` is the auth-routing field written only by
      // /api/orgs/sso behind the `ssoEnabled` entitlement; `slug` is written
      // only by the organizations.ts create/rename transactions that keep the
      // `orgSlugs` index true; `ownerUid` only by org create and the
      // ownership transfer in /api/orgs/settings; `hosts` only by the host
      // APIs and the erase path. A bare client write of any of them bypasses
      // the index/projection maintenance that makes the value mean anything.
      // The only client Web SDK write to a top-level org document is still
      // the erasure batch (re-swept for AGL-1824), so none of the seven has a
      // client writer to lose.
      //
      // `storageOverage` joins them too (AGL-1886) and is the sharpest of the
      // set: it is what lets an upload past the plan's `storagePerHostMb`
      // hard cap, AND it carries the monthly spend ceiling that bounds the
      // charge. A client able to write it could grant itself unbounded
      // storage and raise its own spend limit in a single merge. Written only
      // by /api/billing/storage-overage (billing.manage), Admin SDK.
      //
      // `registerAllocations` joins all three lists on the same reasoning
      // (AGL-1775). It is an ENTITLEMENT INPUT — it decides how many POS
      // registers a site may run, on top of the plan cap — and it is written
      // only by /api/billing/register-allocations (billing.manage) and by
      // `eraseHost`, both Admin SDK. A client that could write it would assign
      // itself the whole purchased pool on every site, which is precisely the
      // over-entitlement the pool was introduced to close.
      allow update: if (isSuperStaff() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['slug', 'ownerUid', 'hosts', 'sso',
             'plan', 'entitlements', 'releaseFlags',
             'seatAddons', 'registerAllocations', 'storageOverage',
             'stripeCustomerId', 'subscription',
             'billingStatus', 'brandingProfile', 'discount', 'enterprise',
             'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
             'suspendedMessage', 'suspendedUntilMs', 'suspendedMode'])) ||
        (isBillingStaff() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['slug', 'ownerUid', 'hosts', 'enabledPlugins', 'sso',
             'plan', 'entitlements', 'releaseFlags',
             'seatAddons', 'registerAllocations', 'storageOverage',
             'stripeCustomerId', 'subscription',
             'billingStatus', 'brandingProfile', 'discount', 'enterprise',
             'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
             'suspendedMessage', 'suspendedUntilMs', 'suspendedMode',
             'erasureRequestedAt'])) ||
        (canManageOrg() && orgNotSuspended() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['slug', 'ownerUid', 'hosts', 'plan', 'entitlements',
             'releaseFlags',
             'enabledPlugins', 'seatAddons', 'registerAllocations',
             'storageOverage', 'stripeCustomerId', 'subscription',
             'billingStatus', 'brandingProfile', 'sso', 'discount',
             'enterprise',
             'suspendedAt', 'suspendedReason', 'suspendedReasonCode',
             'suspendedMessage', 'suspendedUntilMs', 'suspendedMode',
             'erasureRequestedAt']));

      /**
       * The commercial keys, moved off the org doc so a scoped site
       * collaborator stops reading them (AGL-1028): `stripeCustomerId`,
       * `subscription`, `seatAddons`.
       *
       * Managers and staff only. Written exclusively by the Stripe webhook and
       * the billing/staff APIs through the Admin SDK, which rules never
       * applied to — so `write: false` costs nothing and keeps the client out.
       *
       * The org doc keeps a derived `billingStatus` string for the AGL-275
       * dunning banner, which is shown to every member on purpose. That is the
       * only thing about a subscription a non-manager can still see, and it
       * carries no amount, price id or customer id.
       */
      match /billing/{billingDocId} {
        allow read: if isStaff() || canManageOrg();
        allow write: if false;
      }

      // The roster carries names and emails, denormalized for the team page,
      // so it is visible to the org — not to a site collaborator, who has no
      // business knowing who else the workspace employs (AGL-1026). Reading
      // your OWN membership stays open to everyone: it is how the console
      // resolves the reader's role and site access, and refusing it would
      // lock scoped collaborators out of their own sites.
      //
      // Mutations go through the membership API so the reverse index and host
      // projections stay consistent.
      match /members/{memberUid} {
        allow read: if isStaff() ||
          (isSignedIn() && memberUid == request.auth.uid) ||
          isOrgWideMember();
        allow write: if false;
      }

      // Invites carry emails — readable by org managers only; the invited
      // account accepts through the API, never by writing here.
      match /invites/{inviteId} {
        allow read: if isStaff() || canManageOrg();
        allow write: if false;
      }

      // Custom roles (AGL-243): named permission sets members resolve
      // their own access from — member-readable, API-written only.
      match /roles/{roleId} {
        allow read: if isStaff() || isOrgMember();
        allow write: if false;
      }

      // Monthly usage rollups (AGL-41) + the live API-request meter
      // (AGL-635): readable by the org so the Billing page usage meters show
      // real numbers — and org-wide only (AGL-1026), because how much the
      // workspace spends is not a fact about the one site a collaborator was
      // invited to. Written only by the server — the report-usage cron and the
      // customer-API auth chokepoint via the Admin SDK, which bypasses rules.
      match /usage/{month} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if false;
      }
      match /apiUsage/{month} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if false;
      }

      // Per-asset media delivery counters for the ORG library (AGL-176),
      // added here because they were never granted at all (AGL-1143).
      //
      // This block is a MISSING rule, not a widened one. `serve-media-cdn.ts`
      // writes `{orgs|hosts}/{scopeId}/analytics/{day}` on every origin serve,
      // and `media-library.component.tsx` reads thirty day-docs each time the
      // asset drawer opens — but only the HOST half ever resolved to a rule,
      // through `hosts/{hostId}/{subcollection}/{document=**}`. The org block
      // has no catch-all, so the org half reached no `match` and was denied by
      // default, for EVERY role including staff: a path that matches nothing
      // never gets as far as evaluating `isStaff()`. Measured on production
      // 2026-08-12 — 75 rejected listen targets on this path and not one
      // successful read, from a `staff: true` session whose other reads in the
      // same minute all succeeded.
      //
      // Org-wide only, like `usage` above and unlike `counters` below. One
      // day-doc holds a `media` map keyed by every asset id in the org, and
      // AGL-1041/1042 exist precisely so a site collaborator sees only the
      // assets in their scope — granting `isOrgMember()` here would hand them
      // the delivery figures, and the existence, of all of it in a single
      // document rules cannot filter by field.
      //
      // Server-written only, for the AGL-1367 reason its host twin is on all
      // three exclusion lists: `analytics/{day}` is a metered-invoice input,
      // so a client that could write it could lower a bill.
      match /analytics/{day} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if false;
      }

      // Per-plugin settings (AGL-428): overrides for a plugin's declared
      // config schema. Readers defensively coerce types (the doc is
      // manager-writable), so junk here can misconfigure only that
      // plugin, never break it.
      match /pluginSettings/{pluginId} {
        allow read: if isStaff() || isOrgMember();
        allow write: if isStaff() || (canManageOrg() && orgNotSuspended());
      }

      // Org-shared data (AGL-237): datasets (records included), contacts
      // and segments are shared across every host in the org. Any member
      // reads; editors and up write; viewers stay read-only. Suspension
      // rides the member doc like org renames.
      //
      // AGL-1026 split this block. Contacts, segments and lists moved to
      // org-wide readers (they are people, see below). Datasets, media and
      // media folders deliberately did NOT: a site's pages bind org datasets
      // and place org media, so a collaborator building that site has to read
      // them, and there is no per-site association to filter on — a dataset
      // belongs to the org and nothing records which sites use it. Scoping
      // these needs that association to exist first, which is a schema change,
      // not a rules edit.
      //
      // AGL-1037/1038 made that schema change, so the scoping below is now
      // possible: resources carry `visibleTo` (['org'] or ['host:{id}', …])
      // and members carry a denormalized `scopeTokens`. The intersection is
      // the association that was missing.
      function canWriteOrgData() {
        return isOrgMember() &&
          orgMember().role in ['owner', 'admin', 'editor'] &&
          orgNotSuspended();
      }
      /**
       * Write access to the org-wide records a site collaborator cannot read
       * (AGL-1026). Without this, an org role of `editor` scoped to one site
       * could still WRITE the contacts and lists the read rules now deny
       * them — write-only access to other people's customer data, which is a
       * stranger position than either allowing or denying both.
       */
      function canWriteOrgWideData() {
        return isOrgWideMember() &&
          orgMember().role in ['owner', 'admin', 'editor'] &&
          orgNotSuspended();
      }
      /**
       * Scoped-resource read (AGL-1041/1042): may the caller see THIS doc?
       *
       * Org-wide members read everything the org owns — they are the org.
       * Everyone else needs their `scopeTokens` (AGL-1038, written by
       * `syncOrgAuthProjections`) to intersect the resource's `visibleTo`.
       * Rules have no `.map()`, which is why both sides are denormalized
       * arrays: `hasAny` is the only set-intersection primitive available.
       *
       * NO missing-field escape hatch, deliberately (AGL-1047). An earlier
       * version allowed a doc with no `visibleTo` through, as safety for the
       * window between the AGL-1040 backfill and this rule deploying. That
       * `in` check made the whole rule unprovable per-document for LIST
       * queries, and Firestore then admitted an UNFILTERED list of the
       * entire collection — including other sites' restricted docs. Verified
       * against the emulator: with the hatch a scoped member lists
       * everything; without it the unfiltered list is denied and the
       * filtered one succeeds.
       *
       * The hatch is also no longer needed: the backfill has run in
       * production (zero docs left unstamped) and every writer now stamps
       * the field, so an absent `visibleTo` means a bug, and failing closed
       * on it is correct.
       */
      function canReadScoped() {
        return isOrgWideMember() ||
          (isOrgMember() &&
           resource.data.visibleTo.hasAny(orgMember().get('scopeTokens', ['org'])));
      }
      function canWriteScopedOrgData() {
        return canWriteOrgData() && canReadScoped();
      }
      /**
       * Only an org-wide member may change who a resource is shared with.
       * Without this a scoped editor could widen their own site's dataset to
       * `['org']`, or — worse — narrow an org-wide one to just their site,
       * taking it away from everyone else.
       */
      function scopeUnchanged() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['visibleTo']);
      }
      /**
       * Create-time twin of `canReadScoped` — it reads `request.resource`
       * because `resource` does not exist yet. Stops a scoped member
       * creating a resource they would immediately be unable to see, or
       * quietly seeding one into another site's scope.
       */
      function canCreateScoped() {
        return isOrgWideMember() ||
          request.resource.data.visibleTo.hasAny(orgMember().get('scopeTokens', ['org']));
      }
      // Dataset/record CREATES are API-only (AGL-473): the console route
      // enforces the dataStore entitlement and dataset/record quotas
      // server-side. Record updates/deletes stay editor-writable — they
      // don't consume quota.
      // Deleting the DATASET doc is API-only too (AGL-945): the doc owns a
      // `records` subcollection and Firestore doesn't cascade, so a client
      // delete orphaned every record beneath it (still billed, still
      // matched by the rule below, which doesn't check that its parent
      // exists). /api/resources/erase recursiveDeletes the whole subtree.
      // Scoped to the sites that may see them (AGL-1041). NOTE for anyone
      // debugging "the Data page is empty for a collaborator": rules
      // evaluate per document on a LIST, and Firestore rejects the whole
      // query if any candidate would fail — so a scoped member MUST send
      // `where('visibleTo', 'array-contains-any', scopeTokens)`. An
      // unfiltered list is permission-denied, not a filtered result. That
      // is the enforcement working; the client side is AGL-1044.
      match /datasets/{datasetId} {
        allow read: if isStaff() || canReadScoped();
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteScopedOrgData() && (isOrgWideMember() || scopeUnchanged()));
        allow delete: if isStaff();
        match /records/{recordId} {
          // A record has no `visibleTo` of its own; it inherits the
          // dataset's. That costs one extra document read per evaluation,
          // including per candidate on a list query. The alternative —
          // denormalizing `visibleTo` onto every record — is cheaper to
          // read and much harder to keep correct when a dataset's scope
          // changes (an N-record backfill on every scope edit, with a
          // window where records disagree with their parent). Correctness
          // wins here; revisit if record listing shows up in Firestore
          // costs.
          function parentDatasetVisible() {
            return isOrgWideMember() ||
              (isOrgMember() &&
               get(/databases/$(database)/documents/orgs/$(orgId)/datasets/$(datasetId))
                 .data.visibleTo
                 .hasAny(orgMember().get('scopeTokens', ['org'])));
          }
          allow read: if isStaff() || parentDatasetVisible();
          allow create: if isStaff();
          allow update, delete: if isStaff() ||
            (canWriteOrgData() && parentDatasetVisible());
        }
      }
      // The CRM is org-wide-only (AGL-1026). Contacts and segments are people
      // — names, emails, everything a form ever collected, across every site
      // — and there is no per-site slice of them to hand a collaborator: a
      // contact belongs to the org, not to the site whose form created it.
      // Given the choice between showing a one-site contractor the whole
      // customer list and showing them none of it, none is the only defensible
      // one. A collaborator who genuinely needs their site's leads should get
      // them through a server route that filters, not a widened rule.
      match /contacts/{contactId} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if isStaff() || canWriteOrgWideData();
      }
      match /contactSegments/{segmentId} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if isStaff() || canWriteOrgWideData();
      }

      // Email lists (AGL-254): static audiences shared across the org's
      // hosts; the enrollList automation step writes members server-side.
      // Deleting the LIST doc is API-only (AGL-946): its `members` are
      // enrolled contacts (PII) in a subcollection Firestore won't cascade
      // into, so a client delete left them readable to every org member
      // with no list to reach them from. /api/resources/erase walks the
      // whole subtree; enrollments below stay individually deletable.
      match /lists/{listId} {
        // Enrolled members are contacts, so the list follows the CRM
        // (AGL-1026): org-wide readers only.
        allow read: if isStaff() || isOrgWideMember();
        allow create, update: if isStaff() || canWriteOrgWideData();
        allow delete: if isStaff();
        match /members/{memberId} {
          allow read: if isStaff() || isOrgWideMember();
          allow write: if isStaff() || canWriteOrgWideData();
        }
      }

      // Org media library (AGL-237, full DAM parity): shareable with any
      // host in the org. Storage objects stay API-managed (upload/delete
      // routes enforce quota), but editors mutate the metadata docs the
      // same way they do on a host's library (rename, folder moves).
      //
      // Scoped like datasets (AGL-1042). Assets carry their OWN `visibleTo`
      // rather than inheriting their folder's: the tree is five levels deep
      // (`media-folders.ts`), so read-time inheritance would cost up to five
      // `get()`s per evaluation. A folder's scope is instead applied to its
      // contents by an explicit, auditable write-time cascade in the console
      // (AGL-1045) — and moving an asset between folders does NOT re-scope
      // it, which the UI has to say out loud because the opposite is what
      // people assume.
      // `write` is split into create/update/delete here because
      // `canReadScoped()` inspects `resource.data`, which does not exist on
      // a create — media folders ARE created client-side, so that path is
      // real and would error rather than deny.
      match /media/{mediaId} {
        allow read: if isStaff() || canReadScoped();
        allow create: if isStaff() || (canWriteOrgData() && canCreateScoped());
        allow update: if isStaff() ||
          (canWriteScopedOrgData() && (isOrgWideMember() || scopeUnchanged()));
        allow delete: if isStaff() || canWriteScopedOrgData();
      }
      match /mediaFolders/{folderId} {
        allow read: if isStaff() || canReadScoped();
        allow create: if isStaff() || (canWriteOrgData() && canCreateScoped());
        allow update: if isStaff() ||
          (canWriteScopedOrgData() && (isOrgWideMember() || scopeUnchanged()));
        allow delete: if isStaff() || canWriteScopedOrgData();
      }
      // Storage quota meter for the org library.
      match /counters/{counterId} {
        allow read: if isStaff() || isOrgMember();
        allow write: if false;
      }

      // Org-tier plugin installs (AGL-237): pins that apply to every host
      // in the org; written only by the install API (entitlement + kill
      // switch checks live there).
      match /installs/{listingId} {
        allow read: if isStaff() || isOrgMember();
        allow write: if false;
      }

      // Org activity log: mirrors hosts/{hostId}/activity. Org-wide readers
      // only (AGL-1026) — it names who did what across every site, which is
      // both a roster leak and a map of work on sites the reader cannot see.
      // A collaborator still gets their own sites' log at
      // `hosts/{hostId}/activity`.
      match /activity/{entryId} {
        allow read: if isStaff() || isOrgWideMember();
        allow write: if false;
      }

      // SSO domain claims (AGL-1210). Deny ALL client access, read included.
      //
      // The claim token is the only thing standing between an org and a
      // domain it does not own: publish that token as a TXT record and the
      // domain's sign-ins route to your IdP. A client-readable claim would let
      // any org member — or anyone who can read the collection — lift another
      // org's token, so the console goes through /api/orgs/sso, which returns
      // a claim only to an admin of THAT org.
      //
      // Writes are API-only for the stronger reason: `verified` is the whole
      // security property, and a client that can set it has defeated domain
      // verification entirely.
      match /ssoDomains/{domain} {
        allow read, write: if false;
      }
    }

    // Workspace-subdomain resolution ({slug}.aglyn.com): public read so
    // the console can resolve a slug pre-auth; reservation is API-only.
    match /orgSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Email domain → SSO identity pool (AGL-1101/1210). Resolved pre-auth by
    // /api/auth/sso-lookup through the Admin SDK, which bypasses rules — so
    // unlike `orgSlugs` this needs no public read, and does not get one.
    //
    // A live doc here is the statement "this org proved it owns this domain",
    // and it is the routing decision for every sign-in on that domain. Written
    // by `publishSsoDomains` alone, which re-checks the DNS-verified claim
    // before each write. Any client write path would be a domain-takeover
    // vector, so there is none.
    match /ssoDomains/{domain} {
      allow read, write: if false;
    }

    // Custom console domain → org (AGL-1099/AGL-1373). Admin SDK only, on the
    // same reasoning as `ssoDomains` and deliberately NOT public-read like
    // `orgSlugs` — nothing client-side consults it, and `orgSlugs` is public
    // only because it doubles as the health probe.
    //
    // A doc here is a RESERVATION as much as a routing record: `status` and
    // `txtToken` are the whole ownership proof, and every name in `names` is
    // claimed in one transaction precisely so no second org can hold any part
    // of the set. A client that could write either field has defeated domain
    // verification and the uniqueness guard together.
    match /consoleDomains/{domain} {
      allow read, write: if false;
    }

    // Host → org resolver mirror, server-written beside host create.
    match /hostIndex/{hostId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Customer API keys (AGL-616). Secret material: only a SHA-256 hash of
    // the token is stored (doc id = hash). Deny ALL client access — minting,
    // listing (metadata only), verification, and revocation happen through
    // the Admin SDK. Clients never read this collection.
    match /apiKeys/{keyHash} {
      allow read, write: if false;
    }

    // REST API idempotency records (AGL-618): dedupe POSTs by Idempotency-Key.
    // Written and read by the Admin SDK only.
    match /apiIdempotency/{keyHash} {
      allow read, write: if false;
    }

    // Durable rate-limit counters (AGL-794): one doc per (hashed key, window),
    // written by the Admin SDK inside a transaction. Deny ALL client access —
    // a client that could write these could reset its own counter, which
    // defeats the whole point, and one that could read them could enumerate
    // which buckets are near their cap.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Stripe customer -> org reverse index (AGL-1028), written by the webhook
    // beside `orgs/{orgId}/billing/stripe`. It exists because moving
    // `stripeCustomerId` into a subcollection broke the webhook's
    // `where('stripeCustomerId', '==', …)` lookup, and a mapping doc is an
    // O(1) get where the alternative is a collection-group index.
    //
    // Deny ALL client access. Readable, it would map a Stripe customer id back
    // to an org for anyone who obtained one — the exact correlation this issue
    // moved the field to prevent.
    match /stripeCustomers/{stripeCustomerId} {
      allow read, write: if false;
    }

    // Per-transaction tax/revenue records (AGL-1811), written by the billing
    // webhook on `invoice.paid` and read only by the staff tax-return route
    // through the Admin SDK. Deny ALL client access: a row carries a
    // customer's billing address beside their invoice amounts.
    //
    // Unmatched paths deny anyway; this match exists to carry the record:
    // these are TAX FILING RECORDS with a statutory retention obligation, so
    // they are deliberately EXCLUDED from the GDPR org-erasure sweep
    // (`eraseOrg` — see the note there, and the erase-org-tax-retention
    // emulator spec that pins it). Do not add `platformRevenue` to any
    // org-keyed deletion pass.
    match /platformRevenue/{invoiceId} {
      allow read, write: if false;
    }

    // Storefront commerce tax records (AGL-1904), written by the commerce
    // webhook and read only by the same staff tax-return route. Deny ALL
    // client access: a row carries a shopper's address beside the amounts,
    // and it names the merchant's org — one merchant must never be able to
    // read another's sales.
    //
    // Same retention rule as `platformRevenue` above and for the same
    // reason: these are TAX records, they are org-keyed by FIELD (exactly the
    // shape the erasure sweep eats), and they must NEVER be added to an
    // org-keyed deletion pass.
    match /storefrontTaxCollected/{stripeObjectId} {
      allow read, write: if false;
    }

    // Hosts and everything under them (content-hardening review,
    // 2026-07-07: tenant sites read through the Admin SDK, so no public
    // read). Access resolves through the org membership projection
    // `memberRoles` stamped on the host doc by the org APIs (AGL-233) —
    // one get, role-aware (admin/editor write, viewer read). The legacy
    // `admins` uid-map retired with the tenants collection (AGL-238).
    function hostMemberRole(hostId) {
      return get(/databases/$(database)/documents/hosts/$(hostId))
        .data.get('memberRoles', {}).get(request.auth.uid, null);
    }
    function isHostAdmin(hostId) {
      return isSignedIn() && hostMemberRole(hostId) != null;
    }
    function canWriteHostContent(hostId) {
      return isSignedIn() && hostMemberRole(hostId) in ['admin', 'editor'];
    }
    /**
     * Is the `suspended*` family on this document an ACTIVE suspension right
     * now? (AGL-1981.)
     *
     * The one definition of "suspended" both scopes ask, so the org arm
     * (AGL-210/238) and the host arm (AGL-1965) cannot drift into saying
     * different things about the same field family — which is exactly why
     * AGL-1965 declined to make its arm expiry-aware on its own.
     *
     * `suspendedUntilMs` is an optional expiry, documented as one on both
     * `organization.types.ts` and `platform.types.ts`, and honoured
     * server-side by `isLockdownActive()` since AGL-1512: past it, the tenant
     * middleware stops rewriting to `/api/locked` and the 38
     * `lockdownRefusal()` sites stop refusing. Rules read only `suspendedAt`,
     * so a TIMED suspension came back to life everywhere EXCEPT the client
     * SDK, and publishing is a client write — the customer got their site
     * back and could not edit it, with no error that said why. Since AGL-1983
     * this is also the put-back mechanism: a §512(g) counter-notice restores
     * access by stamping this field, so an expiry that never fires makes the
     * restoration clock theatre.
     *
     * Two directions of caution, both deliberate:
     *
     *  - **No expiry means indefinite**, not expired. Written as "NOT (a
     *    numeric expiry that has passed)" rather than "the expiry is in the
     *    future" precisely so an ABSENT field cannot read as a lapsed one.
     *    The tempting `data.get('suspendedUntilMs', 0) > request.time` form is
     *    that bug, and it would lift every open-ended takedown on the
     *    platform.
     *  - **A malformed expiry keeps the lock.** The field is Admin-SDK-only,
     *    so a non-number can only arrive through our own bug; `is number`
     *    makes that case leave the suspension standing. Failing closed is the
     *    right way round to be wrong here.
     *
     * The bypass this opens if the deny-lists ever slip is worth naming: once
     * rules read `suspendedUntilMs`, WRITING it is lifting the suspension. It
     * is frozen against clients on the org doc and the host doc alike
     * (AGL-1507/1517), and the rules suite re-proves that against the timed
     * fixture rather than trusting the list.
     */
    function suspensionActive(carrier) {
      return carrier.get('suspendedAt', null) != null &&
        !(carrier.get('suspendedUntilMs', null) is number &&
          carrier.get('suspendedUntilMs', 0) <= request.time.toMillis());
    }
    // Suspension write-block (AGL-210/238): a staff-suspended org keeps
    // read access but cannot mutate content. Fail-open when the org doc
    // is missing (pre-org hosts) so legacy data never locks up.
    function orgSuspendedById(orgId) {
      return orgId != null &&
        exists(/databases/$(database)/documents/orgs/$(orgId)) &&
        suspensionActive(
          get(/databases/$(database)/documents/orgs/$(orgId)).data);
    }
    function hostOrgSuspended(hostId) {
      return orgSuspendedById(
        get(/databases/$(database)/documents/hosts/$(hostId))
          .data.get('orgId', null));
    }
    /**
     * HOST-scope lockdown (AGL-1965). The org arm above has existed since
     * AGL-210/238; this one was never written, so a host-scope takedown was a
     * takedown of everything EXCEPT the client SDK.
     *
     * `/admin/lockdown` at host scope stamps `hosts/{hostId}.suspendedAt` and
     * that stopped two of the three write paths: the public site (the tenant
     * middleware rewrites to `/api/locked`) and every Admin-SDK route (38
     * `lockdownRefusal()` sites). Publishing is neither — it is a direct
     * browser Firestore write (`screen-publishing.ts` sets
     * `hosts/{hostId}/screens/{screenId}` and the host doc's `screens` map),
     * and `screens` is not in the frozen-key list on the host update below. So
     * an admin/editor with a live session could keep editing a phishing site
     * staff had just suspended, and republish it.
     *
     * Free of charge: `hostMemberRole` and `hostOrgSuspended` already `get()`
     * this same document, and identical get()s inside one evaluation are
     * billed once. Ordered first in `hostWritesFrozen` so the cheap arm
     * short-circuits before the org arm's second get.
     *
     * Mirrors `orgSuspendedById` deliberately, and now shares its definition
     * of "suspended" outright: AGL-1981 moved the `suspendedAt`-plus-expiry
     * test into `suspensionActive()` and pointed both arms at it, so the blind
     * spot this comment used to record — neither arm consulting
     * `suspendedUntilMs`, leaving a timed suspension frozen in rules forever
     * after the server considered it served — is closed at both scopes in one
     * move, which is the only way it could be closed without the file saying
     * two different things about one field.
     */
    function hostSuspended(hostId) {
      return suspensionActive(
        get(/databases/$(database)/documents/hosts/$(hostId)).data);
    }
    /**
     * The single predicate every host write rule below asks. Both scopes
     * freeze content writes; `suspendedMode: 'read-only'` (AGL-1511) is a
     * suspension too — the site keeps SERVING and stops accepting writes,
     * which is exactly this.
     *
     * Staff are never subject to it: `isStaff()` stays the first disjunct of
     * every rule, which is the un-panic invariant — the people who set the
     * lock must be able to work inside it and lift it.
     */
    function hostWritesFrozen(hostId) {
      return hostSuspended(hostId) || hostOrgSuspended(hostId);
    }
    match /hosts/{hostId} {
      // Queries must be membership-constrained (the console filters on
      // memberRoles.{uid}), which these rules admit.
      allow read: if isStaff() || (isSignedIn() &&
        resource.data.get('memberRoles', {}).get(request.auth.uid, null) != null);
      // Creation moved fully server-side (AGL-233): /api/hosts/create
      // checks org role + quota + subdomain uniqueness with the Admin SDK.
      allow create: if false;
      // The host doc carries live directories (screens, layouts), so
      // editors update it too; deletion is admin-only. Editors must NOT be
      // able to rewrite the identity/projection keys: `memberRoles` is the
      // access list (self-escalation / add-outsider / lock-out-owner),
      // `orgId` gates suspension, `admins`/`hosts` are legacy/ownership, and
      // `subdomain` is the site's public address — a client write could take
      // a reserved name or collide with another org's site, making
      // subdomain->host resolution ambiguous (AGL-642). It goes through
      // /api/hosts/rename, which claims uniqueness transactionally.
      // `cname` is the site's OTHER public address and has the identical
      // ambiguity (AGL-743 moved its write server-side for exactly that
      // reason, and /api/domains/attach's comment claims to be its only
      // writer) — but it was never added here, so the claim held for our code
      // and not for the rules. Any editor could still `updateDoc` a cname
      // directly, skipping both the uniqueness transaction and DNS
      // verification. That was already enough to serve one org on another
      // org's domain; since AGL-1272 it also decides whether
      // `{sub}.aglyn.app` redirects, so a forged cname can take a site's
      // last working origin down with it.
      // Those keys are Admin-SDK-only (org APIs bypass rules); staff keep
      // full control for tooling.
      // `disabledPlugins` is the per-site plugin boundary (AGL-1014) — an
      // owner/admin control, so an editor (or collaborator) must not be able
      // to widen their own site's plugin set by rewriting the deny-list.
      // `cnameAttachmentPending`/`cnameDetachmentPending` join `cname` for the
      // same reason `cname` is here at all (AGL-1364). `liveCustomDomain`
      // refuses to redirect on THREE conditions and only one of them was
      // protected: `cnameAttachmentPending` means the Vercel attach never
      // landed — the domain is claimed in Firestore and serves nothing, no
      // certificate, no routing — so it is the flag that stops
      // `{sub}.aglyn.app` sending visitors onto a dead host. An editor able to
      // clear it takes the site's last working origin down, which is the
      // outcome denying `cname` was meant to prevent, through the key nobody
      // listed. Both are written only by /api/domains/attach and
      // /api/domains/detach; the console reads them and never writes them.
      // `themeInstalledFrom` is theme provenance written only by the install
      // route — a client rewrite makes `isOverrideForCurrentTheme()` lie about
      // which marketplace theme an override belongs to, the same reason
      // `templates.source` is frozen below.
      // `projectId`/`projectNumber` are the Enterprise siloed-project pointers
      // and have no client writer at all.
      // `suspendedAt`/`suspendedReasonCode`/`suspendedMessage`/
      // `suspendedUntilMs`/`suspendedMode` are the STAFF host takedown
      // (AGL-1501) — the site 503s while they are set, or freezes its writes
      // while keeping serving when `suspendedMode` is `read-only` (AGL-1511),
      // which is exactly why that key must be as unwritable as the rest: a
      // client that could set it could DOWNGRADE its own takedown. Deliberately not `maintenance`, which is the
      // customer's own switch: a security takedown the site's editors could
      // clear from the client SDK would not be a takedown. Written only by
      // /api/admin/lockdown through the Admin SDK.
      //
      // Freezing the KEYS was only ever half of it (AGL-1965). `screens` is
      // the live screen directory and it is deliberately NOT in the list
      // above — publishing writes it from the browser — so while suspension
      // was unreadable by any rule, a suspended site's editor could not
      // shorten their own takedown and could still republish through it.
      // `hostWritesFrozen` is the other half: the whole non-staff branch now
      // stands down while `suspendedAt` is set, at host scope as well as org.
      allow update: if isStaff() ||
        (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['memberRoles', 'orgId', 'admins', 'hosts', 'subdomain',
                     'cname', 'cnameAttachmentPending',
                     'cnameDetachmentPending', 'themeInstalledFrom',
                     'suspendedAt', 'suspendedReasonCode', 'suspendedMessage',
                     'suspendedUntilMs', 'suspendedMode',
                     'projectId', 'projectNumber']) &&
          (hostMemberRole(hostId) == 'admin' ||
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['disabledPlugins'])));
      allow delete: if isStaff() ||
        (hostMemberRole(hostId) == 'admin' && !hostWritesFrozen(hostId));
      // Screen/layout DOC creates are API-only (AGL-473): /api/hosts/
      // resources enforces screensPerHost / sharedLayoutsPerHost (and the
      // owning org's suspension) server-side. Their `versions` (and any
      // other) subcollections stay editor-writable — not quota-governed.
      // These are carved OUT of the catch-all below (rules OR their allows,
      // so a dedicated deny can't win unless the catch-all stops matching).
      // Version CREATE is API-only (AGL-1369); update/delete stay client-side.
      //
      // `versioning` (Pro+) was a UI gate only: the console checked the
      // entitlement and then wrote `versions/{new}` with the client SDK, so a
      // Free org got Pro version history by writing the document directly.
      //
      // The split that makes this enforceable is create-vs-update, and it is
      // exact. An ordinary canvas save is `transaction.set(ref, …, {merge:true})`
      // on a version doc that ALREADY EXISTS (see `saveNodesGuarded`) — a rules
      // UPDATE, which stays open on every plan. Authoring is untouched.
      // A rules CREATE means one more version document than there was before,
      // which is precisely what the entitlement sells. /api/hosts/versions owns
      // it: the route counts the existing versions with the Admin SDK and
      // allows the FIRST one on any plan (a resource must have a version to be
      // editable at all), requiring `versioning` only to retain a second.
      //
      // Rules alone cannot make that call. The tempting test — "allow the
      // create when the parent's `versionId` already points at it" — is
      // defeated in two writes, because publishing is a legitimate client
      // action and so the parent's `versionId` is client-writable: point it at
      // the id about to be created, create, then point it back. Counting
      // documents is not something rules can do, which is why this is a route
      // and not a condition.
      // The two fields `countBillableScreens` subtracts on are frozen against
      // the client (AGL-1383), for the same reason `collections.kind` is
      // frozen below: a field the console reads as descriptive metadata is an
      // INPUT TO A PAID LIMIT, and it was writable by the party the limit is
      // enforced against.
      //
      // `kind` is set once, by /api/hosts/resources, and no client path has
      // ever written it again — the email composer sends it on the CREATE the
      // route owns, and `kind: 'email'` is what takes a screen off
      // `screensPerHost`. `deletedAt` is write-ONCE rather than frozen,
      // because soft-delete is a legitimate client write (the screens page and
      // the Emails card both stamp it) — what is denied is clearing or moving
      // it, i.e. UN-deleting, which no console surface offers.
      //
      // Both halves matter because the quota is a CREATE-TIME gate and nothing
      // re-counts afterwards. Without this, either field could be flipped on
      // and back off in a loop — create five, mark them excluded, create five
      // more — minting permanent slots a plan never sold, which no amount of
      // counting correctly at the moment of create can see. Serve-side refusal
      // and the routing-map count make an excluded screen worthless while it
      // is excluded; this is what stops it being laundered back into a page.
      match /screens/{screenId} {
        allow read: if isStaff() || isHostAdmin(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['kind']) &&
            !(('deletedAt' in resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['deletedAt'])));
        allow delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostAdmin(hostId);
          allow create: if isStaff();
          allow update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }
      }
      match /layouts/{layoutId} {
        allow read: if isStaff() || isHostAdmin(hostId);
        allow create: if isStaff();
        allow update, delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostAdmin(hostId);
          allow create: if isStaff();
          allow update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }
      }
      // Reusable components (AGL-679) now carry editing history like screens
      // and layouts. The component DOC stays API-create-only (the catch-all
      // below excludes `components`, and the resources route enforces the
      // reusableComponents entitlement) — but its `versions` subcollection
      // has to be client-writable, and the catch-all's create exclusion is
      // by collection NAME, so `components/{id}/versions/{v}` was caught by
      // it too. This dedicated block carves the versions back out.
      match /components/{componentId} {
        allow read: if isStaff() || isHostAdmin(hostId);
        allow create: if isStaff();
        allow update, delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        match /{sub}/{document=**} {
          allow read: if isStaff() || isHostAdmin(hostId);
          allow create: if isStaff();
          allow update, delete: if isStaff() ||
            (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
        }
      }
      // Templates (AGL-666): saved starting points for pages, components and
      // layouts, and where marketplace downloads land instead of becoming
      // live pages. Creates go through /api/hosts/resources like screens and
      // layouts so templatesPerHost is enforced server-side.
      //
      // `source` is frozen on update: it records whether a template was
      // authored here, downloaded from the marketplace, or came from a
      // first-party starter, and the library shows that to the user. A client
      // able to rewrite it could stamp marketplace provenance on its own work.
      match /templates/{templateId} {
        allow read: if isStaff() || isHostAdmin(hostId);
        allow create: if isStaff();
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['source']));
        allow delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
      }
      // Secret-/PII-bearing subcollections are carved out of the viewer-
      // readable catch-all below (AGL-502): `webhooks` docs hold an HMAC
      // signing secret + target URL, and `orders` hold customer PII/payment
      // data — reads are admin/editor only, never viewer.
      //
      // Webhook CREATE is now API-only (AGL-1360) — see the catch-all's
      // create exclusion below. The console used to create them client-side
      // and enforce WEBHOOK_MAX_PER_HOST by counting the rows its Firestore
      // LISTENER held; with `persistentLocalCache` that count could be
      // arbitrarily stale and low, so the cap was bypassable. Update/delete
      // stay client-side (delete is a soft delete, and neither consumes a
      // slot the cap has not already granted).
      match /webhooks/{webhookId} {
        allow read: if isStaff() || canWriteHostContent(hostId);
      }
      // Order STATUS is server-owned (AGL-1827). Every transition goes
      // through an Admin-SDK route that re-asks ORDER_TRANSITIONS inside the
      // transaction that writes it — cancel (AGL-1808/1818), fulfil and
      // mark-delivered (AGL-1819), refund, the supplier update and the
      // webhook paths — so a client write of `status` is by definition a
      // bypass of that guard, the stale-dialog hole those routes closed.
      // `orders` therefore joins all THREE catch-all exclusion lists below
      // (one list is not denial, and a bare deny here would lose the OR),
      // and this block re-grants exactly what the console still legitimately
      // writes client-side: the order-detail dialog's note (`timeline` only)
      // and its restock answer (`restockCheck` + `timeline`, AGL-1806). The
      // key-diff is on VALUES (the AGL-1795/1813/1824 pattern), so a patch
      // that names `status` unchanged is not refused. No client path creates
      // or deletes an order — creates are checkout/POS/draft/webhook routes,
      // and delete stays closed because delete-and-recreate would re-mint
      // the document with any status at all.
      match /orders/{orderId} {
        allow read: if isStaff() || canWriteHostContent(hostId);
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
           !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['status']));
      }
      // The extra {subcollection} segment matters: a bare {document=**}
      // matches ZERO or more segments in rules v2, i.e. the host doc
      // itself too — which would let editors delete the host through
      // this write rule (caught by rules-tests, AGL-235).
      match /{subcollection}/{document=**} {
        // `mediaTombstones` joins the READ exclusion too (AGL-1467), which
        // `webhooks`/`orders` are the only other members of. A tombstone holds
        // a deleted media document VERBATIM — file name, alt text,
        // description, tags, custom metadata, the `visibleTo` tokens that
        // decided who could see the asset — and it is written and consumed
        // entirely by /api/media/upload and /api/media/restore, which use the
        // Admin SDK and are not subject to these rules. Nothing in the console
        // lists them, deliberately: a browsable copy of deleted customer
        // content is the object AGL-1443 is open on, and the undo affordance
        // does not need one. No client read means no such surface can appear
        // by accident.
        allow read: if isStaff() ||
          (isHostAdmin(hostId) &&
            !(subcollection in ['webhooks', 'orders', 'mediaTombstones']));
        // Quota-governed collections are created via /api/hosts/resources
        // ONLY (AGL-473) — the route enforces the per-plan quota (and the
        // feature entitlement, where paid) server-side. These flat
        // collections have no client-written subcollections, so denying
        // client `create` by name is safe. Screens/layouts also appear
        // here — their dedicated blocks above own create; excluding them
        // from update/delete too keeps this catch-all from re-granting.
        // `installs` (plugin pins) are create/update API-only (AGL-508): the
        // install route enforces entitlement + purchase + kill-switch before
        // writing the pin; only DELETE (uninstall) stays client-side, so
        // update/delete is split to allow the console's uninstall.
        // `datasets` is excluded from all three (AGL-1050). Datasets moved to
        // the org in AGL-237 and the org block above has enforced API-only
        // create/delete since AGL-473/945 — but this catch-all never learned
        // the name, so `hosts/{hostId}/datasets/*` stayed a client-writable
        // path with NO quota enforcement: the same resource, one path over,
        // free. Nothing in production lives there (AGL-1061 counted 0 across
        // every host) and AGL-1050 removed the client fallback that used to
        // address it, so the exclusion takes the whole subtree — `records`
        // included, since {document=**} spans them — with nothing to re-grant.
        // `webhooks` joins the exclusion (AGL-1360): WEBHOOK_MAX_PER_HOST is
        // a flat platform cap that was only ever checked in the console, by
        // counting listener rows, so it did not survive a stale cache.
        // /api/hosts/resources now counts the live webhooks server-side.
        //
        // `counters`, `analytics` and `members` join all THREE lists
        // (AGL-1367). AGL-1360 moved a cap off a client-held COUNT; these are
        // the same untrusted number persisted in a client-writable DOCUMENT,
        // which is strictly worse — it survives the page.
        //
        //   - `counters` is the entire enforcement state of five quotas.
        //     `formSubmissionsPerMonth`, `emailSendsPerMonth`,
        //     `workflowRunsPerMonth` and `actionRunsPerMonth` each read
        //     `counters/<name>[YYYY-MM]`, compare, and proceed; `storagePerHostMb`
        //     reads `counters/media.bytes`. Every one is read-compare-proceed,
        //     so writing the counter back to 0 removes the wall — and for
        //     storage that is unbounded Firebase Storage against a Free plan's
        //     250 MB, real infrastructure cost rather than a feature.
        //   - `analytics/{day}.total` is the month's page views.
        //   - Both are ALSO the metered invoice: /api/billing/report-usage
        //     computes `storageBytes`, `formSubmissions` and `pageViews` from
        //     exactly these documents, and AGL-1280 turned the metered
        //     pass-through on for every paid plan. Lowering a counter lowers
        //     the customer's bill. `rateLimits` states the principle above —
        //     a client that can write a counter can reset its own counter.
        //   - `members` is the site roster. A raw delete does NOT revoke
        //     anything (real access lives in `orgs/{orgId}/members/{uid}
        //     .hostAccess`, which is `write: false`, projected into the frozen
        //     `memberRoles`), but the seat cap in /api/hosts/members counts
        //     these rows — so deleting N rows leaves N collaborators working
        //     and frees N seats to sell to nobody, at $1-3/seat.
        //
        // A dedicated `match /counters/{counterId} { allow write: if false; }`
        // would NOT have closed any of this: sibling match blocks are OR'd and
        // the LOOSER one wins, so the catch-all would have re-granted every
        // write. The exclusion lists ARE the mechanism, exactly as for
        // `webhooks`. Nothing is lost: every writer of all three is an
        // Admin-SDK route, and every client reference in the console and the
        // plugin components is a read, which the catch-all's `allow read`
        // above still grants.
        //
        // `mediaTombstones` joins all three as well (AGL-1467), and for the
        // `counters` reason rather than the privacy one above: a restore
        // re-increments `counters/media` by the tombstone's OWN `sizeBytes`.
        // A client that could write a tombstone could therefore hand itself a
        // negative `sizeBytes` and lower the storage meter — AGL-1367's
        // read-compare-proceed wall, reached one collection to the left — or
        // forge a media document with `visibleTo` tokens it was never granted.
        // A client that could DELETE one destroys the only route back to an
        // asset it just deleted. Both writers are Admin-SDK routes.
        //
        // `formSubmissions` joins CREATE ONLY (AGL-1668), and the asymmetry is
        // the decision rather than an oversight. `counters` above is the
        // number; this is the ROW the number counts. /api/forms/submit is its
        // only writer and it increments `counters/formSubmissions[YYYY-MM]` in
        // the same request — the document /api/billing/report-usage invoices
        // from, and the one AGL-1655's abuse ceiling is evaluated against. A
        // client `add()` here entered neither: an editor could hold
        // submissions the Free plan's 20/month wall would have refused, and
        // paid rows the meter never billed. Not a spam vector (it needs
        // membership) and NOT a way to lower a bill either — AGL-1367 already
        // made the counter itself unreachable on all three operations, so the
        // ceiling's read point was never the exposure. Only the create path
        // was.
        //
        // Update and delete stay OPEN, deliberately. The inbox plugin marks a
        // submission read with a client `updateDoc` and deletes one with a
        // client `deleteDoc` — the product's own reader — and neither touches
        // the counter, which is monotonic per month and does not fall when a
        // row is removed. Following the `counters` precedent onto all three
        // lists would have broken the inbox to close nothing.
        //
        // `orders` joins all THREE lists (AGL-1827): status is server-owned,
        // and the dedicated block above owns the reasoning and re-grants the
        // one thing the console still writes — the status-frozen update.
        allow create: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'variables',
              'functions', 'workflows', 'services', 'redirects',
              'locations', 'products', 'components', 'registers', 'installs',
              'templates', 'collections', 'datasets', 'webhooks', 'orders',
              'counters', 'analytics', 'members', 'mediaTombstones',
              'formSubmissions']));
        // `templates` is excluded from update as well as create: its
        // dedicated block above freezes `source`, and leaving it here would
        // re-grant the unrestricted update this catch-all allows (AGL-666).
        // `collections` is excluded from create and update (AGL-978): the
        // slug is the collection's public address and must be claimed
        // transactionally, like the host subdomain (AGL-642), so
        // /api/hosts/collections owns both. The dedicated block below
        // re-grants the non-identity updates the console still makes
        // client-side (template assignment, categories).
        // `registers` joins update and delete (AGL-1775). It was excluded from
        // create only, which is not denial: the POS register add-on is a
        // per-org POOL allocated per site, the billing rollup reads these
        // docs, and an editor who can rewrite or delete one can re-allocate
        // registers the org is billed for. Same shape as AGL-1367 — a
        // document the invoice is computed from is a document the customer
        // must not be able to write. Allocation is an Admin-SDK route, so
        // denying the client changes nothing about the product.
        //
        // Re-applied after fcf1017eb reverted it from a stale worktree. If
        // this comment is here and `registers` is NOT in both lists below,
        // the same clobber has happened a third time — the coverage spec
        // host-subcollection-write-deny-coverage is what catches it.
        allow update: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'installs',
              'templates', 'collections', 'datasets', 'orders', 'registers',
              'counters', 'analytics', 'members', 'mediaTombstones']));
        // `collections` joins the delete exclusion (AGL-947): a collection
        // owns `entries`, Firestore doesn't cascade, and a client delete
        // orphaned them — /api/resources/erase recursiveDeletes instead.
        // The exclusion is by NAME and {document=**} spans deeper paths, so
        // it would take single-entry deletes with it; the block below
        // re-grants those (rules OR, so a dedicated allow still wins).
        allow delete: if isStaff() ||
          ((canWriteHostContent(hostId) && !hostWritesFrozen(hostId)) &&
            !(subcollection in ['screens', 'layouts', 'collections',
              'datasets', 'orders', 'registers', 'counters', 'analytics',
              'members', 'mediaTombstones']));
      }
      // Editors keep full client control of a collection doc EXCEPT the two
      // identity keys. `slug` is its public address (uniqueness is claimed in
      // /api/hosts/collections) and `kind` decides which console surface owns
      // it — a client rewrite of either is the AGL-954 collision or the
      // AGL-957 shadowing, back again.
      //
      // The three template pointers were frozen here too (AGL-1390), because
      // they were the last exclusion `countBillableScreens` made that the
      // metered party could both apply and REVERSE: point `entryScreenId` at a
      // live screen and it stopped counting, create a screen through the
      // create-time gate, clear the pointer and the screen counted again — one
      // free slot per cycle, unbounded.
      //
      // AGL-1400 took the entitlement out of the pointer. An entry template
      // says what it is on its OWN document (`kind: 'template'`, on
      // `screens/{screenId}`, frozen four blocks up since AGL-1383), the count
      // reads nothing else, and clearing a pointer therefore raises no count —
      // it leaves an orphaned template, and promoting one back to a page is a
      // gated act on /api/hosts/screens. So these three are a pointer again,
      // with nothing to launder through them, and the freeze is lifted rather
      // than left standing as a rule whose reason has gone. /api/hosts/
      // collections keeps the write while it also owns the CONVERSION that goes
      // with designating an entry template; what it no longer needs is the
      // rules to make it the only writer.
      match /collections/{collectionId} {
        allow update: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['slug', 'kind']));
      }
      // Entries are a separate resource that merely lives underneath, so the
      // name-based exclusions above must not reach them: create/update/delete
      // stay editor-writable here (rules OR, so a dedicated allow wins).
      match /collections/{collectionId}/entries/{entryId} {
        allow create, update, delete: if isStaff() ||
          (canWriteHostContent(hostId) && !hostWritesFrozen(hostId));
      }
    }

    // User profile docs (AGL-158): the console account page reads/writes
    // users/{uid}; the AGL-42 hardening dropped the blanket rule without
    // adding this match, which default-denied the collection.
    match /users/{userId} {
      allow read, write: if isStaff() ||
        (isSignedIn() && request.auth.uid == userId);

      // "My organizations" reverse index (AGL-233): API-maintained
      // beside the member docs; each user reads only their own.
      match /orgs/{orgId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // "My sites" reverse index (AGL-844): API-maintained mirror of each
      // host's memberRoles, so the site switcher and subdomain routing query
      // a user's own hosts by name without scanning the hosts collection.
      // Owner-read, server-written; a convenience index, not an auth source.
      match /hostMemberships/{hostId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // In-app notifications (AGL-259): Admin-SDK-written fan-out; the
      // owner reads, marks read (update), and clears them.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() &&
          request.auth.uid == userId;
        allow create: if false;
      }

      // Passkey credentials (AGL-662): SERVER-WRITE ONLY — a client-writable
      // credential store is a full auth bypass (swap in your own public key,
      // sign in as anyone). The owner reads their own list for the
      // management UI; every write goes through the Admin SDK ceremony
      // endpoints.
      match /passkeys/{credentialId} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }

      // Clickwrap acceptance records (AGL-1497): SERVER-WRITE ONLY, for the
      // same reason as passkeys above — this is evidence ABOUT the person who
      // would be writing it. A client-writable acceptance could be forged
      // ("I never agreed to that version"), back-dated, or deleted outright,
      // which is precisely the dispute the record exists to settle. One
      // document per accepted version, written by the Admin SDK with a server
      // timestamp; the owner may read their own history, and nobody amends it.
      match /legalAcceptances/{version} {
        allow read: if isStaff() ||
          (isSignedIn() && request.auth.uid == userId);
        allow write: if false;
      }
    }

    // WebAuthn machinery (AGL-662): server-only, both of them. Challenges
    // are single-use secrets; the credential index maps credentialId → uid
    // and is consulted before minting sign-in tokens. Subcollection-less
    // top-level docs would already be denied by default — the explicit
    // matches document that the denial is load-bearing.
    match /webauthnChallenges/{challengeId} {
      allow read, write: if false;
    }
    match /passkeyCredentialIndex/{credentialId} {
      allow read, write: if false;
    }

    // Marketplace marketplace (AGL-44). Profiles are public publisher pages
    // keyed by the publisher's uid; the owner or staff may write. Handle
    // and names are length-capped here since any owner writes client-side.
    match /profiles/{profileUid} {
      allow read: if true;
      // handle/displayName are length-capped since the owner writes client
      // side. `stripeAccountId` (payout destination) and `stripeChargesEnabled`
      // (payments-enabled gate) are set ONLY server-side after Connect
      // onboarding/KYC and are trusted by every checkout path — the client
      // must never set or change them (block on create, freeze on update).
      function profileFieldsValid() {
        return request.resource.data.handle is string &&
          request.resource.data.handle.size() >= 3 &&
          request.resource.data.handle.size() <= 30 &&
          request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 80;
      }
      function profileOwner() {
        return isStaff() || (isSignedIn() && request.auth.uid == profileUid);
      }
      allow create: if profileOwner() && profileFieldsValid() &&
        !request.resource.data.keys()
          .hasAny(['stripeAccountId', 'stripeChargesEnabled']);
      allow update: if profileOwner() && profileFieldsValid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['stripeAccountId', 'stripeChargesEnabled']);
    }

    // Org publisher identity (AGL-652). Publishing is ORG-ONLY: this is the
    // org's public marketplace presence, keyed by org id so authorization is
    // a plain role check with no ownership indirection. Public read — buyers
    // see who they are installing from. `profiles/{uid}` above stays as the
    // personal identity (the support forum renders author names from it) and
    // is no longer a publisher.
    match /publisherProfiles/{orgId} {
      allow read: if true;
      // The org rules' helpers are scoped to `match /orgs/{orgId}`, so this
      // block resolves membership itself. `exists()` first: reading `.data`
      // off a missing member doc errors rather than denying cleanly.
      function publisherManager() {
        return isStaff() || (isSignedIn() &&
          exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid))
            .data.role in ['owner', 'admin']);
      }
      function publisherFieldsValid() {
        return request.resource.data.handle is string &&
          request.resource.data.handle.size() >= 3 &&
          request.resource.data.handle.size() <= 30 &&
          request.resource.data.handle.matches('[a-z0-9][a-z0-9-]*') &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 80;
      }
      // The payout keys decide who receives money — Connect route only.
      // `handle` is equally server-owned: it must be claimed transactionally
      // in `publisherHandles` (AGL-652), and a client read-then-write lets
      // two orgs racing for one handle both "succeed", silently taking each
      // other's marketplace URL. Creates go through the save route entirely;
      // updates may edit the cosmetic fields but never the handle.
      //
      // `publisherAgreement` (AGL-1077) is server-owned for the same reason
      // the payout keys are: an acceptance the accepting party can forge is
      // not evidence of anything. It is written only by the
      // `accept-agreement` action, which checks the submitted version
      // against the one in force.
      allow create: if false;
      // The AGL-1009 contact/link fields are server-owned too: the save
      // route is what enforces https-only and the fixed social hosts, and a
      // client that could write `avatarUrl` directly could store a
      // `javascript:` URL the storefront would then have to distrust.
      allow update: if publisherManager() && publisherFieldsValid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['handle', 'stripeAccountId', 'stripeChargesEnabled',
                   'publisherAgreement', 'avatarUrl', 'website',
                   'supportEmail', 'supportUrl', 'githubUrl', 'xUrl',
                   'linkedinUrl']);
      allow delete: if isStaff();
    }

    // Handle uniqueness (AGL-652), mirroring orgSlugs: public read so a
    // handle resolves pre-auth, and claimed ONLY by the publish API inside a
    // transaction. Client-writable reservations would race, and whoever wrote
    // last would take another publisher's marketplace URL.
    match /publisherHandles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // Listings are public reads. Creates and version snapshots happen ONLY
    // through the publish API (Admin SDK, server-side sanitization) — no
    // client create. Owners may update/delete their own listing metadata
    // (unpublish via deletedAt); staff may moderate anything.
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if false;
      // Listings are ORG-owned since AGL-652, so `profileId` holds an org
      // id. The owner check used to compare it to `request.auth.uid`, which
      // a uid can never satisfy — it did not error, it just silently denied
      // every publisher access to their own listing. Same shape as the
      // publisherProfiles block above; `exists()` first because reading
      // `.data` off a missing member doc errors rather than denying.
      function listingManager() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/orgs/$(resource.data.profileId)/members/$(request.auth.uid))
            .data.role in ['owner', 'admin'];
      }
      // Owners toggle metadata (deletedAt un/republish) client-side, but
      // must NOT touch server-managed fields (AGL-503): installCount is
      // incremented by the install API (ranking integrity), priceUsd gates
      // purchases, and profileId is the ownership key. The review verdict is
      // equally server-owned (AGL-651): `reviewStatus` decides both the
      // trust badge and whether a plugin is publicly browsable at all, so an
      // owner who could write it could self-promote to 'verified' and skip
      // staff review outright. Delete stays open to the owner; staff moderate
      // anything.
      allow update: if isStaff() ||
        (listingManager() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['installCount', 'priceUsd', 'profileId',
                     'reviewStatus', 'reviewedBy', 'reviewedAt',
                     'rejectionReason',
                     // The newest version that passed review (AGL-1016),
                     // denormalised here because `pluginVersions` is
                     // server-only. It is what the console's update badge
                     // offers, so a publisher who could write it could
                     // advertise unreviewed code as an available update —
                     // the exact leak AGL-966 closed.
                     'latestApprovedVersion',
                     // Rating aggregates (AGL-655) drive ranking and the
                     // trust signal buyers read, so they are maintained by
                     // the reviews API alone — a publisher who could write
                     // them could invent a five-star average.
                     'ratingSum', 'ratingCount', 'ratingAverage',
                     'commentCount',
                     // `installCount`'s live sibling and AGL-1419's derived
                     // cache for it (AGL-1420). `installCount` was denied on
                     // the first pass and `activeInstalls` was not, though
                     // the listing header and the browse grid print both —
                     // it was invisible to the AGL-1361 guard because it was
                     // in neither this list nor `MarketplaceListing`, which
                     // is the guard's whole field universe. The cache triple
                     // is worse than a wrong number: `verifiedLivePins`
                     // treats it as FRESH when `pinnedActiveInstalls` equals
                     // `activeInstalls` inside the TTL and then serves
                     // `pinnedVersionInstalls` without querying, so writing
                     // all four pins the cache open on chosen numbers and
                     // suppresses the re-derivation that exists to bring a
                     // count back DOWN.
                     'activeInstalls', 'pinnedActiveInstalls',
                     'pinsVerifiedAtMs', 'pinnedVersionInstalls',
                     // Staff takedown (AGL-658). An owner who could clear
                     // `hiddenAt` could un-hide their own listing, which
                     // makes moderation a suggestion.
                     'hiddenAt', 'hiddenBy', 'hiddenReason',
                     // The artifact discriminators (AGL-1364). Denying
                     // `reviewStatus` closed self-promotion, but
                     // `isListingBrowsable` only CONSULTS reviewStatus when
                     // the listing is a plugin — pre-publication review is
                     // plugin-only, because plugins execute code. So a
                     // publisher whose plugin sits at 'submitted' or
                     // 'rejected' could write `artifactType: 'component'` and
                     // become publicly browsable without ever touching the
                     // field the gate reads. All three are denied because
                     // `listingArtifactType` falls back through them in turn:
                     // `artifactType`, then `kind == 'template'`, then
                     // `type == 'plugin'`.
                     'artifactType', 'type', 'kind',
                     // The publisher's standing ask for the Verified badge
                     // (AGL-1217) is server-owned by its own doc comment: the
                     // publisher route only moves it to pending/withdrawn and
                     // only staff decide it. The staff queue is built by
                     // filtering `state == 'pending'`, so a client write is a
                     // way into the queue and a way to erase a declineReason.
                     'verificationRequest',
                     // `latestApprovedVersion` above is the offer for PLUGINS;
                     // for every other artifact type the offer is
                     // `latestVersion` (marketplace-update-state.ts). Denying
                     // one sibling and not the other left the same advertise-
                     // anything hole open one artifact type over.
                     'latestVersion',
                     // The rest of the type's own "Server-managed" banner:
                     // written by the publish/install/review paths, never by
                     // a client. The only client write to a listing anywhere
                     // in the repo is the unpublish toggle, which writes
                     // `deletedAt` alone — so denying these costs nothing.
                     'publisherOrgId', 'sourceComponentId', 'sourceHostId',
                     'versionHistory', 'screenCount', 'previewImageUrl',
                     'createdAt', 'updatedAt',
                     // Listing ARTWORK (AGL-1701). `previewImageUrl` was
                     // denied on the pass above and its two siblings were
                     // not, though all three end up in an `<img src>` that
                     // OTHER orgs' users load — `logoUrl` and every entry of
                     // `screenshots` are handed straight to `src` by
                     // listing-content.component.tsx, and `logoUrl` is also
                     // an `og:image` an UNAUTHENTICATED unfurler fetches.
                     //
                     // `validateListingContent` now holds these to
                     // first-party media, which is the actual fix; this line
                     // is what makes that fix load-bearing rather than
                     // advisory. `marketplaceListings` is `allow read: if
                     // true` and a listingManager is any org owner/admin, so
                     // while these keys were writable here the API was one
                     // way to set them, not the way — a publisher could put
                     // an arbitrary beacon host in either field with a direct
                     // client write and never touch the route that validates.
                     //
                     // Costs nothing for the same reason the block above
                     // does: the listing editor saves through
                     // `/api/marketplace/publish-plugin` (`update-listing`),
                     // and the only client write to a listing in the repo is
                     // the unpublish toggle, which writes `deletedAt` alone.
                     'logoUrl', 'screenshots']));
      allow delete: if isStaff() || listingManager();
      // Version snapshots hold the actual (possibly paid) content — no
      // client reads; installs go through /api/marketplace/install, which
      // checks the purchase record server-side (AGL-46).
      match /versions/{version} {
        allow read, write: if isStaff();
      }
      // Ratings and comments (AGL-655). Public read so the detail page can
      // render them without auth. Writes are API-ONLY: the route decides
      // whether the author is a verified installer, blocks the publisher's
      // own org, and adjusts the listing aggregates in the same
      // transaction. Letting a client write here would make every one of
      // those checks advisory.
      match /reviews/{authorUid} {
        allow read: if true;
        allow write: if false;
      }
      // Plugin version records hold the artifact sha256 + manifest (AGL-45).
      // Server-only, same as component versions: installs go through
      // /api/marketplace/install-plugin, which checks entitlement + kill
      // switch and copies the pin into the host's installs.
      match /pluginVersions/{version} {
        allow read, write: if isStaff();
      }
    }

    // Immutable base snapshots of installed marketplace content (AGL-1015),
    // keyed by their own content hash. Written only by the install routes
    // through the Admin SDK, and never rewritten — a document at a given hash
    // already holds byte-identical content, which is what makes re-installing
    // the same version free.
    //
    // Closed to clients in both directions. Reads because a base can hold paid
    // content: the hash is recorded on the installed document, so a client that
    // could read this collection could fetch any listing's content by hash
    // without buying it — exactly the leak the version subcollection is closed
    // for. The diff and reset paths (AGL-1018) read it server-side.
    match /marketplaceArtifactBases/{sha256} {
      allow read, write: if false;
    }

    // Plugin kill switch (AGL-45): loaders check this before executing a
    // pinned plugin, so it is a PUBLIC read; only staff (or the Admin SDK)
    // may write a revocation.
    match /revocations/{listingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Lockdown records (AGL-1501): `platform` and `user--{uid}` docs — the
    // two panic-button scopes with no existing carrier (org and host
    // lockdowns live on their own docs as `suspendedAt` families). Staff-only
    // READS: enforcement happens server-side through the Admin SDK, and the
    // visitor-facing notice is served by an API route that returns only the
    // sanitized reason/message — a public read here would let anyone
    // enumerate which users are locked. Writes are closed to everyone
    // INCLUDING staff clients on purpose: /api/admin/lockdown is the only
    // writer, because a lockdown write must also revoke sessions, fan out
    // projections and revalidate cached pages — a bare client write would be
    // a lockdown that looks set and enforces nothing.
    match /lockdowns/{lockdownId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Public abuse reports (AGL-1964) — the intake the lockdown levers above
    // never had. Written by POST /api/report-abuse, which is unauthenticated
    // by design: the people who find a phishing site on `*.aglyn.app` are a
    // bank's fraud team, a browser vendor or Safe Browsing, and none of them
    // has an account here.
    //
    // Staff-only READS, for both of the reasons `marketplaceReports` is
    // staff-only and one more. A row can name its reporter, and letting the
    // reported party see who reported them invites retaliation — sharper here
    // than on a marketplace listing, because a DMCA notice carries a real
    // legal name by statute. And the collection as a whole is a map of which
    // sites are under suspicion, which would tell an abuser whether they had
    // been noticed yet.
    //
    // Writes closed to EVERYONE including staff clients, the /lockdowns and
    // /contactSuppressions posture rather than `marketplaceReports`'s. Two
    // reasons, and the first is the load-bearing one:
    //
    //  - **The reporter is not authenticated, so the document id is the only
    //    thing standing between the queue and a forgery.** The route derives
    //    it from a one-way hash of (url, category, reporter IP) precisely so
    //    one source reporting one page repeatedly merges into one row instead
    //    of looking like a groundswell. A client that could choose its own id
    //    could manufacture that groundswell against a competitor's site — and
    //    the queue's whole value is that a human believes it.
    //  - A staff status change (`open` → `actioned`) is not one document
    //    write: it is the moment a lockdown or a quarantine gets justified, so
    //    it goes through an Admin-SDK route that writes the `adminAudit` row
    //    in the same act. A bare client write would be a decision with no
    //    record of who made it.
    match /abuseReports/{reportId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Marketplace purchase records (AGL-46): written only by the Stripe
    // webhook (Admin SDK). Buyers read their own purchases (install
    // gating); sellers read sales of their listings (revenue ledger).
    // Abuse reports on listings and reviews (AGL-658). Staff-only reads:
    // a report names its reporter, and letting a publisher see who reported
    // them invites retaliation. Written through /api/marketplace/report so
    // the reporter is the verified token, never a client-supplied uid.
    match /marketplaceReports/{reportId} {
      allow read, write: if isStaff();
    }

    match /marketplacePurchases/{purchaseId} {
      // The seller is an ORG (AGL-652), so the sales side is a membership
      // check, not a uid match — a uid never equals an org id, and leaving
      // the old comparison would hide every publisher's own revenue.
      allow read: if isStaff() || (isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid ||
         exists(/databases/$(database)/documents/orgs/$(resource.data.sellerOrgId)/members/$(request.auth.uid))));
      allow write: if false;
    }

    // Staff-only, append-only audit log of admin actions
    // ({ actorUid, action, target, before, after, at }), plus an optional
    // top-level { reason, note } pair recording WHY — required by the staff
    // override dialog since AGL-1652, and rendered on all three staff
    // surfaces that read these rows.
    //
    // The shape is NOT validated here, deliberately: every field above is
    // already trusted from a staff client, and a rule that policed one
    // action's `reason` would imply the rest are enforced when they are not.
    // The reason gate lives where the override is actually made.
    match /adminAudit/{entryId} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    // Do-not-contact list for marketing calls and texts (AGL-1592), the
    // mechanism behind Privacy Policy v4 §11. One document per phone number,
    // id = the E.164 digits without the leading '+'.
    //
    // Read is staff-only because the collection IS a list of phone numbers,
    // annotated with the fact that each one asked us to stop — which is more
    // sensitive than the numbers alone, not less.
    //
    // Write is closed to EVERYONE INCLUDING STAFF CLIENTS, deliberately, and
    // for the same reason as /lockdowns: recording an opt-out is not one
    // document write. It has to normalize the number to E.164 (an id computed
    // client-side would land the record where nothing looks for it), union
    // the channels rather than overwrite them, and — on an erasure request —
    // clear the profile copy and stamp the marker that stops SSO re-asserting
    // it. A bare client write would produce a suppression that looks recorded
    // and suppresses nothing, which is the exact failure this collection was
    // created to end.
    //
    // Delete stays closed to everything, Admin SDK aside. Opting back in is
    // `revokedAt` on the existing document: the record is the evidence that
    // the request was honoured while it was in force, and a deleted record
    // cannot show that.
    match /contactSuppressions/{phoneKey} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Designed templates for Aglyn's own outbound email — invites, usage
    // summaries, staff alerts (AGL-747). Platform-level, not per-org: there
    // is no membership to check, only the staff claim.
    //
    // Delete stays closed deliberately. The catalog of system emails is
    // code-defined, so a template document is either present (customized) or
    // absent (using the built-in copy); "reset to default" clears the fields
    // through the same update path rather than removing the document, which
    // keeps the audit trail of who changed what.
    //
    // The send path reads these through the Admin SDK and bypasses rules.
    match /systemEmailTemplates/{templateKey} {
      allow read, create, update: if isStaff();
      allow delete: if false;

      match /versions/{versionId} {
        allow read, create, update: if isStaff();
        allow delete: if false;
      }
    }
  }
}
