# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
tools/plugin-loader/realm/*/dist
/tmp
/out-tsc
/.firebase
/.migrations.json
*.tsbuildinfo
.rollup.cache

# dependencies
/node_modules

# IDEs and editors
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE - Intellij IDEA
#.idea/*
#!.idea/copyright
#!.idea/codeStyles
#!.idea/fileTemplates
#!.idea/file.template.settings.xml
#!.idea/dictionaries

# Environment files
.env
.env.*
!.env.example*
!.env.*.example*

# Log files
*.log

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Next.js
.next

.nx/cache
.nx/workspace-data

vite.config.*.timestamp*
.claude/worktrees
.nx/polygraph
.nx/self-healing
.vercel

# Transient scratch dir written while uploading to the DAM; never source.
.dam-upload-tmp/

# Monaco's `min/vs`, copied out of node_modules by `apps/console/next.config.js`
# at build time (AGL-1779). ~15 MB / 121 files, and it is generated: committing
# it would rot silently against the `monaco-editor` pin in package.json. The
# copy is not optional — the build FAILS if it cannot be produced, because the
# only alternative is `@monaco-editor/loader`'s jsDelivr default.
/apps/console/public/monaco/
