<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.AglynPos" parent="android:Theme.Material.Light.NoActionBar" />

  <!-- The launch screen: the Aglyn mark (the brand kit has no POS mark) on the icon's own background. -->
  <style name="Theme.AglynPos.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.AglynPos</item>
  </style>
</resources>
