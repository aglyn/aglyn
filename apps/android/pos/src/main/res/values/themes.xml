<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The window behind the first Compose frame is the splash's own ground (light, or dark in values-night), so the
       hand-over from the splash never shows a frame of another color (P14). -->
  <style name="Theme.AglynPos" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/aglyn_splash_ground</item>
  </style>

  <!-- The launch screen (AGL-3934): the sign-in ground (bg/canvas, dark in values-night) and the mark drawing in on Android
       12+ (drawable-v31/splash_icon), the still mark before it. MainActivity keeps it up until the auth state is known. -->
  <style name="Theme.AglynPos.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/aglyn_splash_ground</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="windowSplashScreenAnimationDuration">@integer/aglyn_splash_duration</item>
    <item name="postSplashScreenTheme">@style/Theme.AglynPos</item>
  </style>
</resources>
