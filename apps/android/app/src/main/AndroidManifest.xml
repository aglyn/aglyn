<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- No advertising ID and no ad attribution (AGL-4067): Firebase Analytics' library asks for these, and the app never
       uses them. -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Scan stock reads barcodes with the camera; a device without one still works. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />

  <application
    android:name=".AglynApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Aglyn.Starting">
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection"
      android:exported="true"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="aglyn" />
      </intent-filter>
      <!-- Console links open the app, as the console's own app-link documents claim them (AGL-4059): every workspace, site,
           account, billing, support and staff page, and the emailed sign-up, verification, reset and recovery pages and a
           workspace invitation's link (the console's home), which the app finishes itself. The groups below refuse what
           stays in the browser, the same list as the console's apple-app-site-association (consoleAppLinksComponents in
           native-app-association.ts; its spec holds this list to it): framework and route-handler paths, /.well-known, the
           web-only sections and anything under an auth page. Android before 15 ignores the groups; DeepLinks.opensInApp
           then hands such a link straight back to the browser. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" />
        <data android:host="${consoleHost}" />
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/_" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/api" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/api/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/.well-known/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/auth" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/auth/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/edit-access" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/edit-access/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/kiosk" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/kiosk/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/oauth" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/oauth/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/p" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/p/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/signin" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/signin/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/signout" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/signout/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:path="/sso" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/sso/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/account-recovery/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/reset-password/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/signup/" /></uri-relative-filter-group>
        <uri-relative-filter-group android:allow="false"><data android:pathPrefix="/verify-email/" /></uri-relative-filter-group>
      </intent-filter>
    </activity>
    <!-- The home-screen icon (Theme ▸ App icon, LauncherIconSwitcher): one alias of the main activity per icon of the logo
         kit, exactly one enabled. The app's own icon is on until the person picks another. -->
    <activity-alias
      android:name=".LauncherAglyn"
      android:enabled="true"
      android:exported="true"
      android:icon="@mipmap/ic_launcher"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".LauncherLight"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/ic_launcher_light"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".LauncherDark"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/ic_launcher_dark"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <service
      android:name=".MessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- Media uploads from the camera: the camera app writes into the app's cache through this provider. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="aglyn" />
    <!-- Firebase starts from AndroidFirebase alone, never from resources: the build carries google_app_id for Analytics
         (which reads it from there), and Firebase's own init provider would start a half-configured app from it. -->
    <provider
      android:name="com.google.firebase.provider.FirebaseInitProvider"
      android:authorities="${applicationId}.firebaseinitprovider"
      tools:node="remove" />
    <!-- Crash reports and Analytics (AGL-4067): off until FirebaseTelemetrySink.install turns them on, which it does only
         in a release build on production (BuildConfig.TELEMETRY), so nothing is sent before the config decides. -->
    <meta-data
      android:name="firebase_crashlytics_collection_enabled"
      android:value="false" />
    <meta-data
      android:name="firebase_analytics_collection_enabled"
      android:value="false" />
    <!-- No advertising use: no advertising ID, no ad personalization signals. Screens are logged by their key from the
         shell (Telemetry.screen), never by activity class. -->
    <meta-data
      android:name="google_analytics_adid_collection_enabled"
      android:value="false" />
    <meta-data
      android:name="google_analytics_default_allow_ad_personalization_signals"
      android:value="false" />
    <meta-data
      android:name="google_analytics_automatic_screen_reporting_enabled"
      android:value="false" />
  </application>
</manifest>
