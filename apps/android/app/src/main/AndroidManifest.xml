<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Scan stock reads barcodes with the camera; a device without one still works. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />

  <application
    android:name=".AglynApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Aglyn.Starting">
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|fontScale|locale|layoutDirection"
      android:exported="true"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="aglyn" />
      </intent-filter>
      <!-- The console's emailed sign-up, verification and password reset links open the app, which finishes them, and so does
           a workspace invitation's link (the console's home), whose invitation the app answers. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" />
        <data android:host="${consoleHost}" />
        <data android:path="/" />
        <data android:path="/signup" />
        <data android:path="/verify-email" />
        <data android:path="/reset-password" />
        <data android:path="/account-recovery" />
      </intent-filter>
    </activity>
    <!-- The home-screen icon (Theme ▸ App icon, LauncherIconSwitcher): one alias of the main activity per icon of the logo
         kit, exactly one enabled. The app's own icon is on until the person picks another. -->
    <activity-alias
      android:name=".LauncherAglyn"
      android:enabled="true"
      android:exported="true"
      android:icon="@mipmap/ic_launcher"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".LauncherLight"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/ic_launcher_light"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias
      android:name=".LauncherDark"
      android:enabled="false"
      android:exported="true"
      android:icon="@mipmap/ic_launcher_dark"
      android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <service
      android:name=".MessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- Media uploads from the camera: the camera app writes into the app's cache through this provider. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="aglyn" />
  </application>
</manifest>
