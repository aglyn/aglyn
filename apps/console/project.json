{
  "name": "console",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/console",
  "projectType": "application",
  "tags": ["scope:app", "scope:private", "scope:console"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "cache": false,
      "options": {
        "outputPath": "dist/apps/console"
      },
      "configurations": {
        "production": {
          "webpack": false
        },
        "development": {
          "outputPath": "apps/console"
        }
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "dependsOn": ["clean-next-cache"],
      "options": {
        "buildTarget": "console:build",
        "dev": true,
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "console:build:production",
          "dev": false
        },
        "development": {
          "buildTarget": "console:build:development",
          "dev": true
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "console:build:production"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/workflows/scheduled-crons.yml",
        "{workspaceRoot}/tools/scripts/cron-deploy-state.sh",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "@nx/react",
            "babel-jest"
          ]
        }
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "syncVersions": false
      }
    },
    "clean-next-cache": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/clean-next.mjs --prune --app=console"
      }
    }
  }
}
