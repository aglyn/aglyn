{
  "name": "console",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/console",
  "projectType": "application",
  "tags": ["scope:app", "scope:private", "scope:console"],
  "targets": {
    "serve": {
      "options": {
        "port": 4200
      }
    },
    "start": {
      "options": {
        "port": 4200
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/workflows/scheduled-crons.yml",
        "{workspaceRoot}/tools/scripts/cron-deploy-state.sh",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "@nx/react",
            "babel-jest"
          ]
        }
      ]
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "syncVersions": false
      }
    },
    "clean-next-cache": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/clean-next.mjs --prune --app=console"
      }
    }
  }
}
