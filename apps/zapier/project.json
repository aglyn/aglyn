{
  "name": "zapier",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/zapier",
  "//": "Aglyn on Zapier (AGL-3643): the Zapier platform app, plain CommonJS on Aglyn's REST API, published by the operator with the Zapier CLI (`npm install && zapier push` in this directory). Imports no project of the repo.",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["jest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/zapier"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "jest --config apps/zapier/jest.config.js --passWithNoTests"
      },
      "configurations": {
        "ci": {
          "args": "--ci --coverage --coverageDirectory=coverage/apps/zapier"
        }
      }
    }
  }
}
