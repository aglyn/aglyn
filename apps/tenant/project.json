{
  "name": "tenant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tenant",
  "projectType": "application",
  "tags": ["scope:app", "scope:public", "scope:tenant"],
  "targets": {
    "serve": {
      "options": {
        "port": 4500
      }
    },
    "start": {
      "options": {
        "port": 4500
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "@nx/react",
            "babel-jest"
          ]
        }
      ]
    },
    "clean-next-cache": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/scripts/clean-next.mjs --prune --app=tenant"
      }
    }
  }
}
