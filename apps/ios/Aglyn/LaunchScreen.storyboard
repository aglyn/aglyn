<?xml version="1.0" encoding="UTF-8"?>
<!-- The static launch screen (AGL-3934): the Facets launch art aspect-filled behind the logo-kit mark, centered, 96 pt on
     iPhone and 120 pt on iPad. It equals the launch intro's first frame (AglynLaunchIntro); the art is generated by
     tools/scripts/generate-native-brand-assets.mjs. iOS and iPadOS only. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23727" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lnc-hS-vc0">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="Lnc-hS-scn">
            <objects>
                <viewController id="Lnc-hS-vc0" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Lnc-hS-vw0">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-hS-art">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-hS-mrk">
                                <rect key="frame" x="148.66666666666666" y="378" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="Lnc-hS-c01">
                                        <variation key="heightClass=regular-widthClass=regular" constant="120"/>
                                    </constraint>
                                    <constraint firstAttribute="width" secondItem="Lnc-hS-mrk" secondAttribute="height" multiplier="1:1" id="Lnc-hS-c02"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <constraints>
                            <constraint firstItem="Lnc-hS-art" firstAttribute="top" secondItem="Lnc-hS-vw0" secondAttribute="top" id="Lnc-hS-c03"/>
                            <constraint firstItem="Lnc-hS-art" firstAttribute="bottom" secondItem="Lnc-hS-vw0" secondAttribute="bottom" id="Lnc-hS-c04"/>
                            <constraint firstItem="Lnc-hS-art" firstAttribute="leading" secondItem="Lnc-hS-vw0" secondAttribute="leading" id="Lnc-hS-c05"/>
                            <constraint firstItem="Lnc-hS-art" firstAttribute="trailing" secondItem="Lnc-hS-vw0" secondAttribute="trailing" id="Lnc-hS-c06"/>
                            <constraint firstItem="Lnc-hS-mrk" firstAttribute="centerX" secondItem="Lnc-hS-vw0" secondAttribute="centerX" id="Lnc-hS-c07"/>
                            <constraint firstItem="Lnc-hS-mrk" firstAttribute="centerY" secondItem="Lnc-hS-vw0" secondAttribute="centerY" id="Lnc-hS-c08"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lnc-hS-frs" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="440" height="956"/>
        <image name="LaunchLogo" width="120" height="120"/>
    </resources>
</document>
