// Overrides for a Release build. Release.xcconfig already carries the
// production project (aglyn-main) and https://app.aglyn.com, so Aglyn's own
// builds need no Production.xcconfig at all.
//
// A build for another project (a self-hosted install, a staging project)
// copies this file to Production.xcconfig (git ignores it) and sets only what
// differs. Every value is PUBLIC client config; none is a secret. Release.xcconfig
// includes it last, so a key set here wins.
//
// No emulator hosts: AglynConfig refuses an emulator on a non-local console.

// AGLYN_CONSOLE_URL = https:/$()/console.example.com
// AGLYN_FIREBASE_API_KEY = <the project's iOS API key>
// AGLYN_FIREBASE_AUTH_DOMAIN = <project>.firebaseapp.com
// AGLYN_FIREBASE_PROJECT_ID = <project id>
// AGLYN_FIREBASE_MESSAGING_SENDER_ID = <sender id>
// AGLYN_FIREBASE_STORAGE_BUCKET = <bucket>
// AGLYN_FIREBASE_APP_ID_Aglyn = <the Apple app id registered for com.aglyn.app>
// AGLYN_FIREBASE_APP_ID_AglynPOS = <the Apple app id registered for com.aglyn.pos>
// AGLYN_GOOGLE_IOS_CLIENT_ID_Aglyn = <the iOS OAuth client for com.aglyn.app>
// AGLYN_GOOGLE_IOS_CLIENT_ID_AglynPOS = <the iOS OAuth client for com.aglyn.pos>
// AGLYN_GOOGLE_WEB_CLIENT_ID = <the project's Web OAuth client>
// AGLYN_BRAND_NAME = Aglyn
// The domain passkeys are made for, once that domain serves an apple-app-site-association naming the app.
// AGLYN_PASSKEY_RP_ID = <your passkey domain>
// Firebase App Check: on for any project that enforces it (register the apps for App Attest and
// DeviceCheck in the Firebase console first); off only for a project that does not.
// AGLYN_APP_CHECK = on
// AGLYN_LEGAL_ORIGIN = https:/$()/<your legal site>
// AGLYN_DOCS_ORIGIN = https:/$()/<your documentation site>
// AGLYN_APPLE_SIGN_IN = YES
// Crash reports, non-fatal errors and Analytics to this project's Crashlytics and Analytics; off for a build that
// must not report (AGL-4067).
// AGLYN_TELEMETRY = on
