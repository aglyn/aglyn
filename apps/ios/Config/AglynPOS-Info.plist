<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AGLYN_VERSION</key>
	<string>$(AGLYN_VERSION)</string>
	<key>AGLYN_CONSOLE_URL</key>
	<string>$(AGLYN_CONSOLE_URL)</string>
	<key>AGLYN_FIREBASE_API_KEY</key>
	<string>$(AGLYN_FIREBASE_API_KEY)</string>
	<key>AGLYN_FIREBASE_AUTH_DOMAIN</key>
	<string>$(AGLYN_FIREBASE_AUTH_DOMAIN)</string>
	<key>AGLYN_FIREBASE_PROJECT_ID</key>
	<string>$(AGLYN_FIREBASE_PROJECT_ID)</string>
	<key>AGLYN_FIREBASE_APP_ID</key>
	<string>$(AGLYN_FIREBASE_APP_ID)</string>
	<key>AGLYN_FIREBASE_MESSAGING_SENDER_ID</key>
	<string>$(AGLYN_FIREBASE_MESSAGING_SENDER_ID)</string>
	<key>AGLYN_FIREBASE_STORAGE_BUCKET</key>
	<string>$(AGLYN_FIREBASE_STORAGE_BUCKET)</string>
	<key>AGLYN_AUTH_EMULATOR_HOST</key>
	<string>$(AGLYN_AUTH_EMULATOR_HOST)</string>
	<key>AGLYN_FIRESTORE_EMULATOR_HOST</key>
	<string>$(AGLYN_FIRESTORE_EMULATOR_HOST)</string>
	<key>AGLYN_GOOGLE_IOS_CLIENT_ID</key>
	<string>$(AGLYN_GOOGLE_IOS_CLIENT_ID)</string>
	<key>AGLYN_GOOGLE_WEB_CLIENT_ID</key>
	<string>$(AGLYN_GOOGLE_WEB_CLIENT_ID)</string>
	<key>AGLYN_BRAND_NAME</key>
	<string>$(AGLYN_BRAND_NAME)</string>
	<key>AGLYN_PASSKEY_RP_ID</key>
	<string>$(AGLYN_PASSKEY_RP_ID)</string>
	<key>AGLYN_APP_CHECK</key>
	<string>$(AGLYN_APP_CHECK)</string>
	<key>AGLYN_LEGAL_ORIGIN</key>
	<string>$(AGLYN_LEGAL_ORIGIN)</string>
	<key>AGLYN_DOCS_ORIGIN</key>
	<string>$(AGLYN_DOCS_ORIGIN)</string>
	<key>AGLYN_APPLE_SIGN_IN</key>
	<string>$(AGLYN_APPLE_SIGN_IN)</string>
	<key>AGLYN_TELEMETRY</key>
	<string>$(AGLYN_TELEMETRY)</string>
	<key>AGLYN_DEBUG_EMAIL</key>
	<string>$(AGLYN_DEBUG_EMAIL)</string>
	<key>AGLYN_DEBUG_PASSWORD</key>
	<string>$(AGLYN_DEBUG_PASSWORD)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Aglyn POS connects to your Bluetooth card reader to take card payments.</string>
	<!-- Stripe Terminal stops the app at Bluetooth reader discovery without this (and a reader stays connected
	     while the register is in the background). iOS only; macOS ignores the key. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Card payments need this device's location, as card networks require.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera reads product barcodes so you can find and sell items quickly.</string>
	<!-- Firebase Auth's app-delegate proxy (iOS) takes the APNs callbacks and calls the app's own only when the
	     delegate class implements them; SwiftUI's delegate forwards them to PushAppDelegate instead, so with the
	     proxy on the device token never reaches PushCenter. The apps sign in with credentials only (no phone auth,
	     no Firebase-hosted web flows), so nothing else relies on it. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- Crash reports and Analytics (AGL-4067): off until AglynFirebase.configure turns them on, which it does only in a
	     release build on production (AGLYN_TELEMETRY), so nothing is sent before the config decides. -->
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<!-- No advertising use: no ad personalization signals and no identifier for vendor. The app links the plain
	     FirebaseAnalytics product, so the advertising identifier is never read, and it asks for no tracking permission. -->
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
	<false/>
	<key>GOOGLE_ANALYTICS_IDFV_COLLECTION_ENABLED</key>
	<false/>
	<!-- Screens are logged by their key from the shell (Telemetry.screen), never by view-controller class. -->
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<!-- macOS: an uncaught Objective-C exception (a Firestore NSException) ends the app, so Crashlytics reports it, rather
	     than AppKit logging it and carrying on in a broken state. iOS ignores the key. -->
	<key>NSApplicationCrashOnExceptions</key>
	<true/>
	<!-- HTTPS (TLS) only, which is exempt: no export-compliance question per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aglyn-pos</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
</dict>
</plist>
