// The default build configuration: the local Firebase emulator stack on a
// demo- project, and a console running on this Mac. Nothing here reaches a
// live project. Production.xcconfig.example lists what a release build sets.
//
// Per-machine overrides (other emulator ports, a debug sign-in for
// screenshots) go in Config/Local.xcconfig, which git ignores.

AGLYN_CONSOLE_URL = http:/$()/localhost:4200
// Not a real key, and the emulators accept any. It has a real key's shape (39 characters, starting with "A"), because
// Firebase Installations, which Analytics starts at launch, refuses any other and the app would end there (AGL-4104).
AGLYN_FIREBASE_API_KEY = Aemulator-api-key-not-a-real-key-000000
AGLYN_FIREBASE_AUTH_DOMAIN = localhost
AGLYN_FIREBASE_PROJECT_ID = demo-aglyn
AGLYN_FIREBASE_APP_ID = 1:000000000000:ios:0000000000000000
AGLYN_FIREBASE_MESSAGING_SENDER_ID = 000000000000
AGLYN_FIREBASE_STORAGE_BUCKET =
AGLYN_AUTH_EMULATOR_HOST = 127.0.0.1:9099
AGLYN_FIRESTORE_EMULATOR_HOST = 127.0.0.1:8082
AGLYN_GOOGLE_IOS_CLIENT_ID =
AGLYN_GOOGLE_WEB_CLIENT_ID =
AGLYN_BRAND_NAME = Aglyn
// Firebase App Check: off, since the emulators do not enforce it (there is no App Check emulator).
AGLYN_APP_CHECK = off
AGLYN_PASSKEY_RP_ID =
AGLYN_LEGAL_ORIGIN = https:/$()/aglyn.com
AGLYN_DOCS_ORIGIN = https:/$()/docs.aglyn.com
AGLYN_APPLE_SIGN_IN = NO
// Crash reports and Analytics: off, so a debug build on the emulator stack never reports (AGL-4067).
AGLYN_TELEMETRY = off

// Debug builds have an identity of their own (AGL-3994): "Aglyn Debug" (com.aglyn.app.debug) and "Aglyn POS Debug"
// (com.aglyn.pos.debug). A debug build launched from DerivedData then never registers under the shipped bundle id, so it
// cannot take over the TestFlight or App Store app's Dock item, Launchpad entry, keychain items or settings, and both
// can run side by side. Release.xcconfig leaves the shipped identity (com.aglyn.app, com.aglyn.pos) alone. In Debug the
// associated domains, push and Sign in with Apple stay off: the apple-app-site-association names only the shipped ids,
// the emulator console sends no push, and AGLYN_APPLE_SIGN_IN is NO.
AGLYN_BUNDLE_ID_Aglyn = com.aglyn.app.debug
AGLYN_BUNDLE_ID_AglynPOS = com.aglyn.pos.debug
AGLYN_DISPLAY_NAME_Aglyn = Aglyn Debug
AGLYN_DISPLAY_NAME_AglynPOS = Aglyn POS Debug

// Debug builds only: with `-AglynAutoSignIn YES` on the launch arguments,
// an emulator build signs in as this seeded test member (tools/scripts/
// seed-native-emulator.mjs prints it). Set in Local.xcconfig; never a real account.
AGLYN_DEBUG_EMAIL =
AGLYN_DEBUG_PASSWORD =

#include? "Local.xcconfig"
