{
  "name": "pos-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pos-mobile/src",
  "projectType": "application",
  "tags": ["scope:app", "scope:mobile", "type:app"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/pos-mobile", "command": "npm ci" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/pos-mobile", "command": "npm run typecheck" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/pos-mobile", "command": "npm test" }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/pos-mobile", "command": "npx expo run:ios" }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/pos-mobile", "command": "npx expo run:android" }
    }
  }
}
