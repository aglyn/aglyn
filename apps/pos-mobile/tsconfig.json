{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": ["jest"],
    "paths": {
      "@aglyn/mobile-core": ["../../libs/mobile/core/src/index.ts"],
      "@aglyn/mobile-ui": ["../../libs/mobile/ui/src/index.ts"],
      "@aglyn/mobile-webview": ["../../libs/mobile/webview/src/index.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../libs/mobile/*/src/**/*.ts", "../../libs/mobile/*/src/**/*.tsx"],
  "exclude": ["node_modules", "ios", "android"]
}
