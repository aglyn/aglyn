# The docs registries may not be committed stale (AGL-2486).
#
# Fast pre-filter: skip node entirely for the overwhelming majority of
# commits, which touch neither apps/docs nor a generated registry. This
# pattern is deliberately BROADER than the guard's own trigger list —
# matching too much costs a few hundred milliseconds, matching too little
# would silently skip the guard. The authoritative list lives in the script.
# A help call's `anchor: '#…'` feeds the help registry too (AGL-3707).
if git diff --cached --name-only --diff-filter=ACMRD |
  grep -qE '^apps/docs/|^tools/scripts/generate-|\.generated\.ts$' ||
  git diff --cached -U0 -- 'apps/console/*.ts*' 'libs/*.ts*' |
  grep -qE "^[-+].*['\"\`]#[a-z0-9]"; then
  node tools/scripts/check-staged-docs-registries.mjs || exit 1
fi

# `tools/` sits outside every Nx project tsconfig, so `npm run typecheck` never
# reads it and a newly written script's first review is `check:lint-tools` in
# CI — historically the most frequent red in the Main Gate (AGL-2752). Linting
# it here costs seconds and moves that verdict before the push.
#
# Scoped to the STAGED paths, not to `tools/` as a whole: several sessions share
# this checkout, and a whole-directory lint would report a peer's in-flight edit
# as this commit's failure. The extension list mirrors the `files:` selectors in
# eslint.config.mjs — a path eslint has no config for exits non-zero on sight,
# which is why the pattern is a filter rather than the guard's own trigger list.
staged_tools=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '^tools/.*\.(m?js|cjs|jsx|ts|tsx)$' || true)
if [ -n "$staged_tools" ]; then
  # shellcheck disable=SC2086 -- deliberate word splitting; paths are newline
  # separated and this repository has no whitespace in tracked filenames.
  npx --no-install eslint --no-error-on-unmatched-pattern $staged_tools || exit 1
fi

# The Firestore rules deploy from a comment-stripped artifact (AGL-3544), so a
# commit that changes the source must carry the regenerated artifact with it.
# Checked against the INDEX, not the working tree: what is being committed is
# the staged pair, and a peer's unstaged rules edit is not this commit's.
if git diff --cached --name-only --diff-filter=ACMRD |
  grep -qE '^cloud/firebase-firestore(\.deploy)?\.rules$'; then
  node tools/scripts/generate-rules-deploy-artifact.mjs --check --staged || exit 1
fi

# A JSON key written twice survives a git merge with no conflict, and
# `JSON.parse` keeps only the last copy (AGL-3553). Checked against the INDEX
# copy of each staged JSON file, so what is judged is what is committed.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.jsonc?$'; then
  node tools/scripts/check-json-duplicate-keys.mjs --staged || exit 1
fi
